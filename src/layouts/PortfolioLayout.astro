---
/**
 * Template for each portfolio category (/portfolio/*): gallery, benefits and links
 * to the related service and the other categories.
 */
import Layout from './Layout.astro';
import PageHero from '../components/ui/PageHero.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import MediaMarquee from '../components/ui/MediaMarquee.astro';
import TextMarquee from '../components/ui/TextMarquee.astro';
import CtaBanner from '../components/ui/CtaBanner.astro';
import { portfolioNav } from '../data/navigation';

interface Benefit {
  title: string;
  text: string;
}

interface Props {
  title: string;
  metaTitle: string;
  description: string;
  eyebrow?: string;
  subtitle: string;
  intro: string;
  items: string[];
  aspect?: 'square' | 'wide' | 'video' | 'vertical';
  benefits: Benefit[];
  /** Related service page, so visitors can go from the work to the offer */
  service: { label: string; href: string };
}

const {
  title,
  metaTitle,
  description,
  eyebrow = 'Portfolio',
  subtitle,
  intro,
  items,
  aspect = 'square',
  benefits,
  service,
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '');
const related = portfolioNav.filter((l) => l.href !== path);

const breadcrumbs = [
  { name: 'Portfolio', path: '/portfolio' },
  { name: title, path },
];
---

<Layout title={metaTitle} description={description} breadcrumbs={breadcrumbs} pageType="CollectionPage">
  <PageHero
    eyebrow={eyebrow}
    title={title}
    highlight={title.split(' ').pop()}
    subtitle={subtitle}
    ctaLabel="Book a Call"
    ctaHref="/book-a-call"
    secondaryLabel={`See the ${service.label}`}
    secondaryHref={service.href}
  />

  <section class="container-x py-16 md:py-20">
    <h2 class="sr-only">{title} examples</h2>
    <p class="scrub-text mx-auto max-w-3xl text-center text-lg leading-relaxed text-brand-ink/80">{intro}</p>
  </section>

  <div class="space-y-6 pb-16 md:pb-20">
    <MediaMarquee items={items} aspect={aspect} duration={70} />
    <MediaMarquee items={[...items].reverse()} aspect={aspect} reverse duration={85} />
  </div>

  <TextMarquee words={[title, 'Share It Studio', title, 'Made to sell']} />

  <section class="bg-brand-cream py-16 md:py-20">
    <div class="container-x">
      <SectionHeading eyebrow="Why it works" title="Designed to sell, not just to look good" />
      <ol class="grid gap-6 md:grid-cols-3">
        {benefits.map((b, i) => (
          <li class="rounded-2xl bg-white p-7 shadow-sm">
            <span
              class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-yellow font-bold text-brand-green"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <h3 class="mt-5 text-xl font-bold text-brand-green">{b.title}</h3>
            <p class="mt-2 text-brand-ink/70">{b.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <nav class="container-x pt-16 text-center" aria-labelledby="more-work">
    <h2 id="more-work" class="mb-6 text-xl font-bold text-brand-green">
      Explore more of our work
    </h2>
    <ul class="flex flex-wrap justify-center gap-3">
      {related.map((l) => (
        <li>
          <a
            href={l.href}
            class="inline-block rounded-full border border-brand-green/20 px-4 py-2 text-sm font-medium text-brand-green transition hover:border-brand-yellow hover:bg-brand-yellow"
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>
    <a href={service.href} class="btn-outline mt-10">
      Explore the {service.label} →
    </a>
  </nav>

  <CtaBanner />
</Layout>
