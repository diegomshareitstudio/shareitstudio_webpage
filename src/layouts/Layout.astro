---
/**
 * Base layout for every page: <head> SEO tags, one JSON-LD @graph, header, <main> and footer.
 */
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { SITE } from '../config/site';
import {
  absoluteUrl,
  breadcrumbSchema,
  organizationSchema,
  webPageSchema,
  websiteSchema,
  type Crumb,
  type PageType,
  type Schema,
} from '../lib/schema';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Trail after Home, e.g. [{ name: 'Services', path: '/services' }]. Omit on the homepage. */
  breadcrumbs?: Crumb[];
  /** schema.org type of the WebPage node */
  pageType?: PageType;
  /** Page-specific JSON-LD nodes (Service, Article, FAQPage…) */
  schema?: Schema[];
  /** Social preview image (path or URL of a built asset) */
  image?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  breadcrumbs,
  pageType,
  schema = [],
  image,
  ogType = 'website',
  noindex = false,
} = Astro.props;

const path = Astro.url.pathname;
const canonical = absoluteUrl(path);
const ogImage = image && absoluteUrl(image);
const robots = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    organizationSchema(),
    websiteSchema(),
    webPageSchema({ path, title, description, type: pageType, image, hasBreadcrumb: Boolean(breadcrumbs) }),
    ...(breadcrumbs ? [breadcrumbSchema(path, breadcrumbs)] : []),
    ...schema,
  ],
};
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=DM+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph / social -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-brand-yellow focus:px-5 focus:py-3 focus:font-semibold focus:text-brand-green"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/animations';
    </script>
  </body>
</html>
