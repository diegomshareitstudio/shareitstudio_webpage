---
import { mainNav } from '../data/navigation';

const columns = mainNav.filter((item) => item.children);
const year = new Date().getFullYear();
---

<footer class="mt-auto bg-brand-green-dark text-white/80">
  <div class="container-x grid gap-10 py-14 md:grid-cols-[1.5fr_repeat(4,1fr)]">
    <div>
      <a href="/" class="text-3xl font-bold text-white">Share<span class="text-brand-yellow">it</span></a>
      <p class="mt-4 max-w-xs text-sm leading-relaxed">
        Amazon marketing experts specializing in data-driven visual content for sellers who want to convert more.
      </p>
      <a href="/call" class="btn-primary mt-6 text-sm">Schedule a Call</a>
    </div>
    {columns.map((col) => (
      <nav aria-label={`${col.label} links`}>
        <h3 class="mb-4 text-sm font-bold uppercase tracking-wider text-brand-yellow">{col.label}</h3>
        <ul class="space-y-2 text-sm">
          {col.children!.slice(0, 6).map((link) => (
            <li><a href={link.href} class="hover:text-brand-yellow">{link.label}</a></li>
          ))}
        </ul>
      </nav>
    ))}
  </div>
  <div class="border-t border-white/10">
    <div class="container-x flex flex-col items-center justify-between gap-2 py-5 text-xs sm:flex-row">
      <p>© {year} Share It Studio. All rights reserved.</p>
      <p>Prototype — content and images are placeholders.</p>
    </div>
  </div>
</footer>
