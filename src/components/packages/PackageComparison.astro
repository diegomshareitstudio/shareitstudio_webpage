---
/** What changes between plans. On narrow screens the table scrolls sideways with the feature column pinned, so text keeps its size. */
import { socialPackages, packageComparison } from '../../data/socialPackages';

const featuredIndex = socialPackages.findIndex((p) => p.featured);
---

<div class="overflow-x-auto rounded-[2rem] bg-white shadow-sm ring-1 ring-black/5" tabindex="0" aria-label="Plan comparison table, scrollable">
  <table class="w-full min-w-[640px] border-collapse text-left text-sm">
    <caption class="sr-only">What changes between the Light, Grow, Scale and Dominate plans</caption>
    <thead>
      <tr>
        <th scope="col" class="sticky left-0 z-10 bg-white px-6 py-5 text-xs font-semibold uppercase tracking-wider text-brand-ink/50">
          Feature
        </th>
        {socialPackages.map((p, i) => (
          <th
            scope="col"
            class:list={[
              'px-6 py-5 font-display text-base font-extrabold',
              i === featuredIndex ? 'bg-brand-green text-brand-yellow' : 'text-brand-green',
            ]}
          >
            {p.name}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {packageComparison.map((row) => (
        <tr class="border-t border-black/5">
          <th scope="row" class="sticky left-0 z-10 bg-white px-6 py-4 font-medium text-brand-ink/65">
            {row.feature}
          </th>
          {row.values.map((v, i) => (
            <td class:list={['px-6 py-4', i === featuredIndex && 'bg-brand-yellow-soft/60 font-semibold']}>
              {v === false ? (
                <span class="text-brand-ink/30" aria-label="Not included">
                  —
                </span>
              ) : (
                <span class="text-brand-green">{v}</span>
              )}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
