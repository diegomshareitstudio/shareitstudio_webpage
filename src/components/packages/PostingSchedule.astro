---
/**
 * Illustrative sample week per plan, one plan at a time. All four weeks are in the HTML (crawlable, and readable
 * without JS); the script turns them into keyboard-accessible tabs. Never auto-rotates.
 */
import { socialPackages, type PostType } from '../../data/socialPackages';

interface Props {
  /** Plan shown first */
  initial?: string;
}
const { initial = 'grow' } = Astro.props;

const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
const dayNames = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
const chip: Record<PostType, string> = {
  Reel: 'bg-brand-yellow text-brand-green',
  Story: 'bg-brand-green text-white',
  Carousel: 'bg-brand-orange text-white',
};
---

<div class="sched" data-sched data-initial={initial}>
  <div class="mb-5 flex flex-wrap gap-2" role="tablist" aria-label="Choose a plan" data-sched-tabs hidden>
    {socialPackages.map((p) => (
      <button
        type="button"
        role="tab"
        id={`sched-tab-${p.id}`}
        aria-controls={`sched-${p.id}`}
        aria-selected="false"
        tabindex="-1"
        data-sched-tab={p.id}
        class="rounded-full px-5 py-2.5 text-sm font-semibold text-brand-green ring-1 ring-brand-green/20 transition hover:ring-brand-green aria-selected:bg-brand-green aria-selected:text-brand-yellow aria-selected:ring-brand-green"
      >
        {p.name}
      </button>
    ))}
  </div>

  <div class="space-y-4">
    {socialPackages.map((p) => (
      <div id={`sched-${p.id}`} class="rounded-[1.75rem] bg-white p-5 shadow-sm ring-1 ring-black/5 md:p-6" data-sched-panel={p.id}>
        <h4 class="font-display text-base font-extrabold text-brand-green">{p.name} — sample week</h4>
        <ol class="mt-4 grid gap-2 md:grid-cols-7">
          {p.schedule.map((posts, d) => (
            <li class="flex items-center gap-3 rounded-2xl bg-brand-cream px-4 py-3 md:flex-col md:items-stretch md:gap-2 md:px-2 md:py-4">
              <span class="w-10 shrink-0 text-xs font-semibold uppercase tracking-wider text-brand-ink/50 md:w-auto md:text-center">
                <abbr title={dayNames[d]} class="no-underline">{days[d]}</abbr>
              </span>
              {posts.length === 0 ? (
                <span class="text-sm text-brand-ink/30 md:text-center">—<span class="sr-only">No post</span></span>
              ) : (
                <span class="flex flex-wrap gap-1.5 md:flex-col md:items-center">
                  {posts.map((t) => (
                    <span class:list={['rounded-full px-2.5 py-1 text-xs font-semibold', chip[t]]}>{t}</span>
                  ))}
                </span>
              )}
            </li>
          ))}
        </ol>
      </div>
    ))}
  </div>

  <div class="mt-4 flex flex-wrap gap-4 text-xs text-brand-ink/60" aria-hidden="true">
    {(Object.keys(chip) as PostType[]).map((t) => (
      <span class="flex items-center gap-2">
        <span class:list={['h-3 w-3 rounded-full', chip[t].split(' ')[0]]}></span>
        {t}
      </span>
    ))}
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-sched]')) {
    const tablist = root.querySelector<HTMLElement>('[data-sched-tabs]')!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-sched-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-sched-panel]')];

    const select = (id: string, focus = false) => {
      for (const tab of tabs) {
        const on = tab.dataset.schedTab === id;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        if (on && focus) tab.focus();
      }
      for (const panel of panels) panel.hidden = panel.dataset.schedPanel !== id;
    };

    for (const panel of panels) {
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', `sched-tab-${panel.dataset.schedPanel}`);
      panel.tabIndex = 0;
    }
    tablist.hidden = false;
    select(root.dataset.initial ?? tabs[0].dataset.schedTab!);

    tablist.addEventListener('click', (e) => {
      const tab = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-sched-tab]');
      if (tab) select(tab.dataset.schedTab!);
    });
    tablist.addEventListener('keydown', (e) => {
      const i = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
      const next = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
      if (next === undefined) return;
      e.preventDefault();
      select(tabs[(next + tabs.length) % tabs.length].dataset.schedTab!, true);
    });
  }
</script>
