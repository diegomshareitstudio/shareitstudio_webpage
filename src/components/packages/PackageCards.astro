---
/** The four monthly plans as equal-height cards. No per-card buttons: the page places one shared CTA after them. */
import { socialPackages, formatPrice } from '../../data/socialPackages';
---

<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  {socialPackages.map((p) => (
    <article
      id={`plan-${p.id}`}
      class:list={[
        'relative flex flex-col overflow-hidden rounded-[2rem]',
        p.featured ? 'bg-brand-green text-white shadow-2xl ring-4 ring-brand-yellow' : 'bg-white text-brand-green shadow-sm ring-1 ring-black/5',
      ]}
      aria-labelledby={`plan-${p.id}-name`}
    >
      <header class:list={['p-7 pb-6', p.featured ? 'border-b border-white/10' : 'border-b border-black/5']}>
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[0.7rem] font-semibold uppercase tracking-wider">
          <span
            class:list={[
              'inline-block rounded-full px-3 py-1',
              p.featured
                ? 'bg-brand-yellow text-brand-green'
                : p.id === 'dominate'
                  ? 'bg-brand-green text-brand-yellow'
                  : 'bg-brand-yellow-soft text-brand-green',
            ]}
          >
            {p.tier}
          </span>
          <span class:list={[p.featured ? 'text-white/60' : 'text-brand-ink/55']}>{p.posts}</span>
        </p>
        <h3 id={`plan-${p.id}-name`} class:list={['mt-4 text-3xl font-extrabold', p.featured && 'text-brand-yellow']}>{p.name}</h3>
        <p class="mt-2 flex items-baseline gap-1">
          <span class="font-display text-5xl font-extrabold tracking-tight">{formatPrice(p.price)}</span>
          <span class:list={['whitespace-nowrap text-sm', p.featured ? 'text-white/60' : 'text-brand-ink/55']}>/ mo</span>
        </p>
        <p class="mt-4 font-display text-lg font-extrabold leading-snug">{p.tagline}</p>
        <p class:list={['mt-2 text-sm', p.featured ? 'text-white/75' : 'text-brand-ink/70']}>
          <strong class:list={[p.featured ? 'text-white' : 'text-brand-green']}>{p.forLabel ?? 'For'}:</strong>{' '}
          {p.forWho}
        </p>
      </header>

      <div class="flex flex-1 flex-col p-7">
        <p class:list={['text-xs font-semibold uppercase tracking-wider', p.featured ? 'text-brand-yellow' : 'text-brand-ink/50']}>Included</p>
        <ul class="mt-3 flex-1 space-y-2.5 text-sm">
          {p.features.map((f) => (
            <li class="flex items-start gap-3">
              <span
                class:list={[
                  'mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full text-[0.65rem] font-bold',
                  p.featured ? 'bg-brand-yellow text-brand-green' : 'bg-brand-yellow-soft text-brand-green',
                ]}
                aria-hidden="true"
              >
                ✓
              </span>
              <span class:list={[p.featured ? 'text-white/85' : 'text-brand-ink/80']}>{f}</span>
            </li>
          ))}
        </ul>
        {p.note && <p class:list={['mt-4 text-xs italic', p.featured ? 'text-white/55' : 'text-brand-ink/50']}>{p.note}</p>}
      </div>
    </article>
  ))}
</div>
