---
import Layout from '../layouts/Layout.astro';
import PageHero from './ui/PageHero.astro';
import SectionHeading from './ui/SectionHeading.astro';
import CtaBanner from './ui/CtaBanner.astro';
import { mainNav } from '../data/navigation';

interface Benefit {
  title: string;
  text: string;
}

interface Props {
  title: string;
  metaTitle: string;
  description: string;
  eyebrow?: string;
  subtitle: string;
  intro: string;
  items: string[];
  aspect?: 'square' | 'wide' | 'video' | 'vertical';
  benefits: Benefit[];
}

const { title, metaTitle, description, eyebrow = 'Portfolio', subtitle, intro, items, aspect = 'square', benefits } = Astro.props;

const aspectClass = {
  square: 'aspect-square',
  wide: 'aspect-[970/600]',
  video: 'aspect-video',
  vertical: 'aspect-[9/16]',
}[aspect];

const gridClass = aspect === 'vertical' ? 'grid-cols-2 md:grid-cols-4' : aspect === 'wide' || aspect === 'video' ? 'md:grid-cols-2' : 'grid-cols-2 md:grid-cols-3';

const path = Astro.url.pathname.replace(/\/$/, '');
const related = (mainNav.find((n) => n.label === 'Portfolio')?.children ?? []).filter((l) => l.href !== path).slice(0, 6);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://shareitstudio.com/' },
    { '@type': 'ListItem', position: 2, name: 'Portfolio', item: 'https://shareitstudio.com/portfolio' },
    { '@type': 'ListItem', position: 3, name: title, item: `https://shareitstudio.com${path}` },
  ],
};
---

<Layout title={metaTitle} description={description} schema={breadcrumbSchema}>
  <PageHero eyebrow={eyebrow} title={title} subtitle={subtitle} ctaLabel="Get a Quote" ctaHref="/contact" />

  <section class="container-x py-16 md:py-20">
    <p class="mx-auto max-w-3xl text-center text-lg leading-relaxed text-brand-ink/80">{intro}</p>

    <div class:list={['mt-12 grid gap-5', gridClass]}>
      {items.map((item) => (
        <figure class="group">
          <div class:list={['placeholder transition group-hover:border-brand-yellow group-hover:bg-brand-yellow-soft', aspectClass]}>
            <span class="px-4">{aspect === 'video' || aspect === 'vertical' ? '▶ ' : ''}Image placeholder</span>
          </div>
          <figcaption class="mt-3 text-sm font-medium text-brand-green">{item}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="bg-brand-cream py-16 md:py-20">
    <div class="container-x">
      <SectionHeading eyebrow="Why it works" title="Designed to sell, not just to look good" />
      <div class="grid gap-6 md:grid-cols-3">
        {benefits.map((b, i) => (
          <div class="rounded-2xl bg-white p-7 shadow-sm">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-yellow font-bold text-brand-green">{i + 1}</span>
            <h3 class="mt-5 text-xl font-bold text-brand-green">{b.title}</h3>
            <p class="mt-2 text-brand-ink/70">{b.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="container-x pt-16">
    <h2 class="mb-6 text-center text-xl font-bold text-brand-green">Explore more of our work</h2>
    <div class="flex flex-wrap justify-center gap-3">
      {related.map((l) => (
        <a href={l.href} class="rounded-full border border-brand-green/20 px-4 py-2 text-sm font-medium text-brand-green transition hover:border-brand-yellow hover:bg-brand-yellow">
          {l.label}
        </a>
      ))}
    </div>
  </section>

  <CtaBanner />
</Layout>
