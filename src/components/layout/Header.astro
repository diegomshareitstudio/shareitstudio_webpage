---
import { mainNav, type NavLink } from '../../data/navigation';
import Logo from '../ui/Logo.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (item: NavLink) =>
  [item.href, ...(item.children ?? []).map((c) => c.href)].some((href) => {
    const base = href.split('#')[0];
    return base !== '/' && (path === base || path.startsWith(`${base}/`));
  });
---

<header class="sticky top-0 z-50 bg-brand-cream/90 py-3 backdrop-blur">
  <div class="container-x flex items-center justify-between gap-6">
    <Logo />

    <nav class="hidden rounded-full bg-white p-1.5 shadow-sm ring-1 ring-black/5 lg:block" aria-label="Main navigation">
      <ul class="flex items-center gap-1">
        {mainNav.map((item) => (
          <li class="group relative">
            <a
              href={item.href}
              class:list={[
                'flex items-center gap-1 rounded-full px-4 py-2 text-sm font-medium transition',
                isActive(item)
                  ? 'bg-brand-yellow text-brand-green'
                  : 'text-brand-ink/80 hover:bg-brand-cream hover:text-brand-green',
              ]}
            >
              {item.label}
              {item.children && (
                <svg
                  class="h-3 w-3 transition group-hover:rotate-180"
                  viewBox="0 0 12 12"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                >
                  <path d="M3 4.5 6 7.5l3-3" />
                </svg>
              )}
            </a>
            {item.children && (
              <div class="invisible absolute left-1/2 top-full -translate-x-1/2 pt-3 opacity-0 transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                <ul
                  class:list={[
                    'rounded-3xl bg-brand-green p-3 shadow-2xl',
                    item.children.length > 6 ? 'grid w-[28rem] grid-cols-2 gap-1' : 'w-60',
                  ]}
                >
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="block rounded-2xl px-4 py-2.5 text-sm text-white/85 transition hover:bg-white/10 hover:text-brand-yellow"
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/book-a-call" class="btn-dark hidden sm:inline-flex">
        Book a Call
      </a>
      <button
        id="menu-toggle"
        class="grid h-11 w-11 place-items-center rounded-full bg-white text-brand-green ring-1 ring-black/5 lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 8h16M4 16h10" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="container-x hidden lg:hidden" aria-label="Mobile navigation">
    <ul data-lenis-prevent class="mt-3 max-h-[75vh] space-y-1 overflow-y-auto rounded-3xl bg-brand-green p-4 text-white">
      {mainNav.map((item) => (
        <li>
          {item.children ? (
            <details>
              <summary class="cursor-pointer list-none rounded-2xl px-4 py-2.5 font-medium">{item.label} +</summary>
              <ul class="ml-4 border-l border-brand-yellow/50 pl-3">
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} class="block px-3 py-1.5 text-sm text-white/75 hover:text-brand-yellow">
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ) : (
            <a href={item.href} class="block rounded-2xl px-4 py-2.5 font-medium">
              {item.label}
            </a>
          )}
        </li>
      ))}
      <li class="pt-2">
        <a href="/book-a-call" class="btn-primary w-full">
          Book a Call
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
