---
import { mainNav } from '../data/navigation';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="sticky top-0 z-50 border-b border-black/5 bg-white/95 backdrop-blur">
  <div class="container-x flex h-20 items-center justify-between gap-6">
    <a href="/" class="flex items-baseline text-3xl font-bold tracking-tight text-brand-green" aria-label="Share It Studio home">
      Share<span class="text-brand-yellow">it</span>
      <span class="ml-1 text-[0.55rem] font-bold uppercase tracking-widest text-brand-green/70">Studio</span>
    </a>

    <nav class="hidden lg:block" aria-label="Main navigation">
      <ul class="flex items-center gap-7">
        {mainNav.map((item) => (
          <li class="group relative">
            <a
              href={item.href}
              class:list={[
                'flex items-center gap-1 border-b-2 py-7 text-sm font-medium uppercase tracking-wide transition',
                isActive(item.href) ? 'border-brand-green text-brand-green' : 'border-transparent text-brand-ink hover:text-brand-green',
              ]}
            >
              {item.label}
              {item.children && <span class="text-xs">▾</span>}
            </a>
            {item.children && (
              <ul class="invisible absolute left-0 top-full min-w-56 translate-y-2 rounded-xl border border-black/5 bg-white p-2 opacity-0 shadow-xl transition group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} class="block rounded-lg px-3 py-2 text-sm text-brand-ink hover:bg-brand-cream hover:text-brand-green">
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a href="/contact" class="btn-orange hidden sm:inline-flex">Contact Us</a>
      <button id="menu-toggle" class="rounded-lg p-2 text-brand-green lg:hidden" aria-label="Open menu" aria-expanded="false">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden max-h-[80vh] overflow-y-auto border-t border-black/5 bg-white lg:hidden" aria-label="Mobile navigation">
    <ul class="container-x space-y-1 py-4">
      {mainNav.map((item) => (
        <li>
          {item.children ? (
            <details>
              <summary class="cursor-pointer list-none rounded-lg px-3 py-2 font-medium uppercase text-brand-ink">{item.label} ▾</summary>
              <ul class="ml-3 border-l border-brand-yellow pl-3">
                {item.children.map((child) => (
                  <li><a href={child.href} class="block px-3 py-1.5 text-sm text-brand-ink/80">{child.label}</a></li>
                ))}
              </ul>
            </details>
          ) : (
            <a href={item.href} class="block rounded-lg px-3 py-2 font-medium uppercase text-brand-ink">{item.label}</a>
          )}
        </li>
      ))}
      <li class="pt-2"><a href="/contact" class="btn-orange w-full">Contact Us</a></li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
