---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  size?: 'lg' | 'md';
}

const { eyebrow, title, subtitle, ctaLabel, ctaHref, secondaryLabel, secondaryHref, size = 'md' } = Astro.props;
---

<section class="relative overflow-hidden bg-brand-green text-white">
  <div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-brand-yellow/10 blur-2xl"></div>
  <div class="pointer-events-none absolute -bottom-32 -left-16 h-80 w-80 rounded-full bg-brand-green-light/60 blur-3xl"></div>
  <div class:list={['container-x relative text-center', size === 'lg' ? 'py-24 md:py-32' : 'py-16 md:py-20']}>
    {eyebrow && <p class="mb-4 text-sm font-bold uppercase tracking-[0.2em] text-white/70">{eyebrow}</p>}
    <h1
      class:list={[
        'mx-auto max-w-4xl font-bold leading-[1.05] tracking-tight text-brand-yellow',
        size === 'lg' ? 'text-4xl sm:text-5xl md:text-7xl' : 'text-4xl sm:text-5xl md:text-6xl',
      ]}
    >
      {title}
    </h1>
    {subtitle && <p class="mx-auto mt-6 max-w-2xl text-lg text-white/85 md:text-xl" set:html={subtitle} />}
    {(ctaLabel || secondaryLabel) && (
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        {ctaLabel && <a href={ctaHref} class="btn-primary text-lg">{ctaLabel}</a>}
        {secondaryLabel && <a href={secondaryHref} class="btn-outline">{secondaryLabel}</a>}
      </div>
    )}
    <slot />
  </div>
</section>
