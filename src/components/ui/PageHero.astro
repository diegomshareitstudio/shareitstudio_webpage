---
/** Page header with the page's only <h1>, optional CTAs and an optional `visual` slot. */
interface Props {
  eyebrow?: string;
  title: string;
  /** Part of the title to mark with the yellow highlighter */
  highlight?: string;
  subtitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  size?: 'lg' | 'md';
}

const {
  eyebrow,
  title,
  highlight,
  subtitle,
  ctaLabel,
  ctaHref,
  secondaryLabel,
  secondaryHref,
  size = 'md',
} = Astro.props;

const [before, after] = highlight && title.includes(highlight) ? title.split(highlight) : [title, undefined];
const hasVisual = Astro.slots.has('visual');
---

<header class="relative overflow-hidden bg-brand-cream">
  <div
    class:list={[
      'container-x relative grid items-center gap-8 md:gap-12',
      hasVisual ? 'lg:grid-cols-[1.1fr_1fr]' : 'md:grid-cols-[1.6fr_1fr]',
      size === 'lg' ? 'pb-14 pt-8 md:pb-28 md:pt-16' : 'pb-12 pt-8 md:pb-20 md:pt-14',
    ]}
  >
    <div>
      {eyebrow && <p class="eyebrow mb-4 sm:mb-5">{eyebrow}</p>}
      <h1
        class:list={[
          'font-extrabold leading-[1.05] text-brand-green',
          size === 'lg' ? 'text-[2.5rem] sm:text-6xl lg:text-7xl' : 'text-[2.15rem] sm:text-5xl lg:text-6xl',
        ]}
      >
        {before}
        {after !== undefined && (
          <>
            <span class="marker">{highlight}</span>
            {after}
          </>
        )}
      </h1>
      {subtitle && (
        <p class="mt-5 max-w-xl text-base leading-relaxed text-brand-ink/70 sm:mt-6 sm:text-lg" set:html={subtitle} />
      )}
      {(ctaLabel || secondaryLabel) && (
        <div class="mt-7 flex flex-wrap items-center gap-3 sm:mt-9">
          {ctaLabel && (
            <a href={ctaHref} class="btn-primary">
              {ctaLabel}
            </a>
          )}
          {secondaryLabel && (
            <a href={secondaryHref} class="btn-outline">
              {secondaryLabel}
            </a>
          )}
        </div>
      )}
      <slot />
    </div>

    {hasVisual ? (
      <div>
        <slot name="visual" />
      </div>
    ) : (
      <div class="relative hidden h-56 md:block" aria-hidden="true">
        <div class="motion-float absolute right-10 top-0 h-40 w-40 rotate-12 rounded-[2.5rem] bg-brand-green"></div>
        <div class="motion-float absolute right-40 top-20 h-28 w-28 -rotate-6 rounded-full bg-brand-yellow"></div>
        <div class="motion-float absolute bottom-0 right-0 h-20 w-20 rotate-45 rounded-3xl bg-brand-orange"></div>
        <div class="motion-float absolute right-24 top-28 h-10 w-10 rounded-full border-4 border-brand-green"></div>
        <span class="star-spin absolute right-64 top-2 text-5xl text-brand-orange">✦</span>
      </div>
    )}
  </div>
</header>
