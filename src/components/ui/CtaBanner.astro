---
import Badge from './Badge.astro';
import { BOOKING_PAGE } from '../../config/site';

interface Props {
  title?: string;
  text?: string;
  ctaLabel?: string;
  ctaHref?: string;
  /** Small alternative-contact link under the button */
  altLabel?: string;
  altHref?: string;
  /** Short reassurance line (e.g. privacy) */
  note?: string;
  /** The spinning "Book a call" badge in the corner */
  badge?: boolean;
  /** A larger, glowing button centred in its column, for a page's closing call to action */
  prominent?: boolean;
}

const {
  title = 'Ready to turn more visitors into buyers?',
  text = 'Book a call to talk through your brand and the content you need.',
  ctaLabel = 'Book a Call',
  ctaHref = BOOKING_PAGE,
  altLabel,
  altHref,
  note,
  badge = true,
  prominent = false,
} = Astro.props;
---

<section class="container-x py-12 md:py-16">
  <div class="relative grid items-center gap-6 overflow-hidden rounded-[1.75rem] bg-brand-green p-6 sm:gap-8 sm:rounded-[2rem] sm:p-8 md:grid-cols-[1.5fr_1fr] md:p-14">
    {/* the yellow ring would sit behind a prominent button and compete with it */}
    {!prominent && (
      <div class="motion-float pointer-events-none absolute -bottom-20 -right-16 h-64 w-64 rounded-full border-[28px] border-brand-yellow/90"></div>
    )}
    <div class="motion-float pointer-events-none absolute right-40 top-8 h-6 w-6 rounded-full bg-brand-orange"></div>
    <span class="star-spin pointer-events-none absolute left-[45%] top-6 text-4xl text-brand-yellow" aria-hidden="true">
      ✦
    </span>
    <span
      class="star-spin pointer-events-none absolute bottom-6 right-1/3 text-2xl text-brand-orange"
      aria-hidden="true"
    >
      ✦
    </span>
    {badge && (
      <Badge
        id="cta-badge"
        class="absolute right-6 top-6 hidden text-brand-yellow md:grid"
        text="Book a call • Book a call • "
      />
    )}
    <div class="relative">
      <h2 class="text-[1.7rem] font-extrabold leading-tight text-white sm:text-3xl md:text-4xl">{title}</h2>
      <p class="mt-4 max-w-lg text-white/70">{text}</p>
    </div>
    <div class:list={['relative', prominent ? 'md:justify-self-center md:text-center' : 'md:justify-self-start']}>
      <a href={ctaHref} class:list={['btn-primary', prominent && 'cta-prominent']}>
        {ctaLabel}
      </a>
      {altLabel && (
        <a href={altHref} class="mt-4 block text-sm font-semibold text-white underline-offset-4 hover:underline">
          {altLabel}
        </a>
      )}
      {note && <p class:list={['max-w-xs text-xs text-white/60', prominent ? 'mt-4 md:mx-auto' : 'mt-3']}>{note}</p>}
    </div>
  </div>
</section>

<style>
  /* Closing call to action: bigger, with a soft glow that pulses outward */
  .cta-prominent {
    padding: 1.1rem 2rem 1.1rem 2.4rem;
    font-size: 1.2rem;
    box-shadow: 0 14px 36px -10px rgb(255 200 61 / 0.55);
  }
  @media all {
    .cta-prominent {
      animation: cta-pulse 2.6s ease-out infinite;
    }
    .cta-prominent:hover {
      animation-play-state: paused;
    }
  }
  @keyframes cta-pulse {
    0% {
      box-shadow:
        0 14px 36px -10px rgb(255 200 61 / 0.55),
        0 0 0 0 rgb(255 200 61 / 0.5);
    }
    70%,
    100% {
      box-shadow:
        0 14px 36px -10px rgb(255 200 61 / 0.55),
        0 0 0 16px rgb(255 200 61 / 0);
    }
  }
</style>
