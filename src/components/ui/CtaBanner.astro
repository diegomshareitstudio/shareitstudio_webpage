---
import Badge from './Badge.astro';

interface Props {
  title?: string;
  text?: string;
  ctaLabel?: string;
  ctaHref?: string;
  /** Small alternative-contact link under the button */
  altLabel?: string;
  altHref?: string;
  /** Short reassurance line (e.g. privacy) */
  note?: string;
}

const {
  title = 'Ready to turn more visitors into buyers?',
  text = 'Book a call to talk through your brand and the content you need.',
  ctaLabel = 'Book a Call',
  ctaHref = '/book-a-call',
  altLabel,
  altHref,
  note,
} = Astro.props;
---

<section class="container-x py-16">
  <div class="relative grid items-center gap-8 overflow-hidden rounded-[2rem] bg-brand-green p-8 md:grid-cols-[1.5fr_1fr] md:p-14">
    <div class="motion-float pointer-events-none absolute -bottom-20 -right-16 h-64 w-64 rounded-full border-[28px] border-brand-yellow/90"></div>
    <div class="motion-float pointer-events-none absolute right-40 top-8 h-6 w-6 rounded-full bg-brand-orange"></div>
    <span class="star-spin pointer-events-none absolute left-[45%] top-6 text-4xl text-brand-yellow" aria-hidden="true">✦</span>
    <span class="star-spin pointer-events-none absolute bottom-6 right-1/3 text-2xl text-brand-orange" aria-hidden="true">✦</span>
    <Badge id="cta-badge" class="absolute right-6 top-6 hidden text-brand-yellow md:grid" text="Book a call • Book a call • " />
    <div class="relative">
      <h2 class="text-3xl font-extrabold leading-tight text-white md:text-4xl">{title}</h2>
      <p class="mt-4 max-w-lg text-white/70">{text}</p>
    </div>
    <div class="relative md:justify-self-start">
      <a href={ctaHref} class="btn-primary">
        {ctaLabel}
      </a>
      {altLabel && (
        <a href={altHref} class="mt-4 block text-sm font-semibold text-white underline-offset-4 hover:underline">
          {altLabel}
        </a>
      )}
      {note && <p class="mt-3 max-w-xs text-xs text-white/60">{note}</p>}
    </div>
  </div>
</section>
