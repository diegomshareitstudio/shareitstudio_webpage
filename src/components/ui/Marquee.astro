---
/**
 * Auto-scrolling, infinitely looping strip (no manual scrolling). Moves left → right by default.
 * The track holds the items twice; the second copy is hidden from assistive tech and the tab order.
 * Pauses on hover/focus. For reduced motion it becomes a static, wrapping list (see motion.css).
 */
interface Item {
  name: string;
  href?: string;
}

interface Props {
  items: Item[];
  /** Move right → left instead */
  reverse?: boolean;
  /** Seconds for one full loop */
  duration?: number;
  label?: string;
}

const { items, reverse = false, duration = 40, label } = Astro.props;
const copies = [false, true];
---

<div class="marquee" data-reverse={reverse || undefined} style={`--marquee-duration:${duration}s`} aria-label={label} role={label ? 'group' : undefined}>
  <div class="marquee-track">
    {copies.map((hidden) => (
      <ul class="marquee-list" aria-hidden={hidden || undefined}>
        {items.map((c) => (
          <li>
            {c.href ? (
              <a href={c.href} tabindex={hidden ? -1 : undefined} class="marquee-chip marquee-chip--link">
                {c.name}
              </a>
            ) : (
              <span class="marquee-chip marquee-chip--static">{c.name}</span>
            )}
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>
