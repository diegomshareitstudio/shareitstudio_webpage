---
/**
 * Client testimonials. Every published video is featured (media + large quote), alternating sides; vertical
 * and horizontal videos both keep their own shape. With JS the featured ones become a slideshow (arrows, dots,
 * keyboard, swipe); without it they stay a list. Photos and empty slots run in a row of portrait cards below.
 * Videos load only their poster until played, carry captions and a readable transcript;
 * each real video also gets a VideoObject node (see testimonialVideoSchema in lib/schema.ts).
 */
import { Image, getImage } from 'astro:assets';
import Spotlight from './Spotlight.astro';
import type { Testimonial } from '../../data/testimonials';

interface Props {
  testimonials: Testimonial[];
}

const { testimonials } = Astro.props;

const isRealVideo = (t: Testimonial) => t.type === 'video' && !!t.video && !t.placeholder;
// Until a real video exists, the first entry keeps the featured spot so the layout can be previewed
const featured = testimonials.some(isRealVideo) ? testimonials.filter(isRealVideo) : testimonials.slice(0, 1);
const rest = testimonials.filter((t) => !featured.includes(t));

const posters = new Map(
  await Promise.all(
    testimonials.filter(isRealVideo).map(async (t) => {
      const poster = t.type === 'video' && t.video ? t.video.poster : undefined;
      const wide = !!poster && poster.width > poster.height;
      return [t, poster && (await getImage({ src: poster, width: wide ? 1280 : 720, format: 'webp' }))] as const;
    }),
  ),
);
const ratio = (t: Testimonial) => (t.type === 'video' && t.video ? `${t.video.poster.width} / ${t.video.poster.height}` : undefined);
const isWide = (t: Testimonial) => t.type === 'video' && !!t.video && t.video.poster.width > t.video.poster.height;

const affiliation = (t: Testimonial) => (t.company ? `${t.role}, ${t.company}` : t.role);
const who = (t: Testimonial) => `${t.name}, ${t.company ? `${t.role} at ${t.company}` : t.role}`;
---

<div class="tm-slider" data-tm-slider>
<div class="tm-featured-list">
  {featured.map((f, k) => (
    <figure
      class:list={['tm-featured', isWide(f) && 'tm-featured--wide', k % 2 === 1 && 'tm-featured--flip', k === 0 && 'is-active']}
      style={ratio(f) && `--ar: ${ratio(f)}`}
      data-tm-slide
      aria-label={`Testimonial ${k + 1} of ${featured.length}`}
    >
      <div class="tm-frame tm-frame--featured">
        {f.type === 'video' && f.video && !f.placeholder ? (
          <div class="tm-player" data-tm-player>
            <video
              class="tm-media"
              style={`aspect-ratio: ${ratio(f)}`}
              width={f.video.poster.width}
              height={f.video.poster.height}
              controls
              playsinline
              preload="none"
              poster={posters.get(f)?.src}
              aria-label={`Video testimonial from ${who(f)}`}
            >
              <source src={f.video.src} type="video/mp4" />
              {f.video.captions && <track kind="captions" src={f.video.captions} srclang="en" label="English" default />}
            </video>
            <button type="button" class="tm-play" data-tm-play aria-label={`Play video testimonial from ${who(f)}`} hidden></button>
          </div>
        ) : f.type === 'photo' && f.image && !f.placeholder ? (
          <Image src={f.image.src} alt={f.image.alt} class="tm-media" widths={[400, 800]} sizes="(min-width: 768px) 24rem, 100vw" />
        ) : (
          <div class="tm-media tm-empty" aria-hidden="true">
            <Spotlight id={`tm-spot-featured-${k}`} class="tm-empty-spot" />
            <span>{f.type === 'video' ? 'Video testimonial' : 'Client photo'}</span>
          </div>
        )}
      </div>

      <div class="tm-featured-body">
        <p class="eyebrow">{f.service}</p>
        <span class="tm-mark" aria-hidden="true">“</span>
        <blockquote>
          <p class="tm-quote font-display text-xl font-extrabold leading-snug text-brand-green md:text-[1.55rem]">
            <span class="sr-only">{f.quote}</span>
            <span aria-hidden="true" data-tm-type>{f.quote}</span>
          </p>
        </blockquote>
        <figcaption class="mt-5 flex items-center gap-4">
          {f.logo && (
            <Image src={f.logo.src} alt={`${f.logo.alt} logo`} height={72} densities={[1, 2]} class="tm-logo" />
          )}
          <span class:list={[f.logo && 'tm-who']}>
            <span class="block text-lg font-extrabold text-brand-green">{f.name}</span>
            <span class="text-sm text-brand-ink/60">{affiliation(f)}</span>
          </span>
        </figcaption>
        {f.type === 'video' && f.transcript && !f.placeholder && (
          <details class="tm-transcript mt-4 text-sm">
            <summary>Read the transcript</summary>
            <p class="mt-2 text-brand-ink/70">{f.transcript}</p>
          </details>
        )}
        {f.href && !f.placeholder && (
          <a href={f.href} class="btn-dark mt-6 self-start">See {f.company ?? f.name}’s case study</a>
        )}
      </div>
    </figure>
  ))}
</div>

{featured.length > 1 && (
  <div class="tm-nav" data-tm-nav hidden>
    <button type="button" class="tm-arrow tm-arrow--prev" data-tm-prev aria-label="Previous testimonial"></button>
    <div class="tm-dots" role="group" aria-label="Choose a testimonial">
      {featured.map((f, i) => (
        <button type="button" class="tm-dot" data-tm-dot aria-label={`Show ${f.name}’s testimonial`} aria-current={i === 0 ? 'true' : undefined}></button>
      ))}
    </div>
    <button type="button" class="tm-arrow tm-arrow--next" data-tm-next aria-label="Next testimonial"></button>
    <span class="tm-count" aria-hidden="true"><span data-tm-current>01</span> / {String(featured.length).padStart(2, '0')}</span>
  </div>
)}
<p class="sr-only" aria-live="polite" data-tm-status></p>
</div>

{rest.length > 0 && (
  <ul class="tm-rail" role="list" aria-label="More client testimonials">
    {rest.map((t, j) => {
      const isVideo = t.type === 'video' && t.video && !t.placeholder;
      return (
        <li class="tm-reel">
          <figure class="tm-frame">
            {t.type === 'video' && t.video && !t.placeholder ? (
              <div class="tm-player" data-tm-player>
                <video class="tm-media" controls playsinline preload="none" poster={posters.get(t)?.src} aria-label={`Video testimonial from ${who(t)}`}>
                  <source src={t.video.src} type="video/mp4" />
                  {t.video.captions && <track kind="captions" src={t.video.captions} srclang="en" label="English" default />}
                </video>
                <button type="button" class="tm-play" data-tm-play aria-label={`Play video testimonial from ${who(t)}`} hidden></button>
              </div>
            ) : t.type === 'photo' && t.image && !t.placeholder ? (
              <Image src={t.image.src} alt={t.image.alt} class="tm-media" widths={[320, 640]} sizes="18rem" />
            ) : (
              <div class="tm-media tm-empty" aria-hidden="true">
                <Spotlight id={`tm-spot-${j}`} class="tm-empty-spot" />
                <span>{t.type === 'video' ? 'Video testimonial' : 'Client photo'}</span>
              </div>
            )}
            <div class="tm-overlay" data-tm-overlay>
              <p class="text-[0.7rem] font-semibold uppercase tracking-wider text-brand-yellow">{t.service}</p>
              <blockquote class="mt-2">
                <p class="font-display text-base font-extrabold leading-snug md:text-lg">“{t.quote}”</p>
              </blockquote>
              <figcaption class="mt-3 text-sm">
                <span class="font-semibold">{t.name}</span>
                <span class="text-white/70"> · {affiliation(t)}</span>
              </figcaption>
            </div>
          </figure>
          {isVideo && t.type === 'video' && t.transcript && (
            <details class="tm-transcript mt-3 text-sm">
              <summary>Read the transcript</summary>
              <p class="mt-2 text-brand-ink/70">{t.transcript}</p>
            </details>
          )}
          {t.href && !t.placeholder && (
            <a href={t.href} class="mt-3 inline-block text-sm font-semibold text-brand-green">See the case study →</a>
          )}
        </li>
      );
    })}
  </ul>
)}

<style>
  /* ---------- Featured ---------- */
  .tm-featured {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .tm-featured-list {
    display: grid;
    gap: 5rem;
  }
  @media (min-width: 768px) {
    /* video and text sit together in the middle instead of drifting to opposite edges */
    .tm-featured {
      grid-template-columns: auto minmax(0, 34rem);
      justify-content: center;
      gap: 3rem;
    }
    /* horizontal videos get the wider column */
    .tm-featured--wide {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    }
    /* every other testimonial puts its video on the right */
    .tm-featured--flip {
      grid-template-columns: minmax(0, 34rem) auto;
    }
    .tm-featured--flip.tm-featured--wide {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
    }
    .tm-featured--flip > .tm-frame {
      order: 2;
      rotate: 2deg;
    }
  }
  /* a vertical video is as tall as the screen allows once the heading and arrows have their room (~15rem) */
  .tm-featured:not(.tm-featured--wide) > .tm-frame {
    justify-self: center;
    width: min(100%, 26rem, (100svh - 15rem) * (var(--ar, 4 / 5)));
  }

  /* ---------- Slideshow (only once the script runs; without it the testimonials stay a list) ---------- */
  .tm-slider.is-ready .tm-featured-list {
    gap: 0;
  }
  /* all slides share one cell, so the slider is as tall as the tallest one and never jumps */
  .tm-slider.is-ready .tm-featured {
    grid-area: 1 / 1;
    transition:
      opacity 0.5s ease,
      scale 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s;
  }
  .tm-slider.is-ready .tm-featured:not(.is-active) {
    opacity: 0;
    scale: 0.97;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.35s ease,
      scale 0.35s ease,
      visibility 0s 0.35s;
  }
  @media (prefers-reduced-motion: reduce) {
    .tm-slider.is-ready .tm-featured {
      transition: none !important;
    }
  }
  .tm-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .tm-nav[hidden] {
    display: none;
  }
  .tm-arrow {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border-radius: 9999px;
    box-shadow: inset 0 0 0 1px rgb(28 58 58 / 0.3);
    color: var(--color-brand-green);
    transition:
      background-color 0.2s,
      color 0.2s,
      box-shadow 0.2s;
  }
  .tm-arrow::before {
    content: '';
    width: 0.6rem;
    height: 0.6rem;
    border-top: 2.5px solid currentColor;
    border-right: 2.5px solid currentColor;
    rotate: 45deg;
    translate: -0.1rem 0;
  }
  .tm-arrow--prev::before {
    rotate: -135deg;
    translate: 0.1rem 0;
  }
  .tm-arrow:hover {
    background: var(--color-brand-green);
    box-shadow: none;
    color: #fff;
  }
  .tm-arrow:focus-visible,
  .tm-dot:focus-visible {
    outline: 3px solid var(--color-brand-orange);
    outline-offset: 3px;
  }
  .tm-dots {
    display: flex;
  }
  .tm-dot {
    display: grid;
    width: 2.25rem;
    height: 2.75rem;
    place-items: center;
  }
  .tm-dot::before {
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 9999px;
    background: rgb(28 58 58 / 0.25);
    transition:
      width 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.3s;
  }
  .tm-dot[aria-current='true']::before {
    width: 1.6rem;
    background: var(--color-brand-orange);
  }
  .tm-count {
    margin-left: 0.75rem;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 800;
    color: rgb(28 58 58 / 0.55);
    font-variant-numeric: tabular-nums;
  }
  .tm-featured-body {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .tm-mark {
    display: block;
    height: 2.5rem;
    margin-top: 0.25rem;
    font-family: var(--font-display);
    font-size: 5rem;
    font-weight: 800;
    line-height: 1;
    color: var(--color-brand-yellow);
  }
  /* Typewriter (only once the script has split the quote into letters). :global because the script creates
     the letter spans, so they never get Astro's scoping attribute. */
  :global(.tm-ch) {
    opacity: 0;
  }
  :global(.tm-ch.is-on) {
    opacity: 1;
  }
  /* the blinking cursor rides on the last letter typed */
  :global(.tm-ch.is-caret) {
    position: relative;
  }
  :global(.tm-ch.is-caret)::after {
    content: '';
    position: absolute;
    right: -0.08em;
    top: 0.1em;
    bottom: 0.05em;
    width: 0.08em;
    border-radius: 9999px;
    background: var(--color-brand-orange);
    animation: tm-blink 0.9s steps(1) infinite;
  }
  @keyframes tm-blink {
    50% {
      opacity: 0;
    }
  }
  /* the client's brand logo, separated from the name by a thin rule */
  .tm-logo {
    width: auto;
    height: 2.25rem;
    max-width: 8.5rem;
    object-fit: contain;
    object-position: left center;
  }
  .tm-who {
    border-left: 1px solid rgb(28 58 58 / 0.2);
    padding-left: 1rem;
  }

  /* ---------- Shared media frame ---------- */
  .tm-frame {
    position: relative;
    overflow: hidden;
    border-radius: 2rem;
    background: var(--color-brand-green);
    box-shadow: 0 40px 60px -40px rgb(0 0 0 / 0.55);
  }
  .tm-frame--featured {
    rotate: -2deg;
  }
  .tm-media {
    display: block;
    width: 100%;
    aspect-ratio: 9 / 16;
    object-fit: cover;
  }
  .tm-frame--featured .tm-media {
    aspect-ratio: 4 / 5;
  }
  .tm-empty {
    position: relative;
    display: grid;
    place-items: center;
    background: var(--color-brand-green);
    color: rgb(255 255 255 / 0.55);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .tm-empty span {
    position: relative;
  }
  .tm-empty-spot {
    position: absolute;
    height: 60%;
    width: auto;
    opacity: 0.25;
  }

  /* ---------- Play facade (shown only when JS runs) ---------- */
  .tm-player {
    position: relative;
  }
  .tm-play {
    position: absolute;
    left: 50%;
    top: 42%;
    width: 4.5rem;
    height: 4.5rem;
    translate: -50% -50%;
    border-radius: 9999px;
    background: var(--color-brand-yellow);
    box-shadow: 0 10px 30px -10px rgb(0 0 0 / 0.6);
    transition: scale 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .tm-play::before {
    content: '';
    position: absolute;
    left: 54%;
    top: 50%;
    translate: -50% -50%;
    border-block: 0.6rem solid transparent;
    border-left: 1rem solid var(--color-brand-green);
  }
  .tm-play:hover {
    scale: 1.08;
  }
  .tm-play:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }
  .tm-play[hidden] {
    display: none;
  }

  /* ---------- Row of reels: fits the container, no scrolling (extra entries wrap to a new row) ---------- */
  .tm-rail {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 4rem;
    align-items: start;
  }
  @media (min-width: 768px) {
    .tm-rail {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem;
    }
    .tm-reel:nth-child(even) {
      margin-top: 2rem;
    }
  }
  .tm-rail .tm-frame {
    border-radius: 1.5rem;
  }
  .tm-overlay {
    position: absolute;
    inset: auto 0 0;
    padding: 3rem 0.9rem 0.9rem;
    background: linear-gradient(to top, rgb(14 38 38 / 0.92) 55%, transparent);
    color: #fff;
    pointer-events: none;
    transition: opacity 0.3s;
  }
  .tm-frame.is-playing .tm-overlay {
    opacity: 0;
  }

  .tm-transcript summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--color-brand-green);
  }
</style>

<script>
  // Swap native controls for a single play button until the viewer starts the video
  document.querySelectorAll<HTMLElement>('[data-tm-player]').forEach((player) => {
    const video = player.querySelector('video');
    const play = player.querySelector<HTMLButtonElement>('[data-tm-play]');
    if (!video || !play) return;
    video.controls = false;
    play.hidden = false;
    play.addEventListener('click', () => {
      play.hidden = true;
      video.controls = true;
      player.closest('.tm-frame')?.classList.add('is-playing');
      void video.play();
    });
  });

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /** Splits a quote into letters once; play() types it out, reset() hides it again. */
  function typewriter(el: HTMLElement) {
    const chars = Array.from(el.textContent ?? '').map((c) => {
      const span = document.createElement('span');
      span.className = 'tm-ch';
      span.textContent = c;
      return span;
    });
    el.replaceChildren(...chars);
    let frame = 0;
    const set = (n: number) =>
      chars.forEach((c, i) => {
        c.classList.toggle('is-on', i < n);
        c.classList.toggle('is-caret', i === n - 1 && n < chars.length);
      });
    const reset = () => {
      cancelAnimationFrame(frame);
      set(0);
    };
    const play = () => {
      reset();
      // the whole quote takes at most ~2.4s, short ones type a little slower
      const perChar = Math.min(32, 2400 / chars.length);
      const start = performance.now();
      const tick = (now: number) => {
        const n = Math.min(chars.length, Math.floor((now - start) / perChar) + 1);
        set(n);
        if (n < chars.length) frame = requestAnimationFrame(tick);
      };
      frame = requestAnimationFrame(tick);
    };
    reset();
    return { play, reset };
  }

  // Featured testimonials become a slideshow: one at a time, arrows, dots and the keyboard move between them.
  // The visible quote types itself out every time it comes on screen or its slide is shown.
  document.querySelectorAll<HTMLElement>('[data-tm-slider]').forEach((slider) => {
    const slides = Array.from(slider.querySelectorAll<HTMLElement>('[data-tm-slide]'));
    const typers = reduceMotion
      ? []
      : slides.map((s) => {
          const el = s.querySelector<HTMLElement>('[data-tm-type]');
          return el ? typewriter(el) : undefined;
        });
    let active = 0;
    let onScreen = false;
    const typeActive = () => typers.forEach((t, i) => (i === active && onScreen ? t?.play() : t?.reset()));
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting === onScreen) return;
        onScreen = entry.isIntersecting;
        typeActive();
      },
      { threshold: 0.35 },
    ).observe(slider);

    const nav = slider.querySelector<HTMLElement>('[data-tm-nav]');
    if (slides.length < 2 || !nav) return;
    const dots = Array.from(nav.querySelectorAll<HTMLButtonElement>('[data-tm-dot]'));
    const current = nav.querySelector('[data-tm-current]');
    const status = slider.querySelector('[data-tm-status]');

    const setCurrent = (el: HTMLElement, yes: boolean) =>
      yes ? el.setAttribute('aria-current', 'true') : el.removeAttribute('aria-current');
    const show = (next: number, announce = true) => {
      active = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const on = i === active;
        slide.classList.toggle('is-active', on);
        slide.inert = !on;
        // a video never keeps playing out of sight
        if (!on) slide.querySelectorAll('video').forEach((v) => v.pause());
      });
      dots.forEach((d, i) => setCurrent(d, i === active));
      if (current) current.textContent = String(active + 1).padStart(2, '0');
      if (announce && status) status.textContent = slides[active].getAttribute('aria-label') ?? '';
      typeActive();
    };

    nav.querySelector('[data-tm-prev]')?.addEventListener('click', () => show(active - 1));
    nav.querySelector('[data-tm-next]')?.addEventListener('click', () => show(active + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => show(i)));
    slider.addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement).closest('video, details')) return;
      if (e.key === 'ArrowLeft') show(active - 1);
      if (e.key === 'ArrowRight') show(active + 1);
    });

    // Horizontal swipes on touch screens
    let startX = 0;
    let startY = 0;
    slider.addEventListener('touchstart', (e) => ([startX, startY] = [e.touches[0].clientX, e.touches[0].clientY]), { passive: true });
    slider.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      const dy = e.changedTouches[0].clientY - startY;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(active + (dx < 0 ? 1 : -1));
    });

    nav.hidden = false;
    slider.classList.add('is-ready');
    show(0, false);
  });
</script>
