---
/**
 * Portfolio gallery that scrolls by itself (one row; stack two with opposite `reverse` for a belt effect).
 * Each copy of the row must be wider than the screen, so the items are repeated until it is.
 * Only the first pass is exposed to assistive tech; repeats and the second copy are aria-hidden.
 */
interface Props {
  items: string[];
  aspect?: 'square' | 'wide' | 'video' | 'vertical';
  reverse?: boolean;
  duration?: number;
  /** Tilts the cards alternately for a looser, playful feel */
  playful?: boolean;
}

const { items, aspect = 'square', reverse = false, duration = 60, playful = true } = Astro.props;

const card = {
  square: { w: 'w-60 sm:w-72', ratio: 'aspect-square', px: 304 },
  wide: { w: 'w-[22rem] sm:w-[30rem]', ratio: 'aspect-[970/600]', px: 496 },
  video: { w: 'w-80 sm:w-[26rem]', ratio: 'aspect-video', px: 432 },
  vertical: { w: 'w-44 sm:w-52', ratio: 'aspect-[9/16]', px: 232 },
}[aspect];

const passes = Math.max(1, Math.ceil(2800 / (items.length * card.px)));
const copies = [false, true];
---

<div class="marquee marquee--media" data-reverse={reverse || undefined} style={`--marquee-duration:${duration}s`}>
  <div class="marquee-track">
    {copies.map((dupe) => (
      <ul class="marquee-list" aria-hidden={dupe || undefined}>
        {Array.from({ length: passes }).map((_, pass) =>
          items.map((item, i) => (
            <li class:list={['shrink-0', card.w]} aria-hidden={pass > 0 || undefined}>
              <figure class="group">
                <div
                  class:list={[
                    'placeholder',
                    card.ratio,
                    playful && (i % 2 ? 'rotate-[1.5deg]' : '-rotate-[1.5deg]'),
                  ]}
                >
                  <span class="px-4">{aspect === 'video' || aspect === 'vertical' ? '▶ ' : ''}Image placeholder</span>
                </div>
                <figcaption class="mt-3 text-sm font-medium text-brand-green">{item}</figcaption>
              </figure>
            </li>
          )),
        )}
      </ul>
    ))}
  </div>
</div>
