---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  align?: 'split' | 'left';
  /** id of the <h2>, for aria-labelledby on the parent section */
  id?: string;
}

const { eyebrow, title, text, align = 'split', id } = Astro.props;
---

<div class:list={['mb-8 gap-4 md:mb-12 md:gap-6', align === 'split' ? 'grid md:grid-cols-[1.3fr_1fr] md:items-end' : 'max-w-2xl']}>
  <div>
    {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
    <h2 id={id} class="text-[1.7rem] font-extrabold leading-tight text-brand-green sm:text-3xl md:text-[2.6rem]">{title}</h2>
  </div>
  {text && <p class="scrub-text text-base text-brand-ink/65 sm:text-lg md:pb-1">{text}</p>}
</div>
