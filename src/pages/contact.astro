---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/ui/PageHero.astro';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact | Share It Studio',
  url: 'https://shareitstudio.com/contact',
};

const services = ['Listing Images', 'A+ Content', 'Storefront', 'Videos', 'Social Media', 'Branding', 'Not sure yet'];
const input = 'mt-1 w-full rounded-lg border border-black/15 bg-white px-4 py-3 outline-none transition focus:border-brand-green focus:ring-2 focus:ring-brand-yellow/60';
---

<Layout title="Contact Us | Share It Studio" description="Get in touch with Share It Studio about Amazon listing images, A+ Content, videos and more." schema={contactSchema}>
  <PageHero eyebrow="Contact" title="Let’s talk about your listing" subtitle="Tell us about your brand and we’ll get back to you within one business day." />

  <section class="container-x grid gap-12 py-16 md:grid-cols-[1fr_1.4fr] md:py-20">
    <aside class="space-y-6">
      <div class="rounded-2xl bg-brand-cream p-7">
        <h2 class="text-xl font-bold text-brand-green">Prefer to talk live?</h2>
        <p class="mt-2 text-brand-ink/70">Book a free 30-minute strategy call with our team.</p>
        <a href="/call" class="btn-primary mt-5">Schedule a Call</a>
      </div>
      <div class="rounded-2xl border border-black/5 p-7">
        <h2 class="text-xl font-bold text-brand-green">Contact details</h2>
        <dl class="mt-4 space-y-3 text-sm">
          <div><dt class="font-bold">Email</dt><dd class="text-brand-ink/70">hello@shareitstudio.com (placeholder)</dd></div>
          <div><dt class="font-bold">Hours</dt><dd class="text-brand-ink/70">Mon–Fri, 9:00–18:00</dd></div>
          <div><dt class="font-bold">Response time</dt><dd class="text-brand-ink/70">Within 1 business day</dd></div>
        </dl>
      </div>
    </aside>

    <form id="contact-form" class="rounded-3xl border border-black/5 bg-white p-7 shadow-lg md:p-10">
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="block text-sm font-medium">Name<input required name="name" class={input} /></label>
        <label class="block text-sm font-medium">Email<input required type="email" name="email" class={input} /></label>
        <label class="block text-sm font-medium">Brand name<input name="brand" class={input} /></label>
        <label class="block text-sm font-medium">Amazon store / ASIN<input name="asin" class={input} placeholder="Optional" /></label>
      </div>
      <fieldset class="mt-6">
        <legend class="text-sm font-medium">What are you interested in?</legend>
        <div class="mt-3 flex flex-wrap gap-2">
          {services.map((s) => (
            <label class="cursor-pointer">
              <input type="checkbox" name="services" value={s} class="peer sr-only" />
              <span class="inline-block rounded-full border border-black/15 px-4 py-1.5 text-sm transition peer-checked:border-brand-green peer-checked:bg-brand-green peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-brand-yellow">{s}</span>
            </label>
          ))}
        </div>
      </fieldset>
      <label class="mt-6 block text-sm font-medium">Message<textarea name="message" rows="5" class={input}></textarea></label>
      <button type="submit" class="btn-orange mt-6 w-full py-3 text-base">Send message</button>
      <p id="form-status" class="mt-4 hidden rounded-lg bg-brand-yellow-soft p-3 text-center text-sm text-brand-green" role="status">
        Prototype: the form is not connected to a backend yet.
      </p>
    </form>
  </section>
</Layout>

<script>
  document.getElementById('contact-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    document.getElementById('form-status')?.classList.remove('hidden');
  });
</script>
