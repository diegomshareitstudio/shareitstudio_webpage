---
/**
 * Portfolio hub (blueprint P15 v1.0): a visual, category-led hub with seven category tiles.
 * Sections: Hero → Seven-category mosaic → (Selected work spotlight: omitted until approved assets exist, D01/D04)
 * → Services + final CTA. No metrics or outcome claims: samples show capability, not results.
 * TODO: replace tile placeholders with approved, permissioned work (PORT-CAT-01…07).
 */
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';
import { itemListSchema } from '../../lib/schema';

// Seven categories from the blueprint, in order. `span` shapes the asymmetric grid on large screens.
const categories = [
  {
    name: 'A+ Content',
    text: 'Desktop and mobile A+ modules for Amazon product pages.',
    href: '/portfolio/a-plus-content',
    span: 'lg:col-span-3',
  },
  {
    name: 'Hero Images',
    text: 'Main listing images designed for Amazon search results.',
    href: '/portfolio/hero-images',
    span: 'lg:col-span-3',
  },
  {
    name: 'Amazon Infographics',
    text: 'Listing images that explain features and benefits.',
    href: '/portfolio/amazon-infographics',
    span: 'lg:col-span-2',
  },
  {
    name: 'Lifestyle Photography',
    text: 'Product photography shown in use.',
    href: '/portfolio/lifestyle-photography',
    span: 'lg:col-span-2',
  },
  {
    name: 'Video Production',
    text: 'Listing videos and Sponsored Brands video ads.',
    href: '/portfolio/video-production',
    span: 'lg:col-span-2',
  },
  {
    name: 'Other Services',
    text: 'Other Amazon creative work, such as Brand Story and Storefront design.',
    href: '/portfolio/other-services',
    span: 'lg:col-span-3',
  },
  {
    name: 'Social Media Portfolio',
    text: 'Reels, carousels and social content for ecommerce brands.',
    href: '/portfolio/social-media',
    span: 'lg:col-span-3',
  },
];

const breadcrumbs = [{ name: 'Portfolio', path: '/portfolio' }];
const schema = [
  itemListSchema(
    '/portfolio',
    'Portfolio categories',
    categories.map((c) => ({ name: c.name, path: c.href })),
  ),
];
---

<Layout
  title="Amazon & Ecommerce Creative Portfolio | Share It Studio"
  description="Explore Share It Studio’s Amazon and ecommerce creative work, from A+ Content and hero images to product photography, video and social media."
  breadcrumbs={breadcrumbs}
  pageType="CollectionPage"
  schema={schema}
>
  <!-- 01 — Hero / visual statement -->
  <PageHero
    eyebrow="Share It Studio"
    title="Our Portfolio"
    highlight="Portfolio"
    subtitle="A curated view of Amazon and ecommerce creative work, organized by format so you can quickly find the examples relevant to your brand."
    ctaLabel="Explore the Portfolio"
    ctaHref="#portfolio-categories"
    secondaryLabel="View Services"
    secondaryHref="/services"
  />

  <!-- 02 — Seven-category portfolio mosaic -->
  <section id="portfolio-categories" class="container-x scroll-mt-24 py-16 md:py-20" aria-labelledby="work-heading">
    <SectionHeading id="work-heading" title="Explore Our Work" align="left" />
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-6">
      {categories.map((c) => (
        <li class:list={['flex', c.span]}>
          <a
            href={c.href}
            class="group flex w-full flex-col overflow-hidden rounded-[2rem] bg-brand-cream p-3 transition hover:-translate-y-1 hover:shadow-xl"
          >
            <div class="placeholder aspect-[16/10] rounded-[1.6rem] bg-white transition group-hover:bg-brand-yellow-soft">
              {c.name} preview
            </div>
            <div class="flex flex-1 flex-col p-5">
              <h3 class="text-2xl font-extrabold text-brand-green">{c.name}</h3>
              <p class="mt-1 flex-1 text-sm text-brand-ink/70">{c.text}</p>
              <span class="mt-4 text-sm font-semibold text-brand-green transition group-hover:translate-x-1">
                View {c.name} →
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-6 text-xs text-brand-ink/50">
      Portfolio samples show our creative work. They are not measured results; see our
      <a href="/case-studies" class="underline">case studies</a> for documented outcomes.
    </p>
  </section>

  <!-- 04 — Explore services + final CTA -->
  <CtaBanner
    title="Bring Your Project to Life"
    text="Tell us about your brand and what you need. We’ll tailor the conversation to your project."
    ctaLabel="Book a Call"
    ctaHref="/book-a-call"
    altLabel="Explore Services"
    altHref="/services"
  />
</Layout>
