---
import PortfolioPage from '../../components/PortfolioPage.astro';

const benefits = [
  {
    "title": "Lift in sales",
    "text": "Well-designed A+ Content can measurably increase conversion — we design for that upside."
  },
  {
    "title": "Cohesive storytelling",
    "text": "Modules flow as one narrative instead of disconnected banners."
  },
  {
    "title": "Cross-sell built in",
    "text": "Comparison charts guide shoppers to the rest of your catalog."
  }
];
---

<PortfolioPage
  title="A+ Content"
  metaTitle="A+ Content Portfolio | Share It Studio"
  description="Rich, scroll-stopping modules that lift conversion below the fold. Explore Share It Studio’s A+ Content portfolio for Amazon sellers."
  subtitle="Rich, scroll-stopping modules that lift conversion below the fold."
  intro="A+ Content replaces plain product descriptions with visual storytelling. We design custom module sets that explain your product, reinforce your brand and push hesitant shoppers to add to cart."
  items={["Header banner module", "Feature highlight module", "Comparison table", "Brand values module", "Usage steps module", "Technical specs module"]}
  aspect="wide"
  benefits={benefits}
/>
