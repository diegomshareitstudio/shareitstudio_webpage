---
import PortfolioPage from '../../../components/PortfolioPage.astro';

const benefits = [
  {
    "title": "Persona-driven",
    "text": "Models, settings and props chosen for your exact target customer."
  },
  {
    "title": "Emotional connection",
    "text": "Scenes that sell the outcome, not just the object."
  },
  {
    "title": "Studio or 3D",
    "text": "Photography, 3D renders or a mix — whatever fits your budget and product."
  }
