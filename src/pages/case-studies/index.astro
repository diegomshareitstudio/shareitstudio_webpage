---
import Layout from '../../layouts/Layout.astro';

const collectionpageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": "https://shareitstudio.com/case-studies#collectionpage",
  "name": "Case Studies | Share It Studio",
  "url": "https://shareitstudio.com/case-studies",
  "description": "Explore our case studies to see how Share It Studio has helped businesses optimize their Amazon listings and boost e-commerce performance."
};

const breadcrumbListSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": "https://shareitstudio.com/case-studies#breadcrumb",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://shareitstudio.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Case Studies",
      "item": "https://shareitstudio.com/case-studies"
    }
  ]
};

const combinedSchema = [collectionpageSchema, breadcrumbListSchema];
---

<Layout 
  title="Case Studies | Share It Studio" 
  description="Explore our case studies to see how Share It Studio has helped businesses optimize their Amazon listings and boost e-commerce performance."
  schema={combinedSchema}>

  <a href="/case-studies/pink-miracle">Pink Miracle Case Study</a>
<br/>
  <a href="/case-studies/rossm">ROSSM</a>
  <br/>

  <a href="/case-studies/vizayo">Vizayo</a>
  <br/>

  <a href="/case-studies/red">Case Study 4</a>
  <br/>

  <a href="/case-studies/yellow">Case Study 5</a>
  <br/>

  <a href="/case-studies/purple">Case Study 6</a>
  <br/>

  <a href="/case-studies/orange">Case Study 7</a>
  <br/>

  <a href="/case-studies/indigo">Case Study 8</a>
  <br/>

  <a href="/case-studies/violet">Case Study 9</a>
  <br/>



</Layout>