---
/**
 * Case Studies hub (blueprint P23 v1.0): an index of client case studies.
 * Four sections: Hero → Case-study directory → Related services and work → Final CTA.
 * Cards describe the work only; no metrics until each is evidence-approved (baseline, period, source).
 * TODO: client publication permission and assets are PENDING per case.
 */
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';
import { getCaseStudy, caseStudyHref, listedCaseStudies } from '../../data/caseStudies';
import { itemListSchema } from '../../lib/schema';

// Order from the blueprint's candidate set; super-ninja keeps its existing legacy slug
const order = ['yungprime', 'pink-miracle', 'super-ninja', 'paper2eat'];
const cases = order.map(getCaseStudy).filter((c) => listedCaseStudies.includes(c));

const breadcrumbs = [{ name: 'Case Studies', path: '/case-studies' }];
const schema = [
  itemListSchema(
    '/case-studies',
    'Share It Studio case studies',
    cases.map((c) => ({ name: `${c.client} case study`, path: caseStudyHref(c) })),
  ),
];
---

<Layout
  title="Case Studies | Share It Studio Client Work"
  description="Explore Share It Studio case studies to see selected client projects, the work completed, and documented outcomes where available."
  breadcrumbs={breadcrumbs}
  pageType="CollectionPage"
  schema={schema}
>
  <!-- 01 — Hero / introduction -->
  <PageHero
    eyebrow="Share It Studio"
    title="Case Studies"
    highlight="Case Studies"
    subtitle="Each case study is a real client project. Read the challenge, the work Share It Studio delivered and the results we can document, then open the projects most relevant to your brand."
    ctaLabel="Explore Case Studies"
    ctaHref="#case-studies"
  />

  <!-- 02 — Case-study directory -->
  <section id="case-studies" class="container-x scroll-mt-24 py-16 md:py-20" aria-labelledby="cases-heading">
    <SectionHeading id="cases-heading" title="Explore Our Case Studies" align="left" />
    <ul class="grid gap-6 md:grid-cols-2">
      {cases.map((c) => (
        <li class="flex">
          <a
            href={caseStudyHref(c)}
            class="group flex w-full flex-col rounded-[2rem] bg-brand-cream p-3 transition hover:-translate-y-1 hover:shadow-xl"
          >
            {c.image ? (
              <div class="grid aspect-[16/10] place-items-center overflow-hidden rounded-[1.6rem] bg-white p-4">
                <Image src={c.image.src} alt={c.image.alt} class="max-h-full w-auto object-contain" loading="lazy" />
              </div>
            ) : (
              <div class="placeholder aspect-[16/10] rounded-[1.6rem] bg-white">{c.client} project visual</div>
            )}
            <div class="flex flex-1 flex-col p-5">
              <p class="text-xs font-semibold uppercase tracking-wider text-brand-orange">{c.niche}</p>
              <h3 class="mt-2 text-3xl font-extrabold text-brand-green">{c.client}</h3>
              <p class="mt-2 flex-1 text-brand-ink/70">{c.focus}</p>
              <span class="mt-5 font-semibold text-brand-green transition group-hover:translate-x-1">
                Read Case Study →
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- 03 — Related services and work -->
  <section class="bg-brand-cream py-12" aria-labelledby="related-heading">
    <div class="container-x">
      <h2 id="related-heading" class="text-2xl font-extrabold text-brand-green">Explore Our Services</h2>
      <p class="mt-2 max-w-2xl text-brand-ink/70">
        Case studies show specific projects. Service pages describe what you can hire today, and the portfolio shows
        the creative work itself.
      </p>
      <ul class="mt-6 flex flex-wrap gap-3">
        <li><a href="/services" class="btn-outline">Explore Services</a></li>
        <li><a href="/services/amazon-listing-optimization" class="btn-outline">Amazon Listing Optimization</a></li>
        <li><a href="/portfolio" class="btn-outline">View Portfolio</a></li>
      </ul>
    </div>
  </section>

  <!-- 04 — Final consultation CTA -->
  <CtaBanner
    title="Let’s Talk About Your Project"
    text="Book a call to discuss your own brand and goals. Results from other clients are not a forecast for yours."
    ctaLabel="Book a Call"
    ctaHref="/book-a-call"
    altLabel="Prefer to write to us? Contact Us"
    altHref="/contact-us"
  />
</Layout>
