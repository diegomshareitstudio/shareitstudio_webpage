---
import Layout from '../../layouts/Layout.astro';

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": "https://shareitstudio.com/case-studies/rossm#article",
  "headline": "ROSSM Case Study | Share It Studio",
  "description": "Elevating ROSSM’s Amazon Listing for Minimalist Wallets",
  "author": {
    "@type": "Organization",
    "name": "Share It Studio"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Share It Studio",
    // Optional: Add a logo if available
    // "logo": {
    //   "@type": "ImageObject",
    //   "url": "https://shareitstudio.com/logo.png"
    // }
  }
};

const breadcrumbListSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": "https://shareitstudio.com/case-studies/rossm#breadcrumb",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://shareitstudio.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Case Studies",
      "item": "https://shareitstudio.com/case-studies"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "ROSSM Case Study",
      "item": "https://shareitstudio.com/case-studies/rossm"
    }
  ]
};

const combinedSchema = [articleSchema, breadcrumbListSchema];
---

<Layout 
  title="ROSSM Case Study | Share It Studio" 
  description="Elevating ROSSM’s Amazon Listing for Minimalist Wallets"
  schema={combinedSchema}
>
<h1> ROSSM</h1>
</Layout>