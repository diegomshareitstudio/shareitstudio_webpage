---
import Layout from '../layouts/Layout.astro';
import faqs from '../data/faqs.json';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "https://shareitstudio.com/faq#faq",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout 
  title="Frequently Asked Questions | Share It Studio" 
  description="Find answers to common questions about Share It Studio's services, processes, and more. Get the information you need to make informed decisions."
  schema={faqSchema}
>
  <!-- Inyección de Schema.org para SEO -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <main class="max-w-3xl mx-auto px-4 py-12">
    <header class="mb-8 text-center">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900">Frequently Asked Questions</h1>
      <p class="mt-2 text-gray-600">Everything you need to know about us.</p>
    </header>

    <section class="space-y-4">
      {faqs.map((faq) => (
        <details class="group bg-white border border-gray-200 rounded-lg p-6 shadow-sm transition-all open:shadow-md">
          <summary class="flex justify-between items-center cursor-pointer font-semibold text-gray-900 list-none">
            <span>{faq.question}</span>
            <span class="transition-transform duration-200 group-open:rotate-180 text-gray-500">
              ▼
            </span>
          </summary>
          <p class="mt-4 text-gray-600 leading-relaxed">
            {faq.answer}
          </p>
        </details>
      ))}
    </section>
  </main>
</Layout>