---
/**
 * /call: separate booking destination required by the Contact Us v2.0 blueprint (sales CTAs → /call).
 * PLACEHOLDER until its own blueprint arrives. Hidden from search (noindex) and without a scheduler:
 * SITE.bookingUrl is empty, so the page falls back to email. Replace this page when the /call blueprint is applied.
 */
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/ui/PageHero.astro';
import { SITE } from '../config/site';

const { email, bookingUrl } = SITE;
const breadcrumbs = [{ name: 'Book a Call', path: '/call' }];
---

<Layout
  title="Book a Call | Share It Studio"
  description="Schedule a conversation with Share It Studio about Amazon listing content or ecommerce social media."
  breadcrumbs={breadcrumbs}
  noindex
>
  <PageHero
    eyebrow="Consultation"
    title="Book a Call"
    highlight="Call"
    subtitle="Talk with the Share It Studio team about your brand and which service fits."
    ctaLabel={bookingUrl ? 'Book a Call' : 'Email Us to Schedule'}
    ctaHref={bookingUrl || `mailto:${email}`}
    secondaryLabel="Explore Services"
    secondaryHref="/services"
  />
</Layout>
