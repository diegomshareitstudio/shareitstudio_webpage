---
/**
Prototype 2.
 */
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import CtaBanner from '../components/ui/CtaBanner.astro';
import FaqList from '../components/ui/FaqList.astro';
import AskAi from '../components/ui/AskAi.astro';
import BrandDiagnosisSection from '../components/forms/BrandDiagnosisSection.astro';
import Spotlight from '../components/ui/Spotlight.astro';
import '../styles/selector.css';
import '../styles/home.css';
import { slideOffset, slidePos, slideSide } from '../lib/selector';
import { Image, getImage } from 'astro:assets';
import superNinjaListing from '../assets/case-studies/super-ninja/new-listing.png';
// The logo's letters without its spotlight (made from brand/share-it-studio-logo.png); the spotlight is Spotlight.astro
import wordmark from '../assets/brand/share-it-studio-wordmark.png';
// TODO: sample A+ images standing in until each case has its own (the selector crops them to a square from the top)
import sampleBasket from '../assets/samples/A+ Content Jute Hanging Basket.jpg';
import sampleBodyWash from '../assets/samples/Body-Wash-Cleanser_A+-Content.png';
import sampleCream from '../assets/samples/Copy of A+ Content Progesterone Cream.jpg';
import TextMarquee from '../components/ui/TextMarquee.astro';
import Testimonials from '../components/ui/Testimonials.astro';
import { testimonials } from '../data/testimonials';
import { testimonialVideoSchema, type Schema } from '../lib/schema';
import type { Faq } from '../data/faqs';

const title = 'Share It Studio | Amazon Listing Optimization & Social Media Management';
const description =
  'Amazon listing images, A+ Content, video and copy that help shoppers understand your product, plus social media management for ecommerce brands. Talk to our team.';

const bookHref = '/book-a-call';

// 02 — two proof points. Individual project results in different reporting periods.
const results = [
  {
    label: 'Social Media | Organic Discovery',
    stat: '3M+',
    statLabel: 'organic views in 90 days',
    detail: 'A new Instagram account · $0 in paid ads · Feb–May 2026',
    cta: 'Explore the 90-Day Social Case',
    href: '/our-work',
  },
  {
    label: 'Amazon | YUNGPRIME',
    stat: '+28.3%',
    statLabel: 'organic Amazon sales',
    detail: '$16,432 → $21,077 · May to June',
    cta: 'See YUNGPRIME’s Transformation',
    href: '/case-studies/yungprime',
  },
];

// 03 — the two services
const services = [
  {
    label: 'Social Media Management',
    title: 'Build an audience before you need the sale.',
    text: 'Strategy, scripts, production and publishing, every month. For ecommerce brands, on Amazon or beyond.',
    cta: 'Explore Social Media Management',
    href: '/services/social-media-management',
  },
  {
    label: 'Amazon Listing Optimization',
    title: 'Your product might be better. Does your listing make that obvious?',
    text: 'Images, A+ Content, video and copy built around what your buyers ask. One deliverable or the whole listing.',
    cta: 'Explore Amazon Listing Optimization',
    href: '/services/amazon-listing-optimization',
  },
];

// 04 — testimonials: VideoObject markup for each published video (placeholders are skipped)
const videoSchema: Schema[] = [];
for (const [i, t] of testimonials.entries()) {
  if (t.type !== 'video' || !t.video || t.placeholder) continue;
  const thumb = await getImage({ src: t.video.poster, width: 1280, format: 'jpg' });
  videoSchema.push(testimonialVideoSchema('/', i, t, { ...t.video, thumbnail: thumb.src }));
}

// 05 — selected work: image, title, the result (as prominent as the title), then the story.
// `before` renders as the starting point of `stat`.
const work = [
  {
    cat: 'Social Media | Organic Discovery',
    title: 'Creating reasons to come back',
    stat: '2.2M',
    statLabel: 'accounts reached (approx.)',
    detail: '3,057,772 organic views in 90 days · $0 reported paid ad spend',
    text: 'Recurring themes built around audience interests, so new people kept finding the account.',
    cta: 'Explore the 90-Day Social Case',
    href: '/our-work',
    image: { src: sampleBasket, alt: 'Sample A+ Content: jute hanging basket' },
  },
  {
    cat: 'Amazon | YUNGPRIME',
    title: 'One buying story across every listing touchpoint',
    before: '2.74%',
    stat: '2.96%',
    statLabel: 'organic conversion rate',
    detail: '+28.3% organic sales · $16,432 → $21,077 · May–June 2026',
    text: 'Images, A+ Content, Brand Story, Storefront, video and copy telling one clear buying story.',
    cta: 'See YUNGPRIME’s Transformation',
    href: '/case-studies/yungprime',
    image: { src: sampleBodyWash, alt: 'Sample A+ Content: body wash cleanser' },
  },
  {
    cat: 'Amazon | Pink Miracle',
    title: 'Rethinking the creative for an established product',
    before: '$404K',
    stat: '$606K',
    statLabel: 'in reported monthly sales',
    detail: 'July–August 2024 · Figures shown in the original case-study chart',
    text: 'New creative, tested against customer preferences, for a product that was already selling.',
    cta: 'Explore Pink Miracle’s Before and After',
    href: '/case-studies/pink-miracle',
    image: { src: sampleCream, alt: 'Sample A+ Content: progesterone cream' },
  },
  {
    cat: 'Amazon | Super Ninja',
    title: 'One product category. Different markets. Different questions.',
    stat: '+91.5%',
    statLabel: 'reported product sales — Germany',
    detail: 'Main ASIN · August 2024 vs. August 2025 · Case-study deck figure',
    text: 'Imagery and explanations adapted to what buyers ask in Germany, the UK and the US.',
    cta: 'See the Market-Specific Case',
    href: '/case-studies/super-ninja',
    image: { src: superNinjaListing, alt: 'Super Ninja fruit fly trap Amazon listing images' },
  },
] as {
  cat: string;
  title: string;
  before?: string;
  stat: string;
  statLabel: string;
  detail: string;
  text: string;
  cta: string;
  href: string;
  image?: { src: ImageMetadata; alt: string };
}[];

// 06 — how we work
const steps = [
  { t: 'Get clear on the goal', d: 'Your product, your audience, your priorities.' },
  { t: 'Decide what matters', d: 'What needs explaining, and what needs proof.' },
  { t: 'Bring it to life', d: 'Images, A+ Content, copy, video or social.' },
  { t: 'Review and improve', d: 'Feedback and data shape the next round.' },
];

// 08 — FAQ
const faqs: Faq[] = [
  {
    q: 'Can I hire you for just A+ Content, listing images, or another Amazon deliverable?',
    a: 'Yes. Hire one service, or combine several into a custom project.',
  },
  {
    q: 'Do you manage social media for brands that don’t sell on Amazon?',
    a: 'Yes. Channels and posting cadence depend on the monthly plan.',
  },
  {
    q: 'How is pricing structured?',
    a: 'Amazon work is quoted per project. Social media runs on monthly plans.',
  },
  {
    q: 'Can you work alongside our existing marketing or PPC team?',
    a: 'Yes, when it’s part of the project. Ads and account management aren’t included in listing creative.',
  },
  {
    q: 'Is everything created with AI?',
    a: 'No. Real photography, video, your own assets or AI-assisted work, always directed and reviewed by people.',
  },
  {
    q: 'How do you evaluate whether the content is working?',
    a: 'With the data available: reach and engagement on social; CTR, conversion and sales on Amazon.',
  },
];
---

<Layout title={title} description={description} schema={videoSchema}>
  <!-- Pick the pinned hero layout before the first paint, so it never swaps in later (CLS). Mirrors the checks in
       scripts/home.ts, which has the final word: reduced motion and very short viewports keep the stacked layout. -->
  <script is:inline>
    if (innerHeight >= 480)
      document.documentElement.classList.add('home-ready');
  </script>
  <!-- 01 — Hero (scene A) + the heading of 02 (scene B). Pinned briefly on desktop/mobile while the spotlight expands. -->
  <div class="home-intro" data-home-intro>
    <div class="home-stage" data-stage>
      <div class="home-atmos" aria-hidden="true"><span></span><span></span></div>
      <Spotlight id="hero-spot" class="home-spot" />

      <section class="scene scene-a" data-scene-a aria-labelledby="hero-heading">
        <div class="scene-inner">
          <!-- The logo's letters over its own spotlight; on scroll scripts/home.ts swaps in the big spotlight at the
               same spot and grows it until it fills the screen -->
          <div class="home-logo" data-spot-logo>
            <Spotlight id="logo-spot" class="home-logo-spot" />
            <Image
              src={wordmark}
              alt="Share It Studio"
              widths={[480, 800, 1200]}
              sizes="min(80vw, 30rem)"
              class="home-logo-img"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <p class="eyebrow">Amazon Listing Optimization + Social Media Management</p>
          <h1 id="hero-heading" class="home-title">
            Amazon listings that <span class="marker">show the difference</span>. Social content worth following.
          </h1>
          <p class="home-lead">Images, A+ Content, video and copy for Amazon. Social media for ecommerce brands.</p>
          <div class="home-ctas flex flex-wrap items-center justify-center gap-3">
            <a href={bookHref} class="btn-primary">Talk to a Human</a>
            <a href="/our-work" class="btn-outline">See Our Work</a>
          </div>
        </div>
      </section>

      <div class="scene scene-b" data-scene-b data-no-split>
        <div class="scene-inner">
          <p class="eyebrow mb-4">Results, up front</p>
          <h2 id="results-heading" class="home-title-b">Creative you can see. Results you can examine.</h2>
        </div>
      </div>
    </div>
  </div>

  <!-- 02 — Results, up front (heading lives in scene B above): two big numbers straight on the surface, no boxes -->
  <section class="home-results" aria-labelledby="results-heading">
    <div class="container-x">
      <ul class="grid gap-10 text-brand-green md:grid-cols-2 md:gap-0">
        {results.map((r, i) => (
          <li class:list={['flex flex-col', i === 0 ? 'md:border-r md:border-brand-green/20 md:pr-12' : 'md:pl-12 md:pt-16']}>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-green/60">{r.label}</p>
            <p data-count class="mt-3 font-display text-[4rem] font-extrabold leading-[0.9] tracking-tight sm:text-8xl md:text-[8.5rem]">{r.stat}</p>
            <p class="mt-3 text-xl font-extrabold sm:text-2xl">{r.statLabel}</p>
            <p class="mt-1 text-sm font-semibold text-brand-green/60">{r.detail}</p>
            <a href={r.href} class="btn-dark mt-6 self-start">{r.cta}</a>
          </li>
        ))}
      </ul>
      <p class="mt-10 text-xs text-brand-ink/50">Individual results from different periods. Not a guarantee.</p>
    </div>
  </section>

  <!-- 03 — Two ways we help -->
  <section class="home-services py-12 md:py-24" aria-labelledby="services-heading" id="services">
    <!-- Exit of the results surface: the spotlight's enlarged lower tip, retreating as services scrolls in -->
    <svg class="spot-exit" data-spot-exit viewBox="0 0 1440 730" aria-hidden="true" focusable="false">
      <path d="M454 -1299.6A860 860 0 1 1 1851.6 -375.6L851.6 572A540 540 0 0 1 -26 -8Z"></path>
    </svg>
    <div class="container-x relative">
      <SectionHeading eyebrow="Two ways we help" id="services-heading" title="Two ways to grow your brand." align="left" />
      <!-- Two loose columns, the second set lower: a big number, the promise as the headline, one line, a link -->
      <ul class="grid gap-14 md:grid-cols-2 md:gap-16">
        {services.map((s, i) => (
          <li class:list={['relative', i === 1 && 'md:mt-28']}>
            <span class="step-num font-display text-5xl font-extrabold leading-none text-brand-orange sm:text-6xl" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <p class="relative mt-4 text-xs font-bold uppercase tracking-[0.18em] text-brand-green/60">{s.label}</p>
            <h3 class="relative mt-2 text-[1.75rem] font-extrabold leading-[1.1] text-brand-green sm:text-4xl">{s.title}</h3>
            <p class="relative mt-4 max-w-md text-brand-ink/65">{s.text}</p>
            <a href={s.href} class="btn-dark relative mt-6">{s.cta}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <TextMarquee words={['See the difference', 'Worth following', 'Look at why', 'Talk to a human']} />

  <!-- 04 — Testimonials (videos + photos; content lives in data/testimonials.ts) -->
  <section class="home-testimonials bg-brand-cream py-10" aria-labelledby="testimonials-heading" id="testimonials" data-no-deco>
    <div class="container-x">
      <SectionHeading
        eyebrow="Client testimonials"
        id="testimonials-heading"
        title="What our clients say."
        align="left"
      />
      <Testimonials testimonials={testimonials} />
    </div>
  </section>

  <TextMarquee dark reverse duration={40} words={['Ask the right question', 'Make it clear', 'Give a reason to return']} />

  <!-- 05 — Selected work: a selector. The centred case is a card (image + result + story); its neighbours show only
       their image. All cases are in the HTML (crawlable); scripts/home.ts only moves them. Initial positions are
       rendered here, so nothing shifts when the script takes over. -->
  <section class="home-work" aria-labelledby="work-heading">
    <Spotlight id="work-spot" class="home-work-spot" />
    <div class="container-x relative">
      <p class="eyebrow mb-3">Selected work</p>
      <h2 id="work-heading" class="text-2xl font-extrabold leading-tight sm:text-3xl md:text-[2.4rem]">
        Don’t just look at what we made. Look at the numbers.
      </h2>
    </div>

    <div class="wk" data-wk role="region" aria-roledescription="carousel" aria-label="Case studies">
      <ul class="wk-stage" data-wk-stage>
        {work.map((w, i) => {
          const o = slideOffset(i, 0, work.length);
          const pos = slidePos(o);
          return (
            <li
              class="wk-slide"
              data-wk-slide
              data-pos={pos}
              data-side={slideSide(o)}
              style={`--o:${o}`}
              aria-roledescription="slide"
              aria-label={`${i + 1} of ${work.length}: ${w.cat}`}
              aria-hidden={o === 0 ? undefined : 'true'}
            >
              <a href={w.href} class="wk-media" tabindex={o === 0 ? undefined : -1} aria-label={`${w.cat}: ${w.cta}`}>
                {w.image ? (
                  <Image
                    src={w.image.src}
                    alt={w.image.alt}
                    width={900}
                    widths={[360, 600, 900]}
                    sizes="(min-width: 1024px) 28rem, min(94vw, 34rem)"
                    class="wk-img wk-img--scroll"
                    style={`--scroll-dur:${Math.max(10, (w.image.src.height / w.image.src.width - 1) * 25).toFixed(1)}s`}
                  />
                ) : (
                  <div class="media-fallback wk-img">
                    <Spotlight id={`fb-${i}`} class="media-fallback-spot" />
                    <span>{w.cat}</span>
                  </div>
                )}
              </a>
              <div class="wk-panel" inert={o !== 0}>
                <p class="text-xs font-semibold uppercase tracking-wider text-brand-orange">{w.cat}</p>
                <h3 class="mt-2 text-xl font-extrabold leading-snug text-brand-green lg:text-2xl">{w.title}</h3>
                <div class="wk-result">
                  {w.before && (
                    <p class="wk-before">
                      <span class="sr-only">From </span>{w.before} <span aria-hidden="true">→</span><span class="sr-only"> to</span>
                    </p>
                  )}
                  <p>
                    <span class="wk-stat-value" data-wk-count={w.stat}>{w.stat}</span>
                    <span class="wk-stat-label">{w.statLabel}</span>
                  </p>
                  <p class="wk-stat-note">{w.detail}</p>
                </div>
                <p class="wk-text">{w.text}</p>
                <a href={w.href} class="wk-cta">{w.cta} →</a>
              </div>
            </li>
          );
        })}
      </ul>

      <div class="container-x">
        <div class="wk-foot">
          <div class="wk-nav">
            <button type="button" class="wk-arrow wk-arrow--prev" data-wk-prev aria-label="Previous case study"></button>
            <div class="wk-dots" role="group" aria-label="Choose a case study">
              {work.map((w, i) => (
                <button type="button" class="wk-dot" data-wk-dot aria-label={`Show ${w.cat}`} aria-current={i === 0 ? 'true' : undefined}></button>
              ))}
            </div>
            <button type="button" class="wk-arrow wk-arrow--next" data-wk-next aria-label="Next case study"></button>
          </div>
          <a href="/our-work" class="btn-outline wk-all">Explore All Case Studies</a>
        </div>
        <p class="wk-note">Individual results from different products, markets and periods. Not a guarantee.</p>
        <p class="sr-only" aria-live="polite" data-wk-status></p>
      </div>
    </div>
  </section>

  <!-- 06 — How we work: four steps along one line, big numbers, no boxes -->
  <section class="bg-brand-cream py-12 md:py-24" aria-labelledby="how-heading">
    <div class="container-x">
      <p class="eyebrow mb-4">How we work</p>
      <h2 id="how-heading" class="max-w-3xl text-[1.85rem] font-extrabold leading-tight text-brand-green sm:text-4xl md:text-5xl">
        From the right question to the <span class="marker">right creative.</span>
      </h2>
      <ol class="mt-10 grid gap-8 sm:grid-cols-2 md:mt-14 lg:grid-cols-4 lg:gap-6">
        {steps.map((s, i) => (
          <li class="border-t-2 border-dashed border-brand-green/20 pt-5">
            <span class="step-num font-display text-5xl font-extrabold text-brand-orange sm:text-6xl" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-3 text-xl font-extrabold text-brand-green">{s.t}</h3>
            <p class="mt-1 text-brand-ink/60">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 07 — Brand Diagnosis quiz (same section as the services page) -->
  <BrandDiagnosisSection />

  <!-- 08 — FAQ (no FAQPage markup: not needed for eligibility) -->
  <section class="py-12 md:py-24" aria-labelledby="faq-heading">
    <div class="container-x grid gap-8 md:grid-cols-[1fr_1.6fr] md:gap-12">
      <div>
        <p class="eyebrow mb-4">FAQ</p>
        <h2 id="faq-heading" class="text-[1.85rem] font-extrabold leading-tight text-brand-green sm:text-4xl">
          Good to know before we talk.
        </h2>
      </div>
      <div class="space-y-8">
        <FaqList faqs={faqs} variant="outline" />
        <AskAi />
      </div>
    </div>
  </section>

  <!-- 10 — Final CTA -->
  <CtaBanner
    title="Tell us what you’re working on."
    text="A launch, a listing that could explain more, or social that needs direction. Let’s talk."
    ctaLabel="Talk to a Human"
    ctaHref={bookHref}
    badge={false}
    prominent
  />
</Layout>

<script>
  import '../scripts/home';
</script>
