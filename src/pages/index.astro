---

import Layout from '../layouts/Layout.astro';
import PageHero from '../components/ui/PageHero.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import CtaBanner from '../components/ui/CtaBanner.astro';
import FaqList from '../components/ui/FaqList.astro';
import Badge from '../components/ui/Badge.astro';
import TextMarquee from '../components/ui/TextMarquee.astro';
import { getPost, postHref } from '../data/posts';
import type { Faq } from '../data/faqs';

const title = 'Share It Studio | Amazon Listing Optimization & Social Media Management';
const description =
  'Amazon listing images, A+ Content, video and copy that help shoppers understand your product, plus social media management for ecommerce brands. Talk to our team.';

const bookHref = '/book-a-call';

// 02 — two proof points. Individual project results in different reporting periods.
const results = [
  {
    label: 'Social Media | Organic Discovery',
    stat: '3M+',
    statLabel: 'organic views in 90 days',
    detail: '3,057,772 views · $0 in reported paid ad spend',
    text: 'A new Instagram account used audience-led content themes and a repeatable publishing approach. During its February 4–May 4, 2026 reporting window, it recorded more than three million views without reported paid promotion.',
    cta: 'Explore the 90-Day Social Case',
    href: '/case-studies', // TODO: dedicated case-study page
    tone: 'dark',
  },
  {
    label: 'Amazon | YUNGPRIME',
    stat: '+28.3%',
    statLabel: 'organic Amazon sales',
    detail: '$16,432 → $21,077 · May to June',
    text: 'A coordinated content transformation brought listing images, A+ Content, Brand Story, Storefront, video, and copy into a more consistent product story. The case study also documents this increase in reported monthly organic sales.',
    cta: 'See YUNGPRIME’s Transformation',
    href: '/case-studies/yungprime',
    tone: 'yellow',
  },
];

// 03 — the two services
const services = [
  {
    label: 'Social Media Management',
    title: 'Build an audience before you need the sale.',
    text: 'Your audience needs a reason to pay attention—and another reason to come back. We turn customer interests, brand knowledge, and product stories into content people want to spend time with. Our monthly plans bring together strategy and creative execution, with scripting, production, editing, and publishing according to the plan you choose.',
    note: 'For ecommerce brands, on Amazon or beyond.',
    cta: 'Explore Social Media Management',
    href: '/services/social-media-management',
  },
  {
    label: 'Amazon Listing Optimization',
    title: 'Your product might be better. Does your listing make that obvious?',
    text: 'Shoppers can’t ask your listing what they would ask a salesperson. We use product knowledge, buyer questions, reviews, and competitor research to decide what your images, infographics, A+ Content, Brand Story, videos, and copy should explain—and what deserves the most attention.',
    note: 'Need one deliverable? Start there. Need several assets working together? We’ll build a custom scope around your product, goals, and budget.',
    cta: 'Explore Amazon Listing Optimization',
    href: '/services/amazon-listing-optimization',
  },
];

// 04 — the questions behind the creative
const questions = [
  {
    q: 'Will this work for me?',
    a: 'Show the product in use, at the right scale, and in a context the buyer recognizes.',
  },
  {
    q: 'Why should I choose this one?',
    a: 'Make the benefits, materials, differences, and proof easier to understand.',
  },
  {
    q: 'Why should I follow this brand?',
    a: 'Create useful, recognizable content themes that give people a reason to watch again.',
  },
];

// 05 — selected work
const work = [
  {
    cat: 'Pink Miracle',
    title: 'Rethinking the creative for an established product',
    text: 'An established product can have strong market recognition and still leave value unexplained. Rather than treating new images as a cosmetic refresh, we explored alternative creative directions informed by shopper preferences and feedback.',
    cta: 'Explore the Before and After',
    href: '/case-studies/pink-miracle',
  },
  {
    cat: 'Super Ninja',
    title: 'One product category. Different markets. Different questions.',
    text: 'The same product benefit may need a different explanation in a different country. Local competitor research, reviews, and buying objections informed market-specific creative decisions.',
    cta: 'See the Market-Specific Work',
    href: '/case-studies/super-ninja',
  },
  {
    cat: 'Social Media',
    title: 'Creating reasons to come back',
    text: 'An organic content strategy built around audience interests and recurring themes gave a new account a clearer editorial direction than a feed made up only of product promotions.',
    cta: 'See the Social Content',
    href: '/portfolio/social-media',
  },
];

// 06 — how we work
const steps = [
  {
    t: 'Get clear on the goal',
    d: 'We align on your product, audience, existing content, priorities, and project scope. When research is part of the engagement, we dig into competitors, reviews, and buying questions.',
  },
  {
    t: 'Decide what matters',
    d: 'We identify which details need explaining, which benefits need proving, and what each piece of content needs to accomplish.',
  },
  {
    t: 'Bring it to life',
    d: 'Our team turns the direction into the right deliverables—Amazon images, A+ Content, copy, video, or recurring social content.',
  },
  {
    t: 'Review, deliver, and improve',
    d: 'We work through the agreed review and delivery process. For ongoing engagements, reporting and feedback can guide the next round of creative decisions.',
  },
];

// 07 — where we fit
const fits = [
  {
    t: 'Launching something new?',
    d: 'Help people understand the product, how it works, and why it deserves a closer look.',
    tone: 'bg-brand-yellow-soft text-brand-green',
  },
  {
    t: 'Already selling on Amazon?',
    d: 'Make the value clearer across the content shoppers use to compare and decide.',
    tone: 'bg-brand-cream text-brand-green',
  },
  {
    t: 'Building a stronger social presence?',
    d: 'Turn disconnected posting into a more intentional, consistently managed content plan.',
    tone: 'bg-brand-green text-white',
  },
];

// 08 — resources (existing guides; the card copy is new)
const resources = [
  {
    post: getPost('a-plus-content-templates'),
    title: 'A+ Content Templates',
    text: 'Explore ways to structure the content shoppers see below the product listing.',
    cta: 'Explore Templates',
  },
  {
    post: getPost('amazon-a-plus-content-examples'),
    title: 'Amazon A+ Content Examples',
    text: 'See how different brands communicate benefits through their A+ Content.',
    cta: 'See Examples',
  },
  {
    post: getPost('amazon-images-requirements'),
    title: 'Amazon Image Requirements',
    text: 'Understand the requirements behind Amazon product imagery before creating or updating your listing.',
    cta: 'Read the Guide',
  },
];

// 09 — FAQ
const faqs: Faq[] = [
  {
    q: 'Can I hire you for just A+ Content, listing images, or another Amazon deliverable?',
    a: 'Yes. Amazon creative services can be hired individually or combined into a custom project based on your priorities and budget.',
  },
  {
    q: 'Do you manage social media for brands that don’t sell on Amazon?',
    a: 'Yes. We work with ecommerce brands beyond Amazon. Deliverables, channels, and publishing cadence depend on the monthly plan.',
  },
  {
    q: 'How is pricing structured?',
    a: 'Amazon projects are quoted around the services and deliverables you need. Social Media Management is offered through monthly plans with different scopes.',
  },
  {
    q: 'Can you work alongside our existing marketing or PPC team?',
    a: 'We can coordinate creative direction with existing partners when it’s part of the project. Amazon advertising or account operations aren’t automatically included in listing creative work.',
  },
  {
    q: 'Is everything created with AI?',
    a: 'No. The production approach depends on the product and the agreed scope. It may involve real photography, video, existing brand assets, or AI-assisted techniques, with human creative direction and review.',
  },
  {
    q: 'How do you evaluate whether the content is working?',
    a: 'It depends on the engagement and the data available. Reach, engagement, and traffic can inform social media decisions; on Amazon, CTR, conversion, and sales can provide context. We look at the relevant signals without assuming every change was caused by creative alone.',
  },
];
---

<Layout title={title} description={description}>
  <!-- 01 — Hero -->
  <PageHero
    size="lg"
    eyebrow="Amazon Listing Optimization + Social Media Management"
    title="Amazon listings that show the difference. Social content worth following."
    highlight="show the difference"
    subtitle="We create Amazon listing images, A+ Content, video, and copy that help shoppers understand what makes your product worth choosing. We also plan, produce, and manage social media for ecommerce brands—whether they sell on Amazon or not."
    ctaLabel="Talk to a Human"
    ctaHref={bookHref}
    secondaryLabel="See Our Work"
    secondaryHref="/portfolio"
  >
    <p class="mt-4 text-sm text-brand-ink/60">Choose a time to speak directly with our team.</p>
    <!-- TODO: HERO-01 — replace placeholders with approved client work (D12) -->
    <div slot="visual" class="relative">
      <Badge id="hero-badge" class="absolute -bottom-8 -left-4 z-10 h-32 w-32 -rotate-12 text-brand-orange lg:-left-12" />
      <div class="grid grid-cols-[1.4fr_1fr] gap-3">
        <div class="relative grid aspect-[4/5] place-items-center overflow-hidden rounded-[2.5rem] bg-brand-green">
          <div class="absolute -left-10 -top-10 h-40 w-40 rounded-full bg-brand-green-light"></div>
          <p class="relative px-6 text-center text-sm text-white/60">Amazon listing project</p>
        </div>
        <div class="placeholder aspect-[9/16] self-end rounded-[2rem] bg-white">▶ Social video</div>
      </div>
    </div>
  </PageHero>

  <!-- 02 — Results, up front -->
  <section class="py-16 md:py-24" aria-labelledby="results-heading">
    <div class="container-x">
      <SectionHeading eyebrow="Results, up front" id="results-heading" title="Creative you can see. Results you can examine." />
      <ul class="grid gap-5 md:grid-cols-2">
        {results.map((r) => (
          <li class="flex">
            <article
              class:list={[
                'flex w-full flex-col rounded-[2rem] p-8 md:p-10',
                r.tone === 'dark' ? 'bg-brand-green text-white' : 'bg-brand-yellow text-brand-green',
              ]}
            >
              <p class="text-xs font-semibold uppercase tracking-[0.18em] opacity-70">{r.label}</p>
              <p data-count class="mt-6 font-display text-7xl font-extrabold leading-none md:text-8xl">{r.stat}</p>
              <p class="mt-2 text-2xl font-extrabold">{r.statLabel}</p>
              <p class:list={['mt-2 text-sm font-semibold', r.tone === 'dark' ? 'text-brand-yellow' : 'text-brand-green/70']}>
                {r.detail}
              </p>
              <p class:list={['mt-5 flex-1', r.tone === 'dark' ? 'text-white/75' : 'text-brand-green/80']}>{r.text}</p>
              <a href={r.href} class:list={['mt-7 self-start', r.tone === 'dark' ? 'btn-primary' : 'btn-dark']}>{r.cta}</a>
            </article>
          </li>
        ))}
      </ul>
      <p class="mt-5 text-xs text-brand-ink/50">
        Individual project results in different reporting periods. Performance can be influenced by factors beyond creative
        work.
      </p>
    </div>
  </section>

  <TextMarquee words={['See the difference', 'Worth following', 'Look at why', 'Talk to a human']} />

  <!-- 03 — Two ways we help -->
  <section class="py-16 md:py-24" aria-labelledby="services-heading" id="services">
    <div class="container-x">
      <SectionHeading
        eyebrow="Two ways we help"
        id="services-heading"
        title="Different needs. Creative built around the people you’re trying to reach."
      />
      <ul class="grid gap-5 md:grid-cols-2">
        {services.map((s) => (
          <li class="flex">
            <article class="flex w-full flex-col rounded-[2rem] bg-brand-cream p-8 md:p-10">
              <p class="eyebrow">{s.label}</p>
              <h3 class="mt-5 text-3xl font-extrabold leading-tight text-brand-green">{s.title}</h3>
              <p class="mt-4 text-brand-ink/70">{s.text}</p>
              <p class="mt-4 flex-1 text-sm font-semibold text-brand-green">{s.note}</p>
              <a href={s.href} class="btn-dark mt-7 self-start">{s.cta}</a>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 04 — The question behind the creative -->
  <section class="bg-brand-cream py-16 md:py-24" aria-labelledby="question-heading">
    <div class="container-x">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow mb-4">The question behind the creative</p>
        <h2 id="question-heading" class="text-4xl font-extrabold leading-tight text-brand-green md:text-5xl">
          What does your customer still need to see, know, or believe?
        </h2>
        <p class="scrub-text mt-6 text-lg text-brand-ink/70">
          Sometimes the most important product detail is missing from the images. Sometimes the difference between two
          competing products is hard to understand. And sometimes a brand keeps publishing without giving anyone a reason
          to return.
        </p>
      </div>
      <ul class="mt-12 grid gap-5 md:grid-cols-3">
        {questions.map((q) => (
          <li class="flex">
            <article class="flex w-full flex-col rounded-[2rem] bg-white p-8">
              <p class="font-display text-3xl font-extrabold leading-tight text-brand-green">“{q.q}”</p>
              <p class="mt-4 text-brand-ink/70">{q.a}</p>
            </article>
          </li>
        ))}
      </ul>
      <p class="mt-12 text-center font-display text-2xl font-extrabold text-brand-green">
        The question shapes the <span class="marker">creative</span>—not the other way around.
      </p>
    </div>
  </section>

  <TextMarquee dark reverse duration={40} words={['Ask the right question', 'Make it clear', 'Give a reason to return']} />

  <!-- 05 — Selected work -->
  <section class="py-16 md:py-24" aria-labelledby="work-heading">
    <div class="container-x">
      <SectionHeading eyebrow="Selected work" id="work-heading" title="Don’t just look at what we made. Look at why." />
      <ul class="grid gap-6 md:grid-cols-3">
        {work.map((w) => (
          <li class="flex">
            <a href={w.href} class="group flex w-full flex-col rounded-[2rem] bg-brand-cream p-3">
              <div class="placeholder aspect-[4/3] rounded-[1.6rem] bg-white">{w.cat}</div>
              <div class="flex flex-1 flex-col p-5">
                <p class="text-xs font-semibold uppercase tracking-wider text-brand-orange">{w.cat}</p>
                <h3 class="mt-2 text-2xl font-extrabold leading-snug text-brand-green">{w.title}</h3>
                <p class="mt-3 flex-1 text-sm text-brand-ink/70">{w.text}</p>
                <span class="mt-5 text-sm font-semibold text-brand-green">{w.cta} →</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
      <a href="/portfolio" class="btn-outline mt-10">Explore Our Work</a>
    </div>
  </section>

  <!-- 06 — How we work -->
  <section class="bg-brand-cream py-16 md:py-24" aria-labelledby="how-heading">
    <div class="container-x grid gap-12 md:grid-cols-2">
      <div class="md:sticky md:top-28 md:self-start">
        <p class="eyebrow mb-4">How we work</p>
        <h2 id="how-heading" class="text-4xl font-extrabold leading-tight text-brand-green md:text-5xl">
          From the right question to the <span class="marker">right creative.</span>
        </h2>
        <p class="scrub-text mt-5 text-lg text-brand-ink/65">
          You know what we’re creating, why it belongs in the project, and what to expect from the agreed scope.
        </p>
      </div>
      <ol class="stack-cards space-y-4">
        {steps.map((s, i) => (
          <li class="flex gap-5 rounded-[1.75rem] bg-white p-6 md:min-h-[11rem]" style={`--i:${i}`}>
            <span class="step-num font-display text-4xl font-extrabold text-brand-yellow" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="text-xl font-extrabold text-brand-green">{s.t}</h3>
              <p class="mt-1 text-brand-ink/65">{s.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 07 — Where we fit -->
  <section class="py-16 md:py-24" aria-labelledby="fit-heading">
    <div class="container-x">
      <SectionHeading eyebrow="Where we fit" id="fit-heading" title="Start with what your brand actually needs." />
      <ul class="grid gap-5 md:grid-cols-3">
        {fits.map((f) => (
          <li class="flex">
            <article class:list={['flex w-full flex-col rounded-[2rem] p-8', f.tone]}>
              <h3 class="text-2xl font-extrabold leading-snug">{f.t}</h3>
              <p class="mt-3 opacity-80">{f.d}</p>
            </article>
          </li>
        ))}
      </ul>
      <p class="mt-8 max-w-3xl text-brand-ink/70">
        Amazon services are available individually or in custom combinations. Social Media Management runs through monthly
        plans. If your brand needs both, we can connect the creative direction across touchpoints—but neither service
        requires the other.
      </p>
    </div>
  </section>

  <!-- 08 — Resources -->
  <section class="bg-brand-cream py-16 md:py-24" aria-labelledby="resources-heading">
    <div class="container-x">
      <SectionHeading
        eyebrow="Resources"
        id="resources-heading"
        title="Useful answers, whether or not we’re working together yet."
      />
      <ul class="grid gap-6 md:grid-cols-3">
        {resources.map((r) => (
          <li class="flex">
            <a
              href={postHref(r.post)}
              class="group flex w-full flex-col rounded-[2rem] bg-white p-3 transition hover:bg-brand-yellow-soft"
            >
              <div class="placeholder aspect-[16/10] rounded-[1.6rem] bg-brand-cream">Article image</div>
              <div class="flex flex-1 flex-col p-4">
                <h3 class="mt-2 text-xl font-extrabold leading-snug text-brand-green">{r.title}</h3>
                <p class="mt-2 flex-1 text-sm text-brand-ink/65">{r.text}</p>
                <span class="mt-5 text-sm font-semibold text-brand-green">{r.cta} →</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
      <a href="/blog" class="btn-outline mt-8">Explore All Resources</a>
    </div>
  </section>

  <!-- 09 — FAQ (no FAQPage markup: not needed for eligibility) -->
  <section class="py-16 md:py-24" aria-labelledby="faq-heading">
    <div class="container-x grid gap-12 md:grid-cols-[1fr_1.6fr]">
      <div>
        <p class="eyebrow mb-4">FAQ</p>
        <h2 id="faq-heading" class="text-4xl font-extrabold leading-tight text-brand-green">
          A few things worth knowing before we talk.
        </h2>
      </div>
      <FaqList faqs={faqs} variant="cream" />
    </div>
  </section>

  <!-- 10 — Final CTA -->
  <CtaBanner
    title="Tell us what you’re working on."
    text="A product launch. An Amazon listing that could explain more. A social presence ready for a clearer direction. Whatever your starting point, let’s talk through the creative work that makes sense for your brand."
    ctaLabel="Talk to a Human"
    ctaHref={bookHref}
    note="Choose a time to speak directly with our team."
  />
</Layout>
