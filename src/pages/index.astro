---
import Welcome from '../components/Welcome.astro';
import Layout from '../layouts/Layout.astro';

	const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "Organization",
	"@id": "https://shareitstudio.com/#organization",
	"name": "Share It Studio",
	"url": "https://shareitstudio.com",
	//"logo": "https://shareitstudio.com/logo.png",
	"sameAs": [
		"https://twitter.com/shareitstudio",
		"https://github.com/shareitstudio",
		"https://linkedin.com/company/shareitstudio"
	],
	};

	const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"@id": "https://shareitstudio.com/#website",
	"name": "Share It Studio",
	"url": "https://shareitstudio.com",
	"publisher": {
		"@id": "https://shareitstudio.com/#organization"  
		}
	};

const combinedSchema = [organizationSchema, websiteSchema];
---

<Layout schema={combinedSchema}>
	<Welcome />
</Layout>
