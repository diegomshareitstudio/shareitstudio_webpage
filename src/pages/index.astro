---
/**
Prototype 2.
 */
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import CtaBanner from '../components/ui/CtaBanner.astro';
import FaqList from '../components/ui/FaqList.astro';
import AskAi from '../components/ui/AskAi.astro';
import BrandDiagnosisSection from '../components/forms/BrandDiagnosisSection.astro';
import Spotlight from '../components/ui/Spotlight.astro';
import '../styles/selector.css';
import '../styles/home.css';
import { slideOffset, slidePos, slideSide } from '../lib/selector';
import { Image, getImage } from 'astro:assets';
import superNinjaHero from '../assets/case-studies/super-ninja/Fruit Flies (US) Hero Image_2.png';
import paper2eatHero from '../assets/case-studies/paper2eat/Paper2Eat Hero Image_4.jpg';
import huggleHealersFrame from '../assets/case-studies/huggle-healers/frames/frame-02.jpg';
import greatnessNowHero from '../assets/case-studies/greatness-now/Hero Image - Ring Toss Hook Game_01.jpg';
// The logo's letters without its spotlight (made from brand/share-it-studio-logo.png); the spotlight is Spotlight.astro
import wordmark from '../assets/brand/share-it-studio-wordmark.png';
import yungprimeHero from '../assets/case-studies/yungprime/YungPrime Black Slip-Resistant Work Shoes Hero Image_1 (1).jpg';
import pinkMiracleHero from '../assets/case-studies/pink-miracle/Pink Miracle Hero Image_2_1.jpg';
import TextMarquee from '../components/ui/TextMarquee.astro';
import Testimonials from '../components/ui/Testimonials.astro';
import { testimonials } from '../data/testimonials';
import { testimonialVideoSchema, type Schema } from '../lib/schema';
import type { Faq } from '../data/faqs';
import { BOOKING_PAGE } from '../config/site';
import { withBase } from '../lib/url';

const title = 'Share It Studio | Amazon Listing Optimization & Social Media Management';
const description =
  'Amazon listing images, A+ Content, video and copy that help shoppers understand your product, plus social media management for ecommerce brands. Talk to our team.';

// 02 — proof points. Individual project results in different reporting periods.
const results = [
  {
    label: 'Amazon | YUNGPRIME',
    stat: '+28.3%',
    statLabel: 'organic Amazon sales',
    detail: '$16,432 → $21,077 · May to June',
    text: 'A coordinated content transformation brought listing images, A+ Content, Brand Story, Storefront, video, and copy into a more consistent product story. The case study also documents this increase in reported monthly organic sales.',
    cta: 'See YUNGPRIME’s Transformation',
    href: '/case-studies/yungprime',
  },
  {
    label: 'Amazon | Super Ninja',
    stat: '+716.9%',
    statLabel: 'reported product sales — US',
    detail: 'April → August 2025 · +310.5% UK · +91.5% Germany · Source-reported figures',
    text: 'Fruit fly trap listings adapted to what buyers ask in each market, with 15+ main-image concepts and 10+ A/B tests across Germany, the UK and the US.',
    cta: 'See the Super Ninja Case',
    href: '/case-studies/super-ninja',
  },
];

// 03 — the two services
const services = [
  {
    label: 'Social Media Management',
    title: 'Build an audience before you need the sale.',
    text: 'Your audience needs a reason to pay attention—and another reason to come back. We turn customer interests, brand knowledge, and product stories into content people want to spend time with. Our monthly plans bring together strategy and creative execution, with scripting, production, editing, and publishing according to the plan you choose.',
    note: 'For ecommerce brands, on Amazon or beyond.',
    cta: 'Explore Social Media Management',
    href: '/services/social-media-management',
  },
  {
    label: 'Amazon Listing Optimization',
    title: 'Your product might be better. Does your listing make that obvious?',
    text: 'Shoppers can’t ask your listing what they would ask a salesperson. We use product knowledge, buyer questions, reviews, and competitor research to decide what your images, infographics, A+ Content, Brand Story, videos, and copy should explain—and what deserves the most attention.',
    note: 'Need one deliverable? Start there. Need several assets working together? We’ll build a custom scope around your product, goals, and budget.',
    cta: 'Explore Amazon Listing Optimization',
    href: '/services/amazon-listing-optimization',
  },
];

// 04 — testimonials: VideoObject markup for each published video (placeholders are skipped)
const videoSchema: Schema[] = [];
for (const [i, t] of testimonials.entries()) {
  if (t.type !== 'video' || !t.video || t.placeholder) continue;
  const thumb = await getImage({ src: t.video.poster, width: 1280, format: 'jpg' });
  videoSchema.push(testimonialVideoSchema('/', i, t, { ...t.video, thumbnail: thumb.src }));
}

// 05 — selected work: image, title, the result (as prominent as the title), then the story.
// `before` renders as the starting point of `stat`.
const work = [
  {
    cat: 'Amazon | YUNGPRIME',
    title: 'One buying story across every listing touchpoint',
    stat: '+28.3%',
    statLabel: 'organic Amazon sales',
    detail: '$16,432 → $21,077 · May → June 2026 · Amazon US · Total sales +14.1% as reported',
    text: 'Images, A+ Content, Brand Story, Storefront, video and copy telling one clear buying story.',
    cta: 'See YUNGPRIME’s Transformation',
    href: '/case-studies/yungprime',
    image: { src: yungprimeHero, alt: 'YUNGPRIME black slip-resistant work shoes main listing image' },
  },
  {
    cat: 'Amazon | Paper2eat',
    title: 'From separate assets to one recognizable Amazon experience',
    before: '$184K',
    stat: '$231K',
    statLabel: 'in monthly Amazon sales',
    detail: '+25.3% · January → June 2026 · $1.33M in total sales · Observed account results',
    text: 'Listing images, A+ Content, video, Storefront and Spanish-language assets connected into one shopping experience.',
    cta: 'See the Paper2eat Case',
    href: '/case-studies/paper2eat',
    image: { src: paper2eatHero, alt: 'Paper2eat edible frosting sheets main listing image' },
  },
  {
    cat: 'Amazon | Pink Miracle',
    title: 'Rethinking the creative for an established product',
    before: '$404K',
    stat: '$849K',
    statLabel: 'in reported monthly sales',
    detail: '+109.98% · July 2024 → January 2025 · +49.94% in the first month · Observed account results',
    text: 'New creative, tested against customer preferences, for a product that was already selling.',
    cta: 'Explore Pink Miracle’s Before and After',
    href: '/case-studies/pink-miracle',
    image: { src: pinkMiracleHero, alt: 'Pink Miracle shoe cleaner main listing image' },
  },
  {
    cat: 'Amazon | Super Ninja',
    title: 'One product category. Different markets. Different questions.',
    stat: '+716.9%',
    statLabel: 'reported product sales — US',
    detail:
      '+310.5% UK · +91.5% Germany · US April → August 2025, UK and Germany August 2024 → August 2025 · Source-reported figures',
    text: 'Imagery and explanations adapted to what buyers ask in Germany, the UK and the US.',
    cta: 'See the Market-Specific Case',
    href: '/case-studies/super-ninja',
    image: { src: superNinjaHero, alt: 'Super Ninja fruit fly trap main image for the US Amazon listing' },
  },
  {
    cat: 'Amazon | Greatness Now',
    title: 'Showing how a party game is played, not just what it looks like',
    before: '$238',
    stat: '$5,948',
    statLabel: 'reported product sales',
    detail:
      '+2,400% · Feb–Mar vs. Apr–May 2024 · One ASIN · Unit Session Percentage 0.79% → 7.85% · Ad spend also rose',
    text: 'Listing images redesigned around how the ring toss game is played, assembled and shared.',
    cta: 'See the Greatness Now Redesign',
    href: '/case-studies/greatness-now',
    image: { src: greatnessNowHero, alt: 'Greatness Now Ring Toss Hook Game main listing image' },
  },
  {
    cat: 'Amazon | Huggle Healers',
    title: 'Making a hug visible on a TV screen',
    stat: '117,606',
    statLabel: 'completed views of a 15-second TV ad',
    detail:
      'First two weeks · 3 Sponsored TV campaigns · 118,131 viewable impressions · 99.6% completions per viewable impression · Viewing metrics, not sales',
    text: 'Real buyer questions about a weighted plush turned into one memorable commercial with a QR path back to Amazon.',
    cta: 'Watch the Huggle Healers Case',
    href: '/case-studies/huggle-healers',
    image: { src: huggleHealersFrame, alt: 'A child hugging a Huggle Healers weighted plush' },
  },
] as {
  cat: string;
  title: string;
  before?: string;
  stat: string;
  statLabel: string;
  detail: string;
  text: string;
  cta: string;
  href: string;
  image?: { src: ImageMetadata; alt: string };
}[];

// 06 — how we work
const steps = [
  {
    t: 'Get clear on the goal',
    d: 'We align on your product, audience, existing content, priorities, and project scope. When research is part of the engagement, we dig into competitors, reviews, and buying questions.',
  },
  {
    t: 'Decide what matters',
    d: 'We identify which details need explaining, which benefits need proving, and what each piece of content needs to accomplish.',
  },
  {
    t: 'Bring it to life',
    d: 'Our team turns the direction into the right deliverables—Amazon images, A+ Content, copy, video, or recurring social content.',
  },
  {
    t: 'Review, deliver, and improve',
    d: 'We work through the agreed review and delivery process. For ongoing engagements, reporting and feedback can guide the next round of creative decisions.',
  },
];

// 08 — FAQ
const faqs: Faq[] = [
  {
    q: 'Can I hire you for just A+ Content, listing images, or another Amazon deliverable?',
    a: 'Yes. Amazon creative services can be hired individually or combined into a custom project based on your priorities and budget.',
  },
  {
    q: 'Do you manage social media for brands that don’t sell on Amazon?',
    a: 'Yes. We work with ecommerce brands beyond Amazon. Deliverables, channels, and publishing cadence depend on the monthly plan.',
  },
  {
    q: 'How is pricing structured?',
    a: 'Amazon projects are quoted around the services and deliverables you need. Social Media Management is offered through monthly plans with different scopes.',
  },
  {
    q: 'Can you work alongside our existing marketing or PPC team?',
    a: 'We can coordinate creative direction with existing partners when it’s part of the project. Amazon advertising or account operations aren’t automatically included in listing creative work.',
  },
  {
    q: 'Is everything created with AI?',
    a: 'No. The production approach depends on the product and the agreed scope. It may involve real photography, video, existing brand assets, or AI-assisted techniques, with human creative direction and review.',
  },
  {
    q: 'How do you evaluate whether the content is working?',
    a: 'It depends on the engagement and the data available. Reach, engagement, and traffic can inform social media decisions; on Amazon, CTR, conversion, and sales can provide context. We look at the relevant signals without assuming every change was caused by creative alone.',
  },
];
---

<Layout title={title} description={description} schema={videoSchema}>
  <!-- Pick the pinned hero layout before the first paint, so it never swaps in later (CLS). Mirrors the checks in
       scripts/home.ts, which has the final word: reduced motion and very short viewports keep the stacked layout. -->
  <script is:inline>
    if (innerHeight >= 480) document.documentElement.classList.add('home-ready');
  </script>
  <!-- 01 — Hero (scene A) + the heading of 02 (scene B). Pinned briefly on desktop/mobile while the spotlight expands. -->
  <div class="home-intro" data-home-intro>
    <div class="home-stage" data-stage>
      <div class="home-atmos" aria-hidden="true">
        <span></span>
        <span></span>
      </div>
      <Spotlight id="hero-spot" class="home-spot" />

      <section class="scene scene-a" data-scene-a aria-labelledby="hero-heading">
        <div class="scene-inner">
          <!-- The logo's letters over its own spotlight; on scroll scripts/home.ts swaps in the big spotlight at the
               same spot and grows it until it fills the screen -->
          <div class="home-logo" data-spot-logo>
            <Spotlight id="logo-spot" class="home-logo-spot" />
            <Image
              src={wordmark}
              alt="Share It Studio"
              widths={[480, 800, 1200]}
              sizes="min(80vw, 30rem)"
              class="home-logo-img"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <p class="eyebrow">Amazon Listing Optimization + Social Media Management</p>
          <h1 id="hero-heading" class="home-title">
            Amazon listings that <span class="marker">show the difference</span>. Social content worth following.
          </h1>
          <p class="home-lead">
            We create Amazon listing images, A+ Content, video, and copy that help shoppers understand what makes your
            product worth choosing. We also plan, produce, and manage social media for ecommerce brands—whether they
            sell on Amazon or not.
          </p>
          <div class="home-ctas flex flex-wrap items-center justify-center gap-3">
            <a href={withBase(BOOKING_PAGE)} class="btn-primary">
              Talk to a Human
            </a>
            <a href={withBase('/our-work')} class="btn-outline">
              See Our Work
            </a>
          </div>
          <p class="mt-4 text-sm text-brand-ink/60">Choose a time to speak directly with our team.</p>
        </div>
      </section>

      <div class="scene scene-b" data-scene-b data-no-split>
        <div class="scene-inner">
          <p class="eyebrow mb-4">Results, up front</p>
          <h2 id="results-heading" class="home-title-b">
            Creative you can see. Results you can examine.
          </h2>
        </div>
      </div>
    </div>
  </div>

  <!-- 02 — Results, up front (heading lives in scene B above): two big numbers straight on the surface, no boxes -->
  <section class="home-results" aria-labelledby="results-heading">
    <div class="container-x">
      <ul class:list={['grid gap-10 text-brand-green', results.length > 1 && 'md:grid-cols-2 md:gap-0']}>
        {results.map((r, i) => (
          <li
            class:list={[
              'flex flex-col',
              results.length > 1 && (i === 0 ? 'md:border-r md:border-brand-green/20 md:pr-12' : 'md:pl-12 md:pt-16'),
            ]}
          >
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-green/60">{r.label}</p>
            <p
              data-count
              class="mt-3 font-display text-[4rem] font-extrabold leading-[0.9] tracking-tight sm:text-8xl md:text-[8.5rem]"
            >
              {r.stat}
            </p>
            <p class="mt-3 text-xl font-extrabold sm:text-2xl">{r.statLabel}</p>
            <p class="mt-1 text-sm font-semibold text-brand-green/60">{r.detail}</p>
            <p class="mt-5 max-w-md text-brand-ink/70">{r.text}</p>
            <a href={withBase(r.href)} class="btn-dark mt-6 self-start">
              {r.cta}
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-10 text-xs text-brand-ink/50">
        Individual project results in different reporting periods. Performance can be influenced by factors beyond
        creative work.
      </p>
    </div>
  </section>

  <!-- 03 — Two ways we help -->
  <section class="home-services py-12 md:py-24" aria-labelledby="services-heading" id="services">
    <!-- Exit of the results surface: the spotlight's enlarged lower tip, retreating as services scrolls in -->
    <svg class="spot-exit" data-spot-exit viewBox="0 0 1440 730" aria-hidden="true" focusable="false">
      <path d="M454 -1299.6A860 860 0 1 1 1851.6 -375.6L851.6 572A540 540 0 0 1 -26 -8Z"></path>
    </svg>
    <div class="container-x relative">
      <SectionHeading
        eyebrow="Two ways we help"
        id="services-heading"
        title="Different needs. Creative built around the people you’re trying to reach."
        align="left"
      />
      <!-- Two loose columns, the second set lower: a big number, the promise as the headline, one line, a link -->
      <ul class="grid gap-14 md:grid-cols-2 md:gap-16">
        {services.map((s, i) => (
          <li class:list={['relative', i === 1 && 'md:mt-28']}>
            <span
              class="step-num font-display text-5xl font-extrabold leading-none text-brand-orange sm:text-6xl"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            <p class="relative mt-4 text-xs font-bold uppercase tracking-[0.18em] text-brand-green/60">{s.label}</p>
            <h3 class="relative mt-2 text-[1.75rem] font-extrabold leading-[1.1] text-brand-green sm:text-4xl">
              {s.title}
            </h3>
            <p class="relative mt-4 max-w-md text-brand-ink/65">{s.text}</p>
            <p class="relative mt-3 max-w-md text-sm font-semibold text-brand-green">{s.note}</p>
            <a href={withBase(s.href)} class="btn-dark relative mt-6">
              {s.cta}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <TextMarquee words={['See the difference', 'Worth following', 'Look at why', 'Talk to a human']} />

  <!-- 04 — Testimonials (videos + photos; content lives in data/testimonials.ts) -->
  <section
    class="home-testimonials bg-brand-cream py-10"
    aria-labelledby="testimonials-heading"
    id="testimonials"
    data-no-deco
  >
    <div class="container-x">
      <SectionHeading
        eyebrow="Client testimonials"
        id="testimonials-heading"
        title="What ecommerce brands say about working with us."
        align="left"
      />
      <Testimonials testimonials={testimonials} />
    </div>
  </section>

  <TextMarquee
    dark
    reverse
    duration={40}
    words={['Ask the right question', 'Make it clear', 'Give a reason to return']}
  />

  <!-- 05 — Selected work: a selector. The centred case is a card (image + result + story); its neighbours show only
       their image. All cases are in the HTML (crawlable); scripts/home.ts only moves them. Initial positions are
       rendered here, so nothing shifts when the script takes over. -->
  <section class="home-work" aria-labelledby="work-heading">
    <Spotlight id="work-spot" class="home-work-spot" />
    <div class="container-x relative">
      <p class="eyebrow mb-3">Selected work</p>
      <h2 id="work-heading" class="text-2xl font-extrabold leading-tight sm:text-3xl md:text-[2.4rem]">
        Don’t just look at what we made. Look at the numbers.
      </h2>
    </div>

    <div class="wk" data-wk role="region" aria-roledescription="carousel" aria-label="Case studies">
      <ul class="wk-stage" data-wk-stage>
        {work.map((w, i) => {
          const o = slideOffset(i, 0, work.length);
          const pos = slidePos(o);
          return (
            <li
              class="wk-slide"
              data-wk-slide
              data-pos={pos}
              data-side={slideSide(o)}
              style={`--o:${o}`}
              aria-roledescription="slide"
              aria-label={`${i + 1} of ${work.length}: ${w.cat}`}
              aria-hidden={o === 0 ? undefined : 'true'}
            >
              <a
                href={withBase(w.href)}
                class="wk-media"
                tabindex={o === 0 ? undefined : -1}
                aria-label={`${w.cat}: ${w.cta}`}
              >
                {w.image ? (
                  <Image
                    src={w.image.src}
                    alt={w.image.alt}
                    width={900}
                    widths={[360, 600, 900]}
                    sizes="(min-width: 1024px) 28rem, min(94vw, 34rem)"
                    class="wk-img wk-img--scroll"
                    style={`--scroll-dur:${Math.max(10, (w.image.src.height / w.image.src.width - 1) * 25).toFixed(1)}s`}
                  />
                ) : (
                  <div class="media-fallback wk-img">
                    <Spotlight id={`fb-${i}`} class="media-fallback-spot" />
                    <span>{w.cat}</span>
                  </div>
                )}
              </a>
              <div class="wk-panel" inert={o !== 0}>
                <p class="text-xs font-semibold uppercase tracking-wider text-brand-orange">{w.cat}</p>
                <h3 class="mt-2 text-xl font-extrabold leading-snug text-brand-green lg:text-2xl">{w.title}</h3>
                <div class="wk-result">
                  {w.before && (
                    <p class="wk-before">
                      <span class="sr-only">From </span>
                      {w.before} <span aria-hidden="true">→</span>
                      <span class="sr-only"> to</span>
                    </p>
                  )}
                  <p>
                    <span class="wk-stat-value" data-wk-count={w.stat}>
                      {w.stat}
                    </span>
                    <span class="wk-stat-label">{w.statLabel}</span>
                  </p>
                  <p class="wk-stat-note">{w.detail}</p>
                </div>
                <p class="wk-text">{w.text}</p>
                <a href={withBase(w.href)} class="wk-cta">
                  {w.cta} →
                </a>
              </div>
            </li>
          );
        })}
      </ul>

      <div class="container-x">
        <div class="wk-foot">
          <div class="wk-nav">
            <button
              type="button"
              class="wk-arrow wk-arrow--prev"
              data-wk-prev
              aria-label="Previous case study"
            ></button>
            <div class="wk-dots" role="group" aria-label="Choose a case study">
              {work.map((w, i) => (
                <button
                  type="button"
                  class="wk-dot"
                  data-wk-dot
                  aria-label={`Show ${w.cat}`}
                  aria-current={i === 0 ? 'true' : undefined}
                ></button>
              ))}
            </div>
            <button type="button" class="wk-arrow wk-arrow--next" data-wk-next aria-label="Next case study"></button>
          </div>
          <a href={withBase('/our-work')} class="btn-outline wk-all">
            Explore All Case Studies
          </a>
        </div>
        <p class="wk-note">Individual results from different products, markets and periods. Not a guarantee.</p>
        <p class="sr-only" aria-live="polite" data-wk-status></p>
      </div>
    </div>
  </section>

  <!-- 06 — How we work: four steps along one line, big numbers, no boxes -->
  <section class="bg-brand-cream py-12 md:py-24" aria-labelledby="how-heading">
    <div class="container-x">
      <p class="eyebrow mb-4">How we work</p>
      <h2
        id="how-heading"
        class="max-w-3xl text-[1.85rem] font-extrabold leading-tight text-brand-green sm:text-4xl md:text-5xl"
      >
        From the right question to the <span class="marker">right creative.</span>
      </h2>
      <p class="scrub-text mt-5 max-w-2xl text-lg text-brand-ink/65">
        You know what we’re creating, why it belongs in the project, and what to expect from the agreed scope.
      </p>
      <ol class="mt-10 grid gap-8 sm:grid-cols-2 md:mt-14 lg:grid-cols-4 lg:gap-6">
        {steps.map((s, i) => (
          <li class="border-t-2 border-dashed border-brand-green/20 pt-5">
            <span
              class="step-num font-display text-5xl font-extrabold text-brand-orange sm:text-6xl"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-3 text-xl font-extrabold text-brand-green">{s.t}</h3>
            <p class="mt-1 text-brand-ink/60">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 07 — Brand Diagnosis quiz (same section as the services page) -->
  <BrandDiagnosisSection />

  <!-- 08 — FAQ (no FAQPage markup: not needed for eligibility) -->
  <section class="py-12 md:py-24" aria-labelledby="faq-heading">
    <div class="container-x grid gap-8 md:grid-cols-[1fr_1.6fr] md:gap-12">
      <div>
        <p class="eyebrow mb-4">FAQ</p>
        <h2 id="faq-heading" class="text-[1.85rem] font-extrabold leading-tight text-brand-green sm:text-4xl">
          A few things worth knowing before we talk.
        </h2>
      </div>
      <div class="space-y-8">
        <FaqList faqs={faqs} variant="outline" />
        <AskAi />
      </div>
    </div>
  </section>

  <!-- 09 — Final CTA -->
  <CtaBanner
    title="Tell us what you’re working on."
    text="A product launch. An Amazon listing that could explain more. A social presence ready for a clearer direction. Whatever your starting point, let’s talk through the creative work that makes sense for your brand."
    note="Choose a time to speak directly with our team."
    ctaLabel="Talk to a Human"
    ctaHref={BOOKING_PAGE}
    badge={false}
    prominent
  />
</Layout>

<script>
  import '../scripts/home';
</script>
