---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';

const deliverables = [
  { title: 'Listing Images', text: 'Hero image, infographics and lifestyles — a 7–9 image sequence planned as one sales argument.', href: '/portfolio/listing-images/hero-images' },
  { title: 'A+ Content', text: 'Standard and Premium A+ modules that tell your product story below the fold.', href: '/portfolio/a-content' },
  { title: 'Copywriting', text: 'SEO titles, bullet points, descriptions and backend keywords written for humans and the algorithm.', href: '/contact' },
  { title: 'Listing Videos', text: 'Short demos that show size, quality and use in seconds.', href: '/portfolio/videos/listing-videos' },
  { title: 'Brand Story', text: 'A catalog-wide carousel that introduces your brand and cross-sells.', href: '/portfolio/brand-story' },
  { title: 'Storefront', text: 'A branded multi-page shop with zero competitor ads.', href: '/portfolio/storefront' },
];

const faqs = [
  { q: 'How long does a listing optimization take?', a: 'Most projects take 2–3 weeks from kickoff to final files, depending on photography needs.' },
  { q: 'Do you need my product?', a: 'For photography, yes. For 3D renders and infographics we can often work from your existing assets.' },
  { q: 'Will you upload the content for me?', a: 'Yes — we can upload images and A+ Content directly to Seller Central with your permission.' },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Amazon Listing Optimization',
  provider: { '@id': 'https://shareitstudio.com/#organization' },
  areaServed: 'Worldwide',
  description: 'Data-driven listing images, A+ Content, videos and copywriting for Amazon sellers.',
};
---

<Layout title="Listing Optimization Services | Share It Studio" description="Data-driven Amazon listing optimization: images, A+ Content, videos and SEO copy designed to increase conversion." schema={serviceSchema}>
  <PageHero
    eyebrow="Services"
    title="Listing Optimization Services"
    subtitle="Strategic visual content for sellers."
    ctaLabel="Get a Free Listing Audit"
    ctaHref="/call"
  >
    <div class="mx-auto mt-14 grid max-w-4xl grid-cols-[1fr_3fr] items-end gap-4">
      <div class="placeholder aspect-[9/16] border-white/20 bg-white/5 text-white/50">Mobile mockup</div>
      <div class="placeholder aspect-[16/10] border-white/20 bg-white/5 text-white/50">Desktop listing mockup</div>
    </div>
  </PageHero>

  <section class="container-x grid items-center gap-12 py-16 md:grid-cols-2 md:py-24">
    <div>
      <p class="eyebrow mb-3">The problem</p>
      <h2 class="text-3xl font-bold leading-tight text-brand-green md:text-4xl">Traffic without conversion is just expensive</h2>
      <p class="mt-5 text-lg text-brand-ink/75">
        You can pour money into PPC, but if your images don’t answer shoppers’ questions, they’ll bounce to a competitor. We rebuild your listing around what buyers actually look for — based on review mining, competitor analysis and your sales data.
      </p>
      <ul class="mt-6 space-y-3">
        {['Competitor & review research', 'Buyer persona definition', 'Image-by-image content plan', 'Before/after performance tracking'].map((i) => (
          <li class="flex items-center gap-3"><span class="flex h-6 w-6 items-center justify-center rounded-full bg-brand-yellow text-xs font-bold text-brand-green">✓</span>{i}</li>
        ))}
      </ul>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div class="placeholder aspect-square">Before</div>
      <div class="placeholder aspect-square border-brand-yellow bg-brand-yellow-soft text-brand-green">After</div>
    </div>
  </section>

  <section class="bg-brand-cream py-16 md:py-20">
    <div class="container-x">
      <SectionHeading eyebrow="What’s included" title="Every piece of your listing, working together" />
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {deliverables.map((d) => (
          <a href={d.href} class="rounded-2xl bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
            <h3 class="text-xl font-bold text-brand-green">{d.title}</h3>
            <p class="mt-2 text-brand-ink/70">{d.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="container-x max-w-3xl py-16 md:py-20">
    <SectionHeading eyebrow="FAQ" title="Common questions" />
    <div class="space-y-3">
      {faqs.map((f) => (
        <details class="group rounded-xl border border-black/10 p-5 open:bg-brand-cream">
          <summary class="flex cursor-pointer list-none items-center justify-between font-bold text-brand-green">
            {f.q}<span class="transition group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 text-brand-ink/75">{f.a}</p>
        </details>
      ))}
    </div>
    <p class="mt-6 text-center text-sm"><a href="/faq" class="font-bold text-brand-orange hover:underline">See all FAQs →</a></p>
  </section>

  <CtaBanner title="Find out what’s holding your listing back" text="Get a free audit of your images, A+ Content and copy on a 30-minute call." ctaLabel="Book My Free Audit" />
</Layout>
