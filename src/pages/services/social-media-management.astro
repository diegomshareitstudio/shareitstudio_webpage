---
/**
 * Social Media Management (copy V2): P1 commercial landing page for "ecommerce social media agency".
 * Hero → Problems → What we manage (+ portfolio) → Monthly plans (cards, comparison, sample week) → Purpose
 * → Questions → Final CTA. Pricing, scope and buyer questions live here, not on /services or the homepage.
 */
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';
import PackageCards from '../../components/packages/PackageCards.astro';
import PackageComparison from '../../components/packages/PackageComparison.astro';
import PostingSchedule from '../../components/packages/PostingSchedule.astro';
import FaqList from '../../components/ui/FaqList.astro';
import type { Faq } from '../../data/faqs';
import { socialPackages } from '../../data/socialPackages';
import { faqSchema, serviceSchema } from '../../lib/schema';

const path = '/services/social-media-management';
const bookHref = '/book-a-call'; // TODO: verified Calendly appointment URL

// 02 — the problems we help solve
const problems = [
  {
    t: 'Your customers have questions. Your feed isn’t answering them.',
    d: 'People want to know how products work, whether they fit their lives, and why they should trust them. A stream of product promotions can leave those concerns unanswered — and give people little reason to return.',
  },
  {
    t: 'Your next launch is coming. Your audience isn’t.',
    d: 'If you start the conversation when your product is ready to sell, you’re starting late. Educational and entertaining content can help people discover your brand and become familiar with it before launch day.',
  },
  {
    t: 'Your team can’t be the content department every week.',
    d: 'Ideas, scripts, production, edits, approvals, and publishing all compete with running the business. Without an ongoing system, consistency becomes another task on your plate.',
  },
];

// 03 — what we manage
const steps = [
  {
    t: 'Find what your audience cares about',
    d: 'We look at your customers, product, competitors, and the questions people ask. Those signals help shape content themes, hooks, and a direction that makes sense for your brand.',
  },
  {
    t: 'Turn the ideas into content',
    d: 'We script, repurpose, design, edit, and produce Reels, carousels, Stories, and other agreed formats. Production may combine existing footage, AI-assisted creative, or real filming depending on the plan.',
  },
  {
    t: 'Publish, review, and refine',
    d: 'We upload and publish the approved content, review the available performance signals, and use what we learn to inform the next content cycle. Reporting cadence depends on your plan.',
  },
];
// TODO: three approved, real delivered pieces (with rights) replace these placeholders
const examples = ['Educational Reel', 'Audience-led carousel', 'Product-led short-form video'];

// 05 — why every post has a purpose
const purposes = [
  { t: 'Build an audience.', d: 'Give people useful or entertaining reasons to discover and follow your brand.' },
  { t: 'Build trust.', d: 'Answer buyer questions, explain product benefits, and share the knowledge behind your brand.' },
  { t: 'Create opportunities to sell.', d: 'Connect audience interest to your products when the message and timing make sense.' },
  { t: 'Keep it moving.', d: 'Make consistent publishing possible without putting every post on your team’s to-do list.' },
];

// 06 — questions worth answering
const faqs: Faq[] = [
  {
    q: 'Do you manage social media for ecommerce brands that don’t sell on Amazon?',
    a: 'Yes. We work with ecommerce brands on Amazon and beyond. The social platforms and number of accounts covered depend on your agreed plan.',
  },
  {
    q: 'Can we build an audience before our product launches?',
    a: 'Yes. We can develop a pre-launch content direction around customer questions, education, entertainment, and brand familiarity, so you’re not introducing yourself for the first time on launch day. Audience or sales growth isn’t guaranteed.',
  },
  {
    q: 'What does the monthly post count include?',
    a: 'Each plan has a stated monthly volume, but the mix of Reels, carousels, Stories, and cross-platform placements is set in your proposal. We’ll confirm what counts as a post, including repurposed and cross-posted content, before work begins.',
  },
  {
    q: 'Is paid advertising included in every plan?',
    a: 'No. Ads Management is listed with Grow, Scale, and Dominate, not Light. The platforms, campaign responsibilities, and media budget are agreed separately. Paying for ads is not the same as paying for ads management.',
  },
  {
    q: 'Will you film real content, or is everything made with AI?',
    a: 'It depends on the plan and creative brief. Light includes basic AI-enhanced content. Scale adds basic real filming, while Dominate lists real-content filming. Grow includes AI-enhanced content, with avatar creation available for an additional fee. We apply human creative direction and review to the work.',
  },
  {
    q: 'Will you reply to our comments and DMs?',
    a: 'Content production and publishing are different from customer service and community moderation. Comment and DM management, lead-routing automations, and support workflows are not automatically included in the listed plans; we can discuss those needs when defining your scope.',
  },
  {
    q: 'How do you know whether the content is working?',
    a: 'We review the signals relevant to your goals and available access, such as reach, engagement, audience responses, and traffic. Ads performance can be reviewed where ads management is included. Reporting is monthly for Light, Grow, and Scale; Dominate lists weekly tracking and conversion trend testing. These signals inform decisions but don’t prove every result was caused by content alone.',
  },
];

const breadcrumbs = [
  { name: 'Services', path: '/services' },
  { name: 'Social Media Management', path },
];
const schema = [
  serviceSchema({
    path,
    name: 'Social Media Management for Ecommerce Brands',
    serviceType: 'Social media management',
    description:
      'Monthly social media management for ecommerce brands on Amazon and beyond: research, strategy, scripting, Reels, carousels and Stories, editing, publishing and reporting.',
    offers: socialPackages.map((p) => ({
      '@type': 'Offer',
      name: `${p.name} — ${p.posts}`,
      price: p.price,
      priceCurrency: 'USD',
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: p.price,
        priceCurrency: 'USD',
        unitText: 'MONTH',
      },
    })),
  }),
  faqSchema(path, faqs),
];
---

<Layout
  title="Ecommerce Social Media Agency & Management | Share It Studio"
  description="Social media management for ecommerce brands: strategy, Reels, editing, posting, and monthly plans from $999. Compare Light, Grow, Scale and Dominate."
  breadcrumbs={breadcrumbs}
  schema={schema}
>
  <!-- 01 — Hero -->
  <PageHero
    eyebrow="Ecommerce social media agency"
    title="Social Media Management for Ecommerce Brands"
    highlight="Ecommerce Brands"
    subtitle={`<strong class="block font-display text-xl font-extrabold leading-snug text-brand-green md:text-2xl">Give people a reason to follow. Let us handle the content behind it.</strong><span class="mt-4 block">Your customers have questions, interests, and reasons to care beyond your next promotion. We turn those insights into a social content plan — then handle research, creative production, editing, and publishing according to the monthly plan you choose.</span><span class="mt-3 block text-sm font-semibold text-brand-green">For ecommerce brands on Amazon and beyond.</span>`}
    ctaLabel="Talk to a Human"
    ctaHref={bookHref}
    secondaryLabel="Compare Monthly Plans"
    secondaryHref="#monthly-plans"
  >
    <p class="mt-4 text-sm text-brand-ink/60">Choose a time to speak directly with our team.</p>
  </PageHero>

  <!-- 02 — The problems we help solve -->
  <section class="container-x py-12 md:py-24" aria-labelledby="problems-heading">
    <SectionHeading eyebrow="The problems we help solve" id="problems-heading" title="Your brand has more to say than “Buy now.”" />
    <ul class="grid gap-4 md:grid-cols-3">
      {problems.map((p) => (
        <li class="rounded-[1.5rem] bg-brand-cream p-6 sm:rounded-[1.75rem] sm:p-7">
          <h3 class="text-lg font-extrabold leading-snug text-brand-green sm:text-xl">{p.t}</h3>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-brand-ink/70 sm:mt-3 sm:text-base">{p.d}</p>
        </li>
      ))}
    </ul>
    <p class="mt-8 max-w-3xl font-display text-xl font-extrabold leading-snug text-brand-green sm:text-2xl md:text-[1.75rem]">
      You don’t need more posts just to fill a calendar. <span class="marker">You need content with a purpose</span> — and a team to produce it.
    </p>
  </section>

  <!-- 03 — What we manage -->
  <section class="bg-brand-cream py-12 md:py-24" aria-labelledby="manage-heading">
    <div class="container-x grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:items-center lg:gap-12">
      <div>
        <SectionHeading eyebrow="What we manage" id="manage-heading" title="From the right questions to a feed that keeps moving." align="left" />
        <ol class="space-y-3 sm:space-y-4">
          {steps.map((s, i) => (
            <li class="flex gap-4 rounded-[1.5rem] bg-white p-5 sm:gap-5 sm:rounded-[1.75rem] sm:p-6">
              <span class="font-display text-2xl font-extrabold text-brand-yellow sm:text-3xl" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="text-lg font-extrabold text-brand-green">{s.t}</h3>
                <p class="mt-1 text-[0.9375rem] text-brand-ink/70 sm:text-base">{s.d}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <div>
        <ul class="grid grid-cols-3 gap-3">
          {examples.map((e, i) => (
            <li class:list={['placeholder aspect-[4/5] rounded-[1rem] px-2 text-xs sm:aspect-[9/16] sm:rounded-[1.25rem]', i === 1 && 'translate-y-3 sm:translate-y-8']}>{e}</li>
          ))}
        </ul>
        <a href="/our-work" class="mt-7 inline-flex min-h-11 items-center sm:mt-14 font-semibold text-brand-green underline decoration-brand-yellow decoration-2 underline-offset-4 hover:decoration-brand-orange">
          See Social Content We’ve Created →
        </a>
      </div>
    </div>
  </section>

  <!-- 04 — Monthly plans: cards, one shared CTA, comparison, sample week -->
  <section id="monthly-plans" class="scroll-mt-24 py-12 md:py-24" aria-labelledby="plans-heading">
    <div class="container-x">
      <SectionHeading
        eyebrow="Monthly social media management plans"
        id="plans-heading"
        title="Choose the level of support your brand needs."
        text="From a consistent social presence to a higher-volume content operation with real filming and closer performance tracking, our monthly plans offer different levels of creative and management support."
      />
      <PackageCards />
      <p class="mt-6 max-w-3xl text-xs leading-relaxed text-brand-ink/55">
        Prices and scopes are subject to customization. The post count, formats, channels, filming logistics, revision process, platform access, and advertising budget will be clarified in your proposal. Ads management does not include media spend unless expressly agreed.
      </p>
      <a href={bookHref} class="btn-dark mt-6">Talk Through the Right Plan</a>

      <div class="mt-14 md:mt-20">
        <h3 class="text-[1.4rem] font-extrabold leading-tight text-brand-green sm:text-2xl md:text-3xl">Compare what changes between plans</h3>
        <p class="mb-6 mt-3 max-w-2xl text-brand-ink/70">
          The essential difference isn’t just how often we publish. It’s the type of production, product integration, and ongoing management included.
        </p>
        <PackageComparison />
        <p class="mt-4 max-w-3xl text-xs leading-relaxed text-brand-ink/55">
          All four plans include core research/strategy, content editing, uploading and posting. The exact deliverables are set by your contract. Paid advertising budgets are separate from management fees unless stated otherwise.
        </p>
      </div>

      <div class="mt-14 rounded-[1.75rem] bg-brand-cream p-5 sm:rounded-[2rem] sm:p-6 md:mt-20 md:p-10">
        <h3 class="text-[1.4rem] font-extrabold leading-tight text-brand-green sm:text-2xl md:text-3xl">See what a week could look like.</h3>
        <p class="mb-6 mt-3 max-w-2xl text-brand-ink/70">
          Choose a plan to explore an <strong class="text-brand-green">illustrative</strong> weekly mix of Reels, Stories, and carousels. Your actual content calendar will reflect your audience, goals, platforms, approvals, and contracted plan.
        </p>
        <PostingSchedule initial="grow" />
        <p class="mt-5 max-w-3xl text-xs leading-relaxed text-brand-ink/55">
          Sample publishing patterns only. They illustrate possible cadence, not guaranteed weekly deliverables or a fixed content mix. Duplicate Reel entries indicate multiple Reels on that day in the original example.
        </p>
      </div>
    </div>
  </section>

  <!-- 05 — Why every post has a purpose -->
  <section class="bg-brand-green py-12 md:py-20" aria-labelledby="purpose-heading">
    <div class="container-x">
      <p class="eyebrow mb-4 text-brand-yellow">Why every post has a purpose</p>
      <h2 id="purpose-heading" class="text-[1.7rem] font-extrabold leading-tight text-white sm:text-3xl md:text-4xl">Every Post Should Have a Purpose.</h2>
      <ul class="mt-8 grid gap-px sm:mt-10 overflow-hidden rounded-[1.75rem] bg-white/10 sm:grid-cols-2 lg:grid-cols-4">
        {purposes.map((p) => (
          <li class="bg-brand-green px-5 py-5 sm:p-6 md:p-7">
            <h3 class="text-lg font-extrabold text-brand-yellow">{p.t}</h3>
            <p class="mt-1.5 text-[0.9375rem] text-white/80 sm:mt-2 sm:text-sm">{p.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 06 — Questions worth answering -->
  <section class="container-x grid gap-8 py-12 md:grid-cols-[1fr_1.6fr] md:gap-12 md:py-24" aria-labelledby="faq-heading">
    <div>
      <p class="eyebrow mb-4">Questions worth answering</p>
      <h2 id="faq-heading" class="text-[1.85rem] font-extrabold leading-tight text-brand-green sm:text-4xl">What should you know before choosing a plan?</h2>
    </div>
    <FaqList faqs={faqs} variant="cream" />
  </section>

  <!-- 07 — Final CTA -->
  <CtaBanner
    title="Your next month of content starts with a clearer plan."
    text="Tell us what you sell, who you’re trying to reach, and what keeps your content from moving forward. We’ll help you explore the monthly scope and creative approach that make sense for your brand."
    ctaLabel="Talk to a Human"
    ctaHref={bookHref}
    note="Choose a time to speak directly with our team."
  />
</Layout>
