---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';

const services = [
  {
    title: 'Listing Optimization',
    text: 'Images, A+ Content, videos and copy designed around your buyer persona and competitor data to increase conversion rate.',
    href: '/services/listing-optimization',
    tags: ['Listing Images', 'A+ Content', 'Copywriting', 'Videos'],
  },
  {
    title: 'Social Media',
    text: 'Content and management for Instagram, TikTok and Facebook that builds your brand and drives external traffic to Amazon.',
    href: '/services/social-media',
    tags: ['Reels & TikToks', 'UGC', 'Content Calendar', 'Community'],
  },
];

const steps = [
  { title: 'Research', text: 'We analyze your market, competitors and thousands of reviews to find what drives purchases.' },
  { title: 'Strategy', text: 'We define your buyer persona, key messages and an image-by-image content plan.' },
  { title: 'Create', text: 'Designers, photographers and copywriters bring the plan to life.' },
  { title: 'Measure', text: 'We track sessions, CVR and sales to prove impact and iterate.' },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: { '@type': 'Service', name: s.title, description: s.text, url: `https://shareitstudio.com${s.href}` },
  })),
};
---

<Layout title="Services | Share It Studio" description="Amazon listing optimization and social media services for brands that want data-driven visual content." schema={serviceSchema}>
  <PageHero
    eyebrow="Services"
    title="Everything your brand needs to sell more on Amazon"
    subtitle="Strategic visual content for sellers — from the first image to the last A+ module."
    ctaLabel="Schedule a Call"
    ctaHref="/call"
  />

  <section class="container-x py-16 md:py-20">
    <div class="grid gap-8 md:grid-cols-2">
      {services.map((s) => (
        <a href={s.href} class="group flex flex-col rounded-3xl border border-black/5 bg-white p-8 shadow-sm transition hover:-translate-y-1 hover:shadow-xl">
          <div class="placeholder mb-6 aspect-[16/9]">{s.title} visual</div>
          <h2 class="text-2xl font-bold text-brand-green">{s.title}</h2>
          <p class="mt-3 flex-1 text-brand-ink/70">{s.text}</p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {s.tags.map((t) => <li class="rounded-full bg-brand-yellow-soft px-3 py-1 text-xs font-medium text-brand-green">{t}</li>)}
          </ul>
          <span class="mt-6 font-bold text-brand-orange group-hover:underline">Learn more →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="bg-brand-green py-16 text-white md:py-20">
    <div class="container-x">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <p class="eyebrow mb-3 text-brand-yellow">Our process</p>
        <h2 class="text-3xl font-bold md:text-4xl">Data first, design second</h2>
      </div>
      <ol class="grid gap-6 md:grid-cols-4">
        {steps.map((s, i) => (
          <li class="rounded-2xl bg-white/5 p-6 ring-1 ring-white/10">
            <span class="text-4xl font-bold text-brand-yellow">0{i + 1}</span>
            <h3 class="mt-3 text-xl font-bold">{s.title}</h3>
            <p class="mt-2 text-sm text-white/75">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="container-x py-16">
    <SectionHeading eyebrow="Results" title="Numbers our clients care about" />
    <div class="grid gap-6 text-center sm:grid-cols-3">
      {[
        { n: '+45.5%', l: 'Sales lift — ROSSM', href: '/case-studies/rossm' },
        { n: '+55.7%', l: 'Traffic increase — ROSSM', href: '/case-studies/rossm' },
        { n: '3', l: 'Featured case studies', href: '/case-studies' },
      ].map((s) => (
        <a href={s.href} class="rounded-2xl bg-brand-cream p-8 transition hover:bg-brand-yellow-soft">
          <p class="text-5xl font-bold text-brand-green">{s.n}</p>
          <p class="mt-2 text-sm text-brand-ink/70">{s.l}</p>
        </a>
      ))}
    </div>
  </section>

  <CtaBanner />
</Layout>
