---
/**
 * Services Hub (copy V2.3): two service lines — Social Media Management and Amazon Listing Optimization — with the
 * individual Amazon services as modular deliverables of the Amazon line (not a third business line).
 * Hero → Two ways to work with us → Amazon Creative Services → Brand diagnosis quiz → Why choose us → Client logos →
 * Final CTA.
 * No FAQs, case-study metrics, testimonials or standalone gallery here — those live on the homepage and child pages.
 */
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';
import BrandDiagnosisSection from '../../components/forms/BrandDiagnosisSection.astro';
import Spotlight from '../../components/ui/Spotlight.astro';
import '../../styles/selector.css';
import { getService, services } from '../../data/services';
import { itemListSchema } from '../../lib/schema';
import { slideOffset, slidePos, slideSide } from '../../lib/selector';
import oldListing from '../../assets/case-studies/super-ninja/old-listing.png';
import newListing from '../../assets/case-studies/super-ninja/new-listing.png';
import amarantoLogo from '../../assets/testimonials/logos/amaranto.png';
import yungprimeLogo from '../../assets/testimonials/logos/yungprime.png';
import giftest from '../../assets//giftest.gif';

const bookHref = '/book-a-call'; // TODO: verified Calendly booking destination

// 02 — the two service lines
const lines = [
  {
    num: '01',
    label: 'Social Media Management',
    title: 'Your social content, handled. Your brand, consistently present.',
    text: 'Strategy, scripts, production, editing and publishing. For ecommerce brands, on Amazon or not.',
    how: 'Monthly plans',
    cta: 'Explore Social Media Management',
    href: '/services/social-media-management',
    portfolio: '/our-work',
  },
  {
    num: '02',
    label: 'Amazon Listing Optimization',
    title: 'Make your product’s value easier to see—and easier to understand.',
    text: 'Listing content built around your product’s benefits and your buyers’ questions. One asset or a full project.',
    how: 'Individual services or custom projects',
    cta: 'Explore Amazon Listing Optimization',
    href: '/services/amazon-listing-optimization',
    portfolio: '/our-work',
  },
];

// TODO: approved Reels and carousels (with permissions) replace these placeholders
const socialPreview = [
  { type: 'text', label: 'Reel' },
  { type: 'text', label: 'Carousel' },
  { type: 'text', label: 'Reel' },
];

// 03 — the individual Amazon services, in the order of the copy. One selector slide each.
// TODO: an approved image per service (import it from src/assets and set `image`); until then the slide shows a placeholder
const creative = ([
  {
    slug: 'amazon-listing-images',
    bestWhen: 'Your product is better than your images show.',
    get: 'Main images, infographics and lifestyle visuals.',
    cta: 'Explore Listing Images',
  },
  {
    slug: 'amazon-a-plus-content',
    bestWhen: 'Shoppers reach the bottom of your listing with questions left.',
    get: 'Basic or Premium A+ Content that answers them.',
    cta: 'Explore A+ Content',
  },
  {
    slug: 'amazon-product-photography',
    bestWhen: 'Your product looks better in person than online.',
    get: 'Studio and lifestyle photos that show its real quality.',
    cta: 'Explore Photography',
  },
  {
    slug: 'amazon-product-video-production',
    bestWhen: 'Photos alone don’t show how your product works.',
    get: 'Demos, how-tos and Amazon video creative.',
    cta: 'Explore Product Videos',
  },
  {
    slug: 'amazon-storefront-design',
    bestWhen: 'Shoppers see separate listings, not a brand to explore.',
    get: 'A branded Storefront that connects your catalog.',
    cta: 'Explore Storefront Design',
  },
  {
    slug: 'amazon-brand-story-design',
    bestWhen: 'Shoppers compare you on price because they don’t know your brand.',
    get: 'Brand Story modules that show who’s behind the product.',
    cta: 'Explore Brand Story',
  },
  {
    slug: 'amazon-listing-copywriting',
    bestWhen: 'Your titles and bullets don’t match how buyers search.',
    get: 'Keyword-informed titles, bullets and listing copy.',
    cta: 'Explore Listing Copywriting',
  },
] as { slug: string; bestWhen: string; get: string; cta: string; image?: { src: ImageMetadata; alt: string } }[]
).map((c) => ({ ...c, service: getService(c.slug) }));

// 04 — why choose us
const reasons = [
  { t: 'Buyer-informed creative', d: 'Built on what shoppers need to understand.' },
  { t: 'Support that fits', d: 'One deliverable, a custom project or a monthly plan.' },
  { t: 'Human judgment behind the work', d: 'People direct and review everything, AI included.' },
];

// 05 — TODO: 4–6 confirmed client logos with display permission; empty slots render as placeholders
const logos = [
  { src: amarantoLogo, alt: 'Amaranto' },
  { src: yungprimeLogo, alt: 'YUNGPRIME' },
];
const logoSlots = Math.max(0, 4 - logos.length);

const breadcrumbs = [{ name: 'Services', path: '/services' }];
const schema = [
  itemListSchema(
    '/services',
    'Share It Studio services',
    services.map((s) => ({ name: s.title, path: s.href })),
  ),
];
---

<Layout
  title="Amazon Listing Optimization & Social Media Services | Share It Studio"
  description="Explore Amazon listing optimization, A+ Content, listing images, product videos, and monthly social media management. Individual services or tailored projects."
  breadcrumbs={breadcrumbs}
  pageType="CollectionPage"
  schema={schema}
>
  <!-- 01 — Hero -->
  <PageHero
    eyebrow="Our Services"
    title="Amazon Listing Optimization & Social Media Management"
    subtitle="Amazon creative that helps shoppers understand your product. Social media that keeps your brand present."
    ctaLabel="Explore Our Services"
    ctaHref="#amazon-creative-services"
  />

  <!-- 02 — Two ways to work with us: two open rows (no boxes), text and visual swapping sides, visuals slightly tilted -->
  <section class="container-x py-12 md:py-24" aria-labelledby="lines-heading">
    <SectionHeading eyebrow="Two ways to work with us" id="lines-heading" title="Two services. Built around your brand." align="left" />
    <div class="divide-y divide-dashed divide-brand-green/20">
      {lines.map((l, i) => {
        const social = i === 0;
        return (
          <article class="grid items-center gap-8 py-10 first:pt-0 last:pb-0 sm:py-14 lg:grid-cols-[1.1fr_1fr] lg:gap-16" aria-labelledby={`line-${l.num}`}>
            <div class:list={['relative', !social && 'lg:order-2']}>
              <span class="step-num font-display text-5xl font-extrabold leading-none text-brand-orange sm:text-6xl" aria-hidden="true">
                {l.num}
              </span>
              <p class="relative mt-4 text-xs font-bold uppercase tracking-[0.18em] text-brand-green/60">
                {l.label} <span class="text-brand-green/50">· {l.how}</span>
              </p>
              <h3 id={`line-${l.num}`} class="relative mt-3 text-[1.6rem] font-extrabold leading-[1.1] text-brand-green sm:text-4xl">{l.title}</h3>
              <p class="relative mt-4 max-w-lg text-brand-ink/65">{l.text}</p>
              <a href={l.href} class:list={[i === 0 ? 'btn-primary' : 'btn-dark', 'relative mt-6']}>{l.cta}</a>
            </div>

            {social ? (
              <a href={l.portfolio} class="group block" aria-label="See social media work: Reels and carousels">
                <ul class="flex items-end justify-center gap-3 sm:gap-4">
                    {socialPreview.map((item, k) => (
                    <li
                      class:list={[
                        'grid aspect-[9/16] w-1/4 max-w-[9rem] place-items-center rounded-[1.25rem] border-2 border-dashed border-brand-green/20 bg-brand-cream text-xs font-medium text-brand-green/50 transition group-hover:border-brand-orange/60',
                        k === 0 && '-rotate-6',
                        k === 1 && 'mb-8 rotate-2 bg-brand-yellow-soft',
                        k === 2 && 'rotate-6',
                      ]}
                    >
                      {item.label}
                    </li>
                  ))}
                </ul>
                <span class="mt-4 flex min-h-11 items-center justify-center text-sm font-semibold text-brand-green transition group-hover:text-brand-orange">
                  See Reels and carousels →
                </span>
              </a>
            ) : (
              <a href={l.portfolio} class="group block lg:order-1" aria-label="See Amazon listing transformations">
                <div class="grid grid-cols-2 items-center gap-4">
                  <figure class="-rotate-3">
                    <Image src={oldListing} alt="Super Ninja Amazon listing images before the redesign" width={435} class="aspect-square w-full rounded-[1.25rem] bg-white object-contain p-2 opacity-80" />
                    <figcaption class="mt-2 text-center text-xs font-semibold uppercase tracking-wider text-brand-ink/50">Before</figcaption>
                  </figure>
                  <figure class="rotate-2">
                    <Image src={newListing} alt="Super Ninja Amazon listing images after the redesign" width={436} class="aspect-square w-full rounded-[1.25rem] bg-white object-contain p-2 shadow-lg ring-2 ring-brand-yellow transition group-hover:-translate-y-1" />
                    <figcaption class="mt-2 text-center text-xs font-semibold uppercase tracking-wider text-brand-orange">After</figcaption>
                  </figure>
                </div>
                <span class="mt-2 flex min-h-11 items-center justify-center text-sm font-semibold text-brand-green transition group-hover:text-brand-orange">
                  See Amazon listing transformations →
                </span>
              </a>
            )}
          </article>
        );
      })}
    </div>
  </section>

  <!-- 03 — Need one specific deliverable? (part of the Amazon line, not a third business line).
       A selector like the landing's case studies: the centred service is a card (image + best when / what you get),
       its neighbours show only their image. All services are in the HTML; scripts/selector.ts only moves them. -->
  <section id="amazon-creative-services" class="scroll-mt-24 overflow-hidden bg-brand-cream py-12 md:py-24" aria-labelledby="creative-heading">
    <div class="container-x">
      <SectionHeading
        eyebrow="Need one specific deliverable?"
        id="creative-heading"
        title="Amazon Creative Services"
        text="Pick the one that fits, or combine several."
      />
    </div>

    <div class="wk wk--light" data-wk role="region" aria-roledescription="carousel" aria-label="Amazon Creative Services">
      <ul class="wk-stage" data-wk-stage>
        {creative.map((c, i) => {
          const o = slideOffset(i, 0, creative.length);
          return (
            <li
              class="wk-slide"
              data-wk-slide
              data-pos={slidePos(o)}
              data-side={slideSide(o)}
              style={`--o:${o}`}
              aria-roledescription="slide"
              aria-label={`${i + 1} of ${creative.length}: ${c.service.title}`}
              aria-hidden={o === 0 ? undefined : 'true'}
            >
              <a href={c.service.href} class="wk-media" tabindex={o === 0 ? undefined : -1} aria-label={c.cta}>
                {c.image ? (
                  <Image
                    src={c.image.src}
                    alt={c.image.alt}
                    width={900}
                    widths={[360, 600, 900]}
                    sizes="(min-width: 1024px) 28rem, min(94vw, 34rem)"
                    class="wk-img wk-img--scroll"
                    style={`--scroll-dur:${Math.max(10, (c.image.src.height / c.image.src.width - 1) * 25).toFixed(1)}s`}
                  />
                ) : (
                  <div class="media-fallback wk-img">
                    <Spotlight id={`svc-fb-${i}`} class="media-fallback-spot" />
                    <span>{c.service.title}</span>
                  </div>
                )}
              </a>
              <div class="wk-panel" inert={o !== 0}>
                <p class="text-xs font-semibold uppercase tracking-wider text-brand-orange">
                  {String(i + 1).padStart(2, '0')} / {String(creative.length).padStart(2, '0')}
                </p>
                <h3 class="mt-2 text-xl font-extrabold leading-snug text-brand-green lg:text-2xl">{c.service.title}</h3>
                <p class="mt-4 text-xs font-bold uppercase tracking-[0.18em] text-brand-orange">Best when</p>
                <p class="wk-text svc-text">{c.bestWhen}</p>
                <p class="mt-3 text-xs font-bold uppercase tracking-[0.18em] text-brand-green/60">What you get</p>
                <p class="wk-text svc-text">{c.get}</p>
                <a href={c.service.href} class="wk-cta">{c.cta} →</a>
              </div>
            </li>
          );
        })}
      </ul>

      <div class="container-x">
        <div class="wk-foot">
          <div class="wk-nav">
            <button type="button" class="wk-arrow wk-arrow--prev" data-wk-prev aria-label="Previous service"></button>
            <div class="wk-dots" role="group" aria-label="Choose a service">
              {creative.map((c, i) => (
                <button type="button" class="wk-dot" data-wk-dot aria-label={`Show ${c.service.title}`} aria-current={i === 0 ? 'true' : undefined}></button>
              ))}
            </div>
            <button type="button" class="wk-arrow wk-arrow--next" data-wk-next aria-label="Next service"></button>
          </div>
          <aside class="flex max-w-xl flex-wrap items-center gap-x-5 gap-y-3" aria-labelledby="not-sure-heading">
            <div class="min-w-0 flex-1 basis-64">
              <h3 id="not-sure-heading" class="text-lg font-extrabold text-brand-green">Not sure which service you need?</h3>
              <p class="mt-1 text-sm text-brand-ink/65">Tell us about your product. We’ll point you to the right one.</p>
            </div>
            <a href={bookHref} class="btn-dark">Talk to a Human</a>
          </aside>
        </div>
        <p class="sr-only" aria-live="polite" data-wk-status></p>
      </div>
    </div>
  </section>

  <!-- Brand Diagnosis quiz -->
  <BrandDiagnosisSection />

  <!-- 04 — Why choose Share It Studio? Three short claims side by side, no boxes -->
  <section class="container-x py-12 md:py-24" aria-labelledby="why-heading">
    <SectionHeading eyebrow="Why choose Share It Studio?" id="why-heading" title="The right thinking. The right creative. The right scope." align="left" />
    <ol class="grid gap-10 md:grid-cols-3 md:gap-0 md:divide-x md:divide-dashed md:divide-brand-green/20">
      {reasons.map((r, i) => (
        <li class="md:px-8 md:first:pl-0 md:last:pr-0">
          <span class="step-num font-display text-5xl font-extrabold text-brand-yellow sm:text-6xl" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-3 text-2xl font-extrabold leading-tight text-brand-green">{r.t}</h3>
          <p class="mt-2 text-brand-ink/60">{r.d}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- 05 — Brands we've worked with: logos loose on one line, placeholders as pills -->
  <section class="bg-brand-cream py-12 md:py-16" aria-labelledby="brands-heading">
    <div class="container-x flex flex-col items-center gap-8 md:flex-row md:justify-between">
      <h2 id="brands-heading" class="text-[1.7rem] font-extrabold text-brand-green sm:text-3xl">In good company.</h2>
      <ul class="flex flex-wrap items-center justify-center gap-x-10 gap-y-5">
        {logos.map((l) => (
          <li>
            <Image src={l.src} alt={`${l.alt} logo`} height={80} densities={[1, 2]} class="max-h-10 w-auto object-contain opacity-70 grayscale transition hover:opacity-100 hover:grayscale-0" />
          </li>
        ))}
        {Array.from({ length: logoSlots }, () => (
          <li class="grid h-10 w-32 place-items-center rounded-full border-2 border-dashed border-brand-green/15 text-xs font-medium text-brand-green/40" aria-hidden="true">Client logo</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 06 — Final CTA -->
  <CtaBanner
    title="Not sure where to start?"
    text="Tell us what you’re selling and what you need. We’ll help you find the right approach."
    ctaLabel="Talk to a Human"
    ctaHref={bookHref}
  />
</Layout>

<script>
  import { initSelector } from '../../scripts/selector';
  document.querySelectorAll<HTMLElement>('[data-wk]').forEach((root) => initSelector(root));
</script>

<style>
  /* Two short blocks per service (best when / what you get); the full text is on each service page */
  .svc-text {
    margin-top: 0.35rem;
    -webkit-line-clamp: 3;
  }
  @media (max-width: 1023px) {
    .svc-text {
      -webkit-line-clamp: 2;
    }
  }
</style>
