---
/**
 * Services Hub (copy V2.3): two service lines — Social Media Management and Amazon Listing Optimization — with the
 * individual Amazon services as modular deliverables of the Amazon line (not a third business line).
 * Hero → Two ways to work with us → Amazon Creative Services → Why choose us → Client logos → Final CTA.
 * No FAQs, case-study metrics, testimonials or standalone gallery here — those live on the homepage and child pages.
 */
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';
import { getService, services } from '../../data/services';
import { itemListSchema } from '../../lib/schema';
import oldListing from '../../assets/case-studies/super-ninja/old-listing.png';
import newListing from '../../assets/case-studies/super-ninja/new-listing.png';
import amarantoLogo from '../../assets/testimonials/logos/amaranto.png';
import yungprimeLogo from '../../assets/testimonials/logos/yungprime.png';

const bookHref = '/book-a-call'; // TODO: verified Calendly booking destination

// 02 — the two service lines
const lines = [
  {
    num: '01',
    label: 'Social Media Management',
    title: 'Your social content, handled. Your brand, consistently present.',
    text: 'We turn audience insights and brand knowledge into a managed content plan, with strategy, scripting, creative production, editing, and publishing according to your monthly package.',
    note: 'Built for ecommerce brands, whether they sell on Amazon or not.',
    how: 'Ongoing monthly plans.',
    cta: 'Explore Social Media Management',
    href: '/services/social-media-management',
    portfolio: '/portfolio/social-media',
  },
  {
    num: '02',
    label: 'Amazon Listing Optimization',
    title: 'Make your product’s value easier to see—and easier to understand.',
    text: 'We develop Amazon listing content around your product’s benefits, buyer questions, and competitive context, helping shoppers understand what makes your product worth choosing.',
    note: 'Whether you need one creative asset or several working together, we’ll help define the right scope for your listing.',
    how: 'Individual services or custom projects.',
    cta: 'Explore Amazon Listing Optimization',
    href: '/services/amazon-listing-optimization',
    portfolio: '/portfolio',
  },
];

// TODO: approved Reels and carousels (with permissions) replace these placeholders
const socialPreview = ['Reel', 'Carousel', 'Reel'];

// 03 — the individual Amazon services, in the order of the copy
const creative = [
  {
    slug: 'amazon-listing-images',
    bestWhen: 'Your product has more to offer than your images show. When shoppers can’t see the difference, cheaper competitors can become the easier choice.',
    get: 'Main images, infographics, and lifestyle visuals that communicate your product’s benefits and differentiation.',
    cta: 'Explore Listing Images',
  },
  {
    slug: 'amazon-a-plus-content',
    bestWhen: 'Shoppers visit your listing but still have questions about quality, benefits, or product fit. Without clear answers, they may leave without buying.',
    get: 'Basic or Premium A+ Content, where eligible, designed to explain benefits, address objections, and reinforce product value.',
    cta: 'Explore A+ Content',
  },
  {
    slug: 'amazon-product-photography',
    bestWhen: 'Your product looks better in person than it does online. Inaccurate colors, materials, or details can make its quality harder to trust.',
    get: 'Professional studio and lifestyle photography that accurately captures your product’s quality, features, and real-world use.',
    cta: 'Explore Photography',
  },
  {
    slug: 'amazon-product-video-production',
    bestWhen: 'Shoppers can’t fully understand how your product works or what makes it useful from photos alone. That uncertainty can delay their purchase decision.',
    get: 'Product demonstrations, instructional videos, and Amazon video creative that show your product in action.',
    cta: 'Explore Product Videos',
  },
  {
    slug: 'amazon-storefront-design',
    bestWhen: 'You sell multiple products, but shoppers see disconnected listings instead of a brand they can explore. Related products and your wider catalog may go unnoticed.',
    get: 'A branded Amazon Storefront that organizes your catalog, connects product collections, and helps customers explore your range.',
    cta: 'Explore Storefront Design',
  },
  {
    slug: 'amazon-brand-story-design',
    bestWhen: 'You’re competing with cheaper alternatives, but shoppers don’t know the brand, quality, or values behind your products. Without that context, price may become their main comparison.',
    get: 'Amazon Brand Story modules that communicate your identity, build brand familiarity, and connect your product range.',
    cta: 'Explore Brand Story',
  },
  {
    slug: 'amazon-listing-copywriting',
    bestWhen: 'Your titles and bullet points don’t reflect how customers search or what makes your product different. That can make your listing harder to discover and your benefits easier to overlook.',
    get: 'Keyword-informed titles, bullet points, and listing copy that connect relevant search terms with clear product benefits.',
    cta: 'Explore Listing Copywriting',
  },
].map((c) => ({ ...c, service: getService(c.slug) }));

// 04 — why choose us
const reasons = [
  {
    t: 'Buyer-informed creative',
    d: 'We look beyond how content appears to what shoppers and audiences need to understand. Product research, customer questions, and competitive context help guide creative decisions when relevant to your project.',
  },
  {
    t: 'Creative support that fits your needs',
    d: 'From individual Amazon deliverables to custom listing projects and ongoing social media plans, you can choose the level of support that makes sense for your brand.',
  },
  {
    t: 'Human judgment behind the work',
    d: 'From photography and video to design and AI-assisted production, our team brings human direction, creative judgment, and review to the content we create.',
  },
];

// 05 — TODO: 4–6 confirmed client logos with display permission; empty slots render as placeholders
const logos = [
  { src: amarantoLogo, alt: 'Amaranto' },
  { src: yungprimeLogo, alt: 'YUNGPRIME' },
];
const logoSlots = Math.max(0, 4 - logos.length);

const breadcrumbs = [{ name: 'Services', path: '/services' }];
const schema = [
  itemListSchema(
    '/services',
    'Share It Studio services',
    services.map((s) => ({ name: s.title, path: s.href })),
  ),
];
---

<Layout
  title="Amazon Listing Optimization & Social Media Services | Share It Studio"
  description="Explore Amazon listing optimization, A+ Content, listing images, product videos, and monthly social media management. Individual services or tailored projects."
  breadcrumbs={breadcrumbs}
  pageType="CollectionPage"
  schema={schema}
>
  <!-- 01 — Hero -->
  <PageHero
    eyebrow="Our Services"
    title="Amazon Listing Optimization & Social Media Management"
    subtitle="One team for two different needs: Amazon creative content that helps shoppers understand your product, and ongoing social media management that keeps ecommerce brands connected with their audiences."
    ctaLabel="Explore Our Services"
    ctaHref="#amazon-creative-services"
  />

  <!-- 02 — Two ways to work with us -->
  <section class="container-x py-12 md:py-24" aria-labelledby="lines-heading">
    <SectionHeading eyebrow="Two ways to work with us" id="lines-heading" title="Two services. Built around what your brand needs." />
    <div class="space-y-4 sm:space-y-6">
      {lines.map((l, i) => {
        const dark = i === 0;
        return (
          <article
            class:list={[
              'grid items-center gap-5 overflow-hidden rounded-[1.75rem] p-5 sm:gap-8 sm:rounded-[2rem] sm:p-8 md:p-12 lg:grid-cols-[1.1fr_1fr] lg:gap-12',
              dark ? 'bg-brand-green text-white' : 'bg-brand-cream text-brand-green',
            ]}
            aria-labelledby={`line-${l.num}`}
          >
            <div class:list={[!dark && 'lg:order-2']}>
              <p class:list={['text-xs font-bold uppercase tracking-[0.18em]', dark ? 'text-brand-yellow' : 'text-brand-orange']}>
                {l.num} / {l.label}
              </p>
              <h3 id={`line-${l.num}`} class="mt-3 text-[1.5rem] font-extrabold leading-tight sm:mt-4 sm:text-3xl md:text-[2.1rem]">{l.title}</h3>
              <p class:list={['mt-3 text-[0.9375rem] leading-relaxed sm:mt-4 sm:text-base', dark ? 'text-white/80' : 'text-brand-ink/75']}>{l.text}</p>
              <p class:list={['mt-3 text-sm font-semibold', dark ? 'text-white' : 'text-brand-green']}>{l.note}</p>
              <p class:list={['mt-4 inline-flex flex-wrap gap-x-2 rounded-2xl px-4 py-2 text-sm sm:mt-5', dark ? 'bg-white/10 text-white/85' : 'bg-white text-brand-ink/75']}>
                <strong class:list={[dark ? 'text-brand-yellow' : 'text-brand-green']}>How it works:</strong>
                {l.how}
              </p>
              <div class="mt-6 sm:mt-7">
                <a href={l.href} class:list={[dark ? 'btn-primary' : 'btn-dark']}>{l.cta}</a>
              </div>
            </div>

            {dark ? (
              <a href={l.portfolio} class="group block" aria-label="See social media work: Reels and carousels">
                <ul class="grid grid-cols-3 gap-3">
                  {socialPreview.map((kind, k) => (
                    <li
                      class:list={[
                        'grid aspect-square place-items-center rounded-[1rem] border-2 border-dashed sm:aspect-[9/16] sm:rounded-[1.25rem] border-white/20 bg-white/5 text-xs font-medium text-white/50 transition group-hover:border-brand-yellow/60',
                        k === 1 && 'sm:translate-y-6',
                      ]}
                    >
                      {kind}
                    </li>
                  ))}
                </ul>
                <span class="mt-4 inline-flex min-h-11 items-center text-sm font-semibold text-white/85 sm:mt-10 transition group-hover:text-brand-yellow">
                  See Reels and carousels →
                </span>
              </a>
            ) : (
              <a href={l.portfolio} class="group block lg:order-1" aria-label="See Amazon listing transformations">
                <div class="grid grid-cols-2 gap-3">
                  <figure class="relative">
                    <Image src={oldListing} alt="Super Ninja Amazon listing images before the redesign" width={435} class="aspect-[4/3] w-full rounded-[1rem] bg-white object-contain p-1.5 sm:aspect-square sm:rounded-[1.25rem] sm:p-2" />
                    <figcaption class="absolute left-2 top-2 rounded-full bg-brand-green/85 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wider text-white sm:static sm:mt-2 sm:bg-transparent sm:p-0 sm:text-brand-ink/50">Before</figcaption>
                  </figure>
                  <figure class="relative">
                    <Image src={newListing} alt="Super Ninja Amazon listing images after the redesign" width={436} class="aspect-[4/3] w-full rounded-[1rem] bg-white object-contain p-1.5 shadow-lg sm:aspect-square sm:rounded-[1.25rem] sm:p-2 ring-2 ring-brand-yellow transition group-hover:-translate-y-1" />
                    <figcaption class="absolute left-2 top-2 rounded-full bg-brand-yellow px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wider text-brand-green sm:static sm:mt-2 sm:bg-transparent sm:p-0 sm:text-brand-orange">After</figcaption>
                  </figure>
                </div>
                <span class="mt-2 inline-flex min-h-11 items-center text-sm font-semibold text-brand-green transition group-hover:text-brand-orange">
                  See Amazon listing transformations →
                </span>
              </a>
            )}
          </article>
        );
      })}
    </div>
  </section>

  <!-- 03 — Need one specific deliverable? (part of the Amazon line, not a third business line) -->
  <section id="amazon-creative-services" class="scroll-mt-24 bg-brand-cream py-12 md:py-24" aria-labelledby="creative-heading">
    <div class="container-x">
      <SectionHeading
        eyebrow="Need one specific deliverable?"
        id="creative-heading"
        title="Amazon Creative Services"
        text="Every product has a different challenge. Find the creative service that fits yours, or combine several into a custom project."
      />
      <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {creative.map((c) => (
          <li class="flex">
            <article class="flex w-full flex-col rounded-[1.5rem] bg-white p-6 shadow-sm sm:rounded-[1.75rem] sm:p-7">
              <h3 class="text-xl font-extrabold text-brand-green">{c.service.title}</h3>
              <p class="mt-4 text-xs font-bold uppercase tracking-[0.18em] text-brand-orange">Best when</p>
              <p class="mt-1.5 text-[0.9375rem] leading-relaxed text-brand-ink/75 sm:text-sm">{c.bestWhen}</p>
              <p class="mt-4 text-xs font-bold uppercase tracking-[0.18em] text-brand-green/60">What you get</p>
              <p class="mt-1.5 flex-1 text-[0.9375rem] leading-relaxed text-brand-ink/75 sm:text-sm">{c.get}</p>
              <a
                href={c.service.href}
                class="mt-5 inline-flex min-h-[44px] items-center self-start text-sm font-semibold text-brand-green underline decoration-brand-yellow decoration-2 underline-offset-4 hover:decoration-brand-orange"
              >
                {c.cta} →
              </a>
            </article>
          </li>
        ))}
        <li class="flex md:col-span-2 lg:col-span-2">
          <aside class="flex w-full flex-col justify-center rounded-[1.75rem] bg-brand-green p-6 text-white sm:p-7 md:p-9" aria-labelledby="not-sure-heading">
            <h3 id="not-sure-heading" class="text-2xl font-extrabold">Not sure which service you need?</h3>
            <p class="mt-3 max-w-xl text-white/75">
              Tell us about your product and the challenges you’re facing. We’ll help you identify which creative services are worth exploring.
            </p>
            <a href={bookHref} class="btn-primary mt-6 self-start">Talk to a Human</a>
          </aside>
        </li>
      </ul>
    </div>
  </section>

  <!-- 04 — Why choose Share It Studio? -->
  <section class="container-x py-12 md:py-24" aria-labelledby="why-heading">
    <SectionHeading
      eyebrow="Why choose Share It Studio?"
      id="why-heading"
      title="The right thinking. The right creative. The right scope."
    />
    <ol class="grid gap-4 md:grid-cols-3">
      {reasons.map((r, i) => (
        <li class="rounded-[1.5rem] border border-black/5 p-6 shadow-sm sm:rounded-[1.75rem] sm:p-7">
          <span class="font-display text-3xl font-extrabold text-brand-yellow sm:text-4xl" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-3 text-xl font-extrabold text-brand-green">{r.t}</h3>
          <p class="mt-2 text-brand-ink/70">{r.d}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- 05 — Brands we've worked with -->
  <section class="bg-brand-cream py-12 md:py-20" aria-labelledby="brands-heading">
    <div class="container-x text-center">
      <p class="eyebrow justify-center">Brands we’ve worked with</p>
      <h2 id="brands-heading" class="mt-4 text-[1.7rem] font-extrabold text-brand-green sm:text-3xl md:text-4xl">In good company.</h2>
      <ul class="mx-auto mt-8 grid max-w-4xl grid-cols-2 gap-3 sm:mt-10 sm:gap-4 md:grid-cols-4">
        {logos.map((l) => (
          <li class="grid h-20 place-items-center rounded-[1.25rem] bg-white px-5 sm:h-24 sm:px-6">
            <Image src={l.src} alt={`${l.alt} logo`} height={80} densities={[1, 2]} class="max-h-10 w-auto object-contain opacity-80" />
          </li>
        ))}
        {Array.from({ length: logoSlots }, () => (
          <li class="placeholder h-20 rounded-[1.25rem] text-xs sm:h-24" aria-hidden="true">Client logo</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 06 — Final CTA -->
  <CtaBanner
    title="Not sure where to start?"
    text="Tell us what you’re selling, what your content needs to accomplish, or where you’re looking for support. We’ll help you explore the right creative approach for your brand."
    ctaLabel="Talk to a Human"
    ctaHref={bookHref}
    note="Choose a time to speak directly with our team."
  />
</Layout>
