---
/**
 * Amazon Brand Story Design (copy V1): P2 commercial landing page for "amazon brand story design services".
 * Hero → Selected work → What we design → How we work → FAQ → Final CTA.
 * Hiring the design service, not Amazon's publishing feature: no guide content, no case studies or testimonials, and
 * no promises of sales, rankings or Premium A+ eligibility. A+ Content and Storefront are separate services.
 */
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';
import FaqList from '../../components/ui/FaqList.astro';
import { getService } from '../../data/services';
import { faqSchema, serviceSchema } from '../../lib/schema';
import { BOOKING_PAGE } from '../../config/site';
import { withBase } from '../../lib/url';

const path = '/services/amazon-brand-story-design';
const service = getService('amazon-brand-story-design');
const faqs = service.faqs!;

// 02 — approved cards from real Brand Story projects, captioned with their purpose (no sales effect).
// TODO: real cards with client permission. If only one approved project exists, show that one, not a fake gallery.
const work = [
  { kind: 'Background & identity card', purpose: 'Makes the brand recognizable at a glance.' },
  { kind: 'Message & values card', purpose: 'Says what the brand stands for.' },
  { kind: 'Related-product card', purpose: 'Points shoppers to the rest of the catalog.' },
];

// 03 — what we design
const parts = [
  {
    t: 'A recognizable brand introduction',
    d: 'Use your logo, visual identity, and clear messaging to show shoppers the people, promise, or values behind your products — without inventing a dramatic founder story.',
  },
  {
    t: 'A connected visual carousel',
    d: 'Bring your message to life through Amazon’s Brand Story background and image-and-text cards. We shape the sequence so it feels like one brand, not disconnected graphics.',
  },
  {
    t: 'A clearer path to your product family',
    d: 'When relevant to your catalog and Amazon’s available features, Brand Story cards can help shoppers discover related products or visit your Amazon Brand Store.',
  },
];

// 04 — how we work
const steps = [
  {
    t: 'Find the message',
    d: 'We review your products, current branding, brand background, and relevant competitors to understand what genuinely sets you apart and what a shopper should remember.',
  },
  {
    t: 'Plan the carousel',
    d: 'We decide which messages, visuals, and product connections deserve space, then organize the cards around a consistent brand direction.',
  },
  {
    t: 'Design, review & deliver',
    d: 'We create the agreed background, cards, and copy, check that product and brand information is accurate, and prepare the assets for the agreed Amazon requirements and project scope.',
  },
];

// Related pages: parent offer and the services that sit next to Brand Story on Amazon
const related = [
  { label: 'Amazon Listing Optimization', href: '/services/amazon-listing-optimization', primary: true },
  { label: 'Amazon A+ Content Design', href: '/services/amazon-a-plus-content' },
  { label: 'Amazon Storefront Design', href: '/services/amazon-storefront-design' },
];

const description =
  'Show shoppers the brand behind your products. Explore custom Amazon Brand Story carousel design, visual messaging, and links to your catalog. Request a quote.';

const breadcrumbs = [
  { name: 'Services', path: '/services' },
  { name: 'Amazon Listing Optimization', path: '/services/amazon-listing-optimization' },
  { name: 'Amazon Brand Story Design', path },
];
const schema = [
  serviceSchema({
    path,
    name: 'Amazon Brand Story Design Services',
    serviceType: 'Amazon Brand Story design',
    description:
      'Design of Amazon Brand Story carousels: brand background, identity and message cards, and cards that link to related products or the Amazon Brand Store.',
  }),
  faqSchema(path, faqs),
];
---

<Layout
  title="Amazon Brand Story Design Services | Share It Studio"
  description={description}
  breadcrumbs={breadcrumbs}
  schema={schema}
>
  <!-- 01 — Hero -->
  <PageHero
    eyebrow="Amazon Brand Story design services"
    title="Amazon Brand Story Design That Shows Who’s Behind the Product"
    highlight="Who’s Behind the Product"
    subtitle={`<strong class="block font-display text-xl font-extrabold leading-snug text-brand-green md:text-2xl">Your product has a listing. But does your brand have a presence shoppers can recognize?</strong><span class="mt-4 block">We create Amazon Brand Story carousels that introduce your brand, communicate what makes it different, and help customers discover more of your products — right on the Amazon detail page.</span><span class="mt-3 block text-sm font-semibold text-brand-green">Need Brand Story on its own? You don’t have to purchase a full Amazon listing refresh.</span>`}
    ctaLabel="Talk to a Human"
    ctaHref={BOOKING_PAGE}
    secondaryLabel="See Our Brand Story Work"
    secondaryHref="#brand-story-work"
  >
    <p class="mt-4 text-sm text-brand-ink/60">
      Share your Amazon listing and tell us what you want shoppers to know about your brand.
    </p>

    <!-- TODO: a real, approved detail page showing the "From the brand" carousel (not an A+ screenshot) -->
    <div slot="visual" class="rounded-[1.75rem] bg-white p-5 shadow-xl sm:p-7" aria-hidden="true">
      <p class="text-sm font-bold text-brand-green">From the brand</p>
      <div class="mt-3 flex gap-3 overflow-hidden rounded-[1.25rem] bg-brand-green p-3 sm:gap-4 sm:p-4">
        <div class="grid aspect-[3/4] w-1/3 shrink-0 place-items-center rounded-xl bg-brand-yellow text-center text-xs font-semibold text-brand-green">
          Logo &amp; identity
        </div>
        <div class="grid aspect-[3/4] w-1/3 shrink-0 place-items-center rounded-xl bg-white/90 text-center text-xs font-semibold text-brand-green/60">
          Our values
        </div>
        <div class="grid aspect-[3/4] w-1/3 shrink-0 place-items-center rounded-xl bg-white/90 text-center text-xs font-semibold text-brand-green/60">
          More products
        </div>
      </div>
      <div class="mt-3 flex justify-center gap-1.5">
        <span class="h-1.5 w-5 rounded-full bg-brand-orange"></span>
        <span class="h-1.5 w-1.5 rounded-full bg-brand-green/20"></span>
        <span class="h-1.5 w-1.5 rounded-full bg-brand-green/20"></span>
      </div>
    </div>
  </PageHero>

  <!-- 02 — Selected Brand Story work -->
  <section id="brand-story-work" class="container-x scroll-mt-24 py-12 md:py-24" aria-labelledby="work-heading">
    <SectionHeading
      eyebrow="Selected Brand Story work"
      id="work-heading"
      title="Help shoppers see the brand, not just another product."
      text="When similar products sit side by side, price can become the easiest point of comparison. A clear Brand Story gives customers more context: who you are, what matters to your brand, and what else you offer."
    />
    <ul class="grid gap-6 sm:grid-cols-3">
      {work.map((w, i) => (
        <li>
          <figure>
            <div class:list={['placeholder aspect-[3/4] text-xs', i === 0 && 'bg-brand-yellow-soft']}>{w.kind}</div>
            <figcaption class="mt-3">
              <span class="block text-xs font-bold uppercase tracking-[0.18em] text-brand-green/60">{w.kind}</span>
              <span class="mt-1 block font-display text-lg font-extrabold leading-snug text-brand-green">
                {w.purpose}
              </span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
    <a
      href={withBase(service.portfolio)}
      class="mt-8 inline-flex min-h-11 items-center font-semibold text-brand-green underline decoration-brand-yellow decoration-2 underline-offset-4 hover:decoration-brand-orange"
    >
      Explore Our Amazon Creative Work →
    </a>
  </section>

  <!-- 03 — What we design -->
  <section class="bg-brand-cream py-12 md:py-24" aria-labelledby="design-heading">
    <div class="container-x">
      <SectionHeading
        eyebrow="What we design"
        id="design-heading"
        title="A brand story shoppers can explore."
        align="left"
      />
      <ul class="grid gap-4 md:grid-cols-3">
        {parts.map((p) => (
          <li class="rounded-[1.5rem] bg-white p-6 shadow-sm sm:rounded-[1.75rem] sm:p-7">
            <h3 class="text-lg font-extrabold leading-snug text-brand-green sm:text-xl">{p.t}</h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-brand-ink/70 sm:text-base">{p.d}</p>
          </li>
        ))}
      </ul>
      <p class="mt-8 max-w-3xl font-display text-xl font-extrabold leading-snug text-brand-green sm:text-2xl">
        We recommend the story and cards that fit your brand.{' '}
        <span class="marker">You can commission Brand Story on its own</span> — without purchasing A+ Content, a
        Storefront redesign, or new product photography.
      </p>
    </div>
  </section>

  <!-- 04 — How we work -->
  <section class="container-x py-12 md:py-24" aria-labelledby="process-heading">
    <SectionHeading
      eyebrow="How we work"
      id="process-heading"
      title="Tell the story your brand can stand behind."
      align="left"
    />
    <ol class="grid gap-10 md:grid-cols-3 md:gap-0 md:divide-x md:divide-dashed md:divide-brand-green/20">
      {steps.map((s, i) => (
        <li class="md:px-8 md:first:pl-0 md:last:pr-0">
          <span class="step-num font-display text-5xl font-extrabold text-brand-yellow sm:text-6xl" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="mt-3 text-2xl font-extrabold leading-tight text-brand-green">{s.t}</h3>
          <p class="mt-2 text-brand-ink/70">{s.d}</p>
        </li>
      ))}
    </ol>
    <p class="mt-10 max-w-3xl rounded-[1.5rem] bg-brand-yellow-soft p-5 text-brand-ink/80 sm:p-6 md:mt-14">
      Already have a brand kit and photos? We can work from approved assets. If new
      <a
        href={withBase('/services/amazon-product-photography')}
        class="font-bold text-brand-green underline underline-offset-4"
      >
        photography
      </a>
      , a broader rebrand, or help submitting in Seller Central is needed, we’ll scope it separately.
    </p>
  </section>

  <!-- 05 — Frequently asked questions -->
  <section class="bg-brand-cream" aria-labelledby="faq-heading">
    <div class="container-x grid gap-8 py-12 md:grid-cols-[1fr_1.6fr] md:gap-12 md:py-24">
      <div>
        <p class="eyebrow mb-4">Frequently asked questions</p>
        <h2 id="faq-heading" class="text-[1.85rem] font-extrabold leading-tight text-brand-green sm:text-4xl">
          Questions About Amazon Brand Story Design
        </h2>
      </div>
      <FaqList faqs={faqs} variant="card" />
    </div>
  </section>

  <!-- Related pages: parent offer and adjacent services -->
  <nav class="container-x pt-12 md:pt-16" aria-labelledby="related-heading">
    <h2 id="related-heading" class="mb-6 text-center text-xl font-bold text-brand-green">
      Part of our Amazon Listing Optimization services
    </h2>
    <ul class="flex flex-wrap justify-center gap-3">
      {related.map((r) => (
        <li>
          <a
            href={withBase(r.href)}
            class:list={[
              'inline-block rounded-full px-4 py-2 text-sm font-medium transition',
              r.primary
                ? 'bg-brand-green text-white hover:bg-brand-yellow hover:text-brand-green'
                : 'border border-brand-green/20 text-brand-green hover:border-brand-yellow hover:bg-brand-yellow',
            ]}
          >
            {r.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- 06 — Final CTA -->
  <CtaBanner
    title="Your products have a story. Let shoppers see the brand behind them."
    text="Show us your Amazon listing and what you want your brand to stand for. We’ll help you explore a Brand Story that feels true to your business and connects the products you sell."
    ctaLabel="Talk to a Human"
    ctaHref={BOOKING_PAGE}
    note="Choose a time to speak directly with our team."
  />
</Layout>
