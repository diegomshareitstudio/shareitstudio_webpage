---
/**
 * Amazon Storefront Design (copy V1): P2 commercial landing page for "amazon storefront design services".
 * Hero → Selected work → What we design → How we work → FAQ → Final CTA.
 * A seller's Amazon Brand Store, not an Influencer storefront. Definitions and how-to stay in /blog/amazon-storefront
 * (linked from the FAQ, never duplicated here). No PPC, Brand Registry, photography or maintenance by default, and
 * no traffic or sales promises.
 */
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';
import FaqList from '../../components/ui/FaqList.astro';
import { getService } from '../../data/services';
import { faqSchema, serviceSchema } from '../../lib/schema';

const path = '/services/amazon-storefront-design';
const bookHref = '/book-a-call'; // TODO: verified Calendly appointment URL
const service = getService('amazon-storefront-design');
const faqs = service.faqs!;

// 02 — approved, real Store screenshots, captioned with the shopper problem each one addresses (no sales claims).
// TODO: real screenshots with permission (YUNGPRIME is a candidate once its Storefront work is verified)
const work = [
  { kind: 'Branded Store homepage', problem: 'Shoppers can’t tell what the brand sells.' },
  { kind: 'Category & collection page', problem: 'Related products are hard to find.' },
  { kind: 'Mobile Store layout', problem: 'The Store is hard to browse on a phone.' },
];

// 03 — what we design
const parts = [
  {
    t: 'A Branded Storefront Homepage',
    d: 'Introduce your brand with clear messaging, coordinated visuals, and a first impression that helps shoppers recognize what you sell.',
  },
  {
    t: 'Product Collections & Easy Navigation',
    d: 'Organize categories, product lines, or related items into intuitive Store pages so customers can explore beyond the product that first brought them to you.',
  },
  {
    t: 'Shoppable Visuals & Brand Content',
    d: 'Bring products and their uses to life with approved images, banners, and Amazon-supported content modules. Layouts are planned for both desktop and mobile viewing.',
  },
];

// 04 — how we work
const steps = [
  {
    t: 'Understand your brand and catalog',
    d: 'We review your existing Store, products, brand assets, and the categories or connections shoppers may be missing.',
  },
  {
    t: 'Plan the Store structure',
    d: 'We recommend the page hierarchy, product groupings, navigation, and content needed to make the Store easy to explore.',
  },
  {
    t: 'Design, review & deliver',
    d: 'We create the agreed layouts and assets for Amazon’s Brand Store builder, review them with your team, and prepare the approved deliverables for the agreed scope. Store setup, uploading, and submission support are confirmed separately in your quote.',
  },
];

// Related pages: parent offer, sibling services and the guide that owns the informational intent
const related = [
  { label: 'Amazon Listing Optimization', href: '/services/amazon-listing-optimization', primary: true },
  { label: 'Amazon Brand Story Design', href: '/services/amazon-brand-story-design' },
  { label: 'Amazon A+ Content Design', href: '/services/amazon-a-plus-content' },
  { label: 'Amazon Storefront Guide', href: '/blog/amazon-storefront' },
];

const description =
  'Custom Amazon Storefront design for brands: homepages, product collections, navigation and mobile-friendly visuals. Request a tailored Store design quote.';

const breadcrumbs = [
  { name: 'Services', path: '/services' },
  { name: 'Amazon Listing Optimization', path: '/services/amazon-listing-optimization' },
  { name: 'Amazon Storefront Design', path },
];
const schema = [
  serviceSchema({
    path,
    name: 'Amazon Storefront Design Services',
    serviceType: 'Amazon Brand Store design',
    description:
      'Design of Amazon Brand Stores for sellers: a branded homepage, product collection pages, navigation, and desktop and mobile layouts for Amazon’s Store builder.',
  }),
  faqSchema(path, faqs),
];
---

<Layout title="Amazon Storefront Design Services | Share It Studio" description={description} breadcrumbs={breadcrumbs} schema={schema}>
  <!-- 01 — Hero -->
  <PageHero
    eyebrow="Amazon Storefront design services"
    title="Amazon Storefront Design That Makes Your Catalog Easier to Explore"
    highlight="Easier to Explore"
    subtitle={`<strong class="block font-display text-xl font-extrabold leading-snug text-brand-green md:text-2xl">Your products belong together. Does your Amazon presence show it?</strong><span class="mt-4 block">Customers may discover one of your products without ever seeing the rest of your range. We design branded Amazon Stores with clear navigation, compelling visuals, and thoughtfully organized product collections — giving shoppers a place to explore more of what your brand offers.</span><span class="mt-3 block text-sm font-semibold text-brand-green">Need a new Brand Store or a redesign of your existing one? We can scope Storefront Design on its own, without requiring a full listing refresh.</span>`}
    ctaLabel="Talk to a Human"
    ctaHref={bookHref}
    secondaryLabel="See Our Storefront Work"
    secondaryHref="#storefront-work"
  >
    <p class="mt-4 text-sm text-brand-ink/60">Share your Amazon brand and tell us what you’d like shoppers to discover.</p>

    <!-- TODO: a real, approved Brand Store on desktop with a matching mobile preview (not an Influencer storefront) -->
    <div slot="visual" class="relative pb-6" aria-hidden="true">
      <div class="overflow-hidden rounded-[1.75rem] bg-white shadow-xl">
        <div class="placeholder aspect-[16/6] rounded-none border-0 bg-brand-green text-xs text-white/60">Brand header</div>
        <div class="flex gap-2 border-b border-brand-green/10 px-4 py-3">
          {['Home', 'Collections', 'Best sellers', 'About'].map((t, i) => (
            <span class:list={['rounded-full px-3 py-1 text-[0.65rem] font-semibold', i === 0 ? 'bg-brand-yellow text-brand-green' : 'bg-brand-cream text-brand-green/60']}>{t}</span>
          ))}
        </div>
        <div class="grid grid-cols-3 gap-2 p-4">
          {Array.from({ length: 3 }, () => <div class="placeholder aspect-square rounded-xl text-[0.6rem]">Product</div>)}
        </div>
      </div>
      <div class="placeholder absolute -bottom-2 -left-2 aspect-[9/16] w-1/4 rotate-[-5deg] border-solid border-brand-green bg-brand-green text-xs text-white/60 shadow-2xl sm:-left-6">
        Mobile
      </div>
    </div>
  </PageHero>

  <!-- 02 — Selected Storefront work -->
  <section id="storefront-work" class="container-x scroll-mt-24 py-12 md:py-24" aria-labelledby="work-heading">
    <SectionHeading
      eyebrow="Selected Storefront work"
      id="work-heading"
      title="One brand. More than one product to discover."
      text="When products live in separate listings, shoppers may miss the collections, complementary items, and brand context that connect them. A well-organized Storefront helps people understand the range — and find where they want to go next."
    />
    <ul class="grid gap-6 sm:grid-cols-3">
      {work.map((w, i) => (
        <li>
          <figure>
            <div class:list={['placeholder aspect-[4/3] text-xs', i === 1 && 'bg-brand-yellow-soft']}>{w.kind}</div>
            <figcaption class="mt-3">
              <span class="block text-xs font-bold uppercase tracking-[0.18em] text-brand-green/60">{w.kind}</span>
              <span class="mt-1 block font-display text-lg font-extrabold leading-snug text-brand-green">{w.problem}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
    <a href={service.portfolio} class="mt-8 inline-flex min-h-11 items-center font-semibold text-brand-green underline decoration-brand-yellow decoration-2 underline-offset-4 hover:decoration-brand-orange">
      Explore Our Amazon Creative Work →
    </a>
  </section>

  <!-- 03 — What we design -->
  <section class="bg-brand-cream py-12 md:py-24" aria-labelledby="design-heading">
    <div class="container-x">
      <SectionHeading eyebrow="What we design" id="design-heading" title="A place for shoppers to discover your whole brand." align="left" />
      <ul class="grid gap-4 md:grid-cols-3">
        {parts.map((p) => (
          <li class="rounded-[1.5rem] bg-white p-6 shadow-sm sm:rounded-[1.75rem] sm:p-7">
            <h3 class="text-lg font-extrabold leading-snug text-brand-green sm:text-xl">{p.t}</h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-brand-ink/70 sm:text-base">{p.d}</p>
          </li>
        ))}
      </ul>
      <p class="mt-8 max-w-3xl font-display text-xl font-extrabold leading-snug text-brand-green sm:text-2xl">
        We recommend the number of pages and creative assets <span class="marker">your catalog actually needs.</span>
      </p>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-brand-ink/60">
        A Storefront can be commissioned by itself; new photography, product videos, extra pages, and ongoing updates are scoped separately when needed.
      </p>
    </div>
  </section>

  <!-- 04 — How we work -->
  <section class="container-x py-12 md:py-24" aria-labelledby="process-heading">
    <SectionHeading eyebrow="How we work" id="process-heading" title="Turn your product catalog into a clearer shopping experience." align="left" />
    <ol class="grid gap-10 md:grid-cols-3 md:gap-0 md:divide-x md:divide-dashed md:divide-brand-green/20">
      {steps.map((s, i) => (
        <li class="md:px-8 md:first:pl-0 md:last:pr-0">
          <span class="step-num font-display text-5xl font-extrabold text-brand-yellow sm:text-6xl" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-3 text-2xl font-extrabold leading-tight text-brand-green">{s.t}</h3>
          <p class="mt-2 text-brand-ink/70">{s.d}</p>
        </li>
      ))}
    </ol>
    <p class="mt-10 max-w-3xl rounded-[1.5rem] bg-brand-yellow-soft p-5 text-brand-ink/80 sm:p-6 md:mt-14">
      Already have brand guidelines,
      <a href="/services/amazon-listing-images" class="font-bold text-brand-green underline underline-offset-4">listing images</a>, or
      <a href="/services/amazon-product-video-production" class="font-bold text-brand-green underline underline-offset-4">product videos</a>? We can work with approved assets rather than recreating everything from scratch.
    </p>
  </section>

  <!-- 05 — Frequently asked questions -->
  <section class="bg-brand-cream" aria-labelledby="faq-heading">
    <div class="container-x grid gap-8 py-12 md:grid-cols-[1fr_1.6fr] md:gap-12 md:py-24">
      <div>
        <p class="eyebrow mb-4">Frequently asked questions</p>
        <h2 id="faq-heading" class="text-[1.85rem] font-extrabold leading-tight text-brand-green sm:text-4xl">Questions About Amazon Storefront Design</h2>
      </div>
      <FaqList faqs={faqs} variant="card" />
    </div>
  </section>

  <!-- Related pages: parent offer, sibling services and guide -->
  <nav class="container-x pt-12 md:pt-16" aria-labelledby="related-heading">
    <h2 id="related-heading" class="mb-6 text-center text-xl font-bold text-brand-green">Part of our Amazon Listing Optimization services</h2>
    <ul class="flex flex-wrap justify-center gap-3">
      {related.map((r) => (
        <li>
          <a
            href={r.href}
            class:list={[
              'inline-block rounded-full px-4 py-2 text-sm font-medium transition',
              r.primary
                ? 'bg-brand-green text-white hover:bg-brand-yellow hover:text-brand-green'
                : 'border border-brand-green/20 text-brand-green hover:border-brand-yellow hover:bg-brand-yellow',
            ]}
          >
            {r.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- 06 — Final CTA -->
  <CtaBanner
    title="Your catalog deserves more than disconnected product pages."
    text="Show us your products and what you want shoppers to discover. We’ll help you explore a Brand Store that makes your collection feel connected and gives customers a clearer place to browse."
    ctaLabel="Talk to a Human"
    ctaHref={bookHref}
    note="Choose a time to speak directly with our team."
  />
</Layout>
