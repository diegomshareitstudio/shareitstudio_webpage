---
/**
 * Amazon Storefront Design (copy V1): P2 commercial landing page for "amazon storefront design services".
 * Hero → Selected work (bento) → What we design (zig-zag) → How we work (dark timeline) → FAQ → Final CTA.
 * A seller's Amazon Brand Store, not an Influencer storefront. Definitions and how-to stay in /blog/amazon-storefront
 * (linked from the FAQ, never duplicated here). No PPC, Brand Registry, photography or maintenance by default, and
 * no traffic or sales promises.
 */
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';
import FaqList from '../../components/ui/FaqList.astro';
import ImageSlot from '../../components/ui/ImageSlot.astro';
import TextMarquee from '../../components/ui/TextMarquee.astro';
import { getService } from '../../data/services';
import { faqSchema, serviceSchema } from '../../lib/schema';

const path = '/services/amazon-storefront-design';
const bookHref = '/book-a-call'; // TODO: verified Calendly appointment URL
const service = getService('amazon-storefront-design');
const faqs = service.faqs!;

// 02 — approved, real Store screenshots, captioned with the shopper problem each one addresses (no sales claims).
// TODO: real screenshots with permission (YUNGPRIME is a candidate once its Storefront work is verified)
const work = {
  home: { kind: 'Branded Store homepage', problem: 'Shoppers can’t tell what the brand sells.' },
  collection: { kind: 'Category & collection page', problem: 'Related products are hard to find.' },
  mobile: { kind: 'Mobile Store layout', problem: 'The Store is hard to browse on a phone.' },
};

// 03 — what we design. `image` says which visual goes in each slot.
const parts = [
  {
    t: 'A Branded Storefront Homepage',
    d: 'Introduce your brand with clear messaging, coordinated visuals, and a first impression that helps shoppers recognize what you sell.',
    tag: 'Homepage',
    image: 'Store homepage hero banner',
  },
  {
    t: 'Product Collections & Easy Navigation',
    d: 'Organize categories, product lines, or related items into intuitive Store pages so customers can explore beyond the product that first brought them to you.',
    tag: 'Collections',
    image: 'Collection page with navigation',
  },
  {
    t: 'Shoppable Visuals & Brand Content',
    d: 'Bring products and their uses to life with approved images, banners, and Amazon-supported content modules. Layouts are planned for both desktop and mobile viewing.',
    tag: 'Desktop + mobile',
    image: 'Shoppable lifestyle tile',
  },
];

// 04 — how we work
const steps = [
  {
    t: 'Understand your brand and catalog',
    d: 'We review your existing Store, products, brand assets, and the categories or connections shoppers may be missing.',
  },
  {
    t: 'Plan the Store structure',
    d: 'We recommend the page hierarchy, product groupings, navigation, and content needed to make the Store easy to explore.',
  },
  {
    t: 'Design, review & deliver',
    d: 'We create the agreed layouts and assets for Amazon’s Brand Store builder, review them with your team, and prepare the approved deliverables for the agreed scope. Store setup, uploading, and submission support are confirmed separately in your quote.',
  },
];

// Related pages: parent offer, sibling services and the guide that owns the informational intent
const related = [
  { label: 'Amazon Listing Optimization', href: '/services/amazon-listing-optimization', primary: true },
  { label: 'Amazon Brand Story Design', href: '/services/amazon-brand-story-design' },
  { label: 'Amazon A+ Content Design', href: '/services/amazon-a-plus-content' },
  { label: 'Amazon Storefront Guide', href: '/blog/amazon-storefront' },
];

const description =
  'Custom Amazon Storefront design for brands: homepages, product collections, navigation and mobile-friendly visuals. Request a tailored Store design quote.';

const breadcrumbs = [
  { name: 'Services', path: '/services' },
  { name: 'Amazon Listing Optimization', path: '/services/amazon-listing-optimization' },
  { name: 'Amazon Storefront Design', path },
];
const schema = [
  serviceSchema({
    path,
    name: 'Amazon Storefront Design Services',
    serviceType: 'Amazon Brand Store design',
    description:
      'Design of Amazon Brand Stores for sellers: a branded homepage, product collection pages, navigation, and desktop and mobile layouts for Amazon’s Store builder.',
  }),
  faqSchema(path, faqs),
];
---

<Layout title="Amazon Storefront Design Services | Share It Studio" description={description} breadcrumbs={breadcrumbs} schema={schema}>
  <!-- 01 — Hero -->
  <PageHero
    eyebrow="Amazon Storefront design services"
    title="Amazon Storefront Design That Makes Your Catalog Easier to Explore"
    highlight="Easier to Explore"
    subtitle={`<strong class="block font-display text-xl font-extrabold leading-snug text-brand-green md:text-2xl">Your products belong together. Does your Amazon presence show it?</strong><span class="mt-4 block">Customers may discover one of your products without ever seeing the rest of your range. We design branded Amazon Stores with clear navigation, compelling visuals, and thoughtfully organized product collections — giving shoppers a place to explore more of what your brand offers.</span><span class="mt-3 block text-sm font-semibold text-brand-green">Need a new Brand Store or a redesign of your existing one? We can scope Storefront Design on its own, without requiring a full listing refresh.</span>`}
    ctaLabel="Talk to a Human"
    ctaHref={bookHref}
    secondaryLabel="See Our Storefront Work"
    secondaryHref="#storefront-work"
  >
    <p class="mt-4 text-sm text-brand-ink/60">Share your Amazon brand and tell us what you’d like shoppers to discover.</p>

    <!-- TODO: a real, approved Brand Store on desktop with a matching mobile preview (not an Influencer storefront) -->
    <div slot="visual" class="relative pb-16 pl-6 pt-4 sm:pl-10" aria-hidden="true">
      <span class="motion-float absolute -top-2 right-8 h-16 w-16 rounded-full bg-brand-yellow" data-depth="24"></span>
      <span class="motion-float absolute bottom-24 -right-3 h-9 w-9 rotate-12 rounded-xl bg-brand-orange" data-depth="16"></span>
      <span class="star-spin absolute left-0 top-6 text-4xl text-brand-orange">✦</span>

      <!-- Desktop Store in a browser window -->
      <div class="relative overflow-hidden rounded-[1.25rem] bg-white shadow-2xl ring-1 ring-brand-green/10 sm:rounded-[1.5rem]">
        <div class="flex items-center gap-1.5 border-b border-brand-green/10 px-4 py-2.5">
          <span class="h-2.5 w-2.5 rounded-full bg-brand-orange/70"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-brand-yellow"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-brand-green/30"></span>
          <span class="ml-3 flex-1 truncate rounded-full bg-brand-cream px-3 py-1 text-[0.65rem] text-brand-green/50">amazon.com/stores/your-brand</span>
        </div>
        <ImageSlot label="Brand banner" tone="green" class="aspect-[16/5] rounded-none border-0 text-xs" />
        <div class="flex gap-1.5 overflow-hidden px-4 py-3">
          {['Home', 'Collections', 'Best sellers', 'About'].map((t, i) => (
            <span class:list={['shrink-0 rounded-full px-3 py-1 text-[0.65rem] font-semibold', i === 1 ? 'bg-brand-yellow text-brand-green' : 'bg-brand-cream text-brand-green/60']}>{t}</span>
          ))}
        </div>
        <div class="grid grid-cols-4 gap-2 px-4 pb-4">
          {Array.from({ length: 4 }, (_, i) => (
            <div class:list={['aspect-square rounded-xl', i === 1 ? 'bg-brand-yellow-soft' : 'bg-brand-cream']}></div>
          ))}
        </div>
      </div>

      <!-- Matching mobile Store -->
      <div class="absolute bottom-0 left-0 w-[24%] max-w-[8rem] rotate-[-6deg] overflow-hidden rounded-[1.4rem] border-[5px] border-brand-green bg-white shadow-2xl">
        <div class="aspect-[16/9] bg-brand-green-light"></div>
        <div class="grid grid-cols-2 gap-1.5 p-2">
          {Array.from({ length: 4 }, (_, i) => <div class:list={['aspect-square rounded-lg', i === 0 ? 'bg-brand-yellow-soft' : 'bg-brand-cream']}></div>)}
        </div>
      </div>

      <span class="absolute -right-2 top-16 rotate-3 rounded-full bg-brand-yellow px-4 py-2 text-sm font-semibold text-brand-green shadow-lg">Product collections</span>
      <span class="absolute bottom-3 right-6 -rotate-2 rounded-full bg-white px-4 py-2 text-sm font-semibold text-brand-green shadow-lg ring-1 ring-brand-green/10">Desktop + mobile</span>
    </div>
  </PageHero>

  <TextMarquee words={['One brand', 'Every collection', 'Easier to explore', 'Desktop & mobile']} />

  <!-- 02 — Selected Storefront work: a bento of the three Store views -->
  <section id="storefront-work" class="container-x scroll-mt-24 py-12 md:py-24" aria-labelledby="work-heading">
    <SectionHeading
      eyebrow="Selected Storefront work"
      id="work-heading"
      title="One brand. More than one product to discover."
      text="When products live in separate listings, shoppers may miss the collections, complementary items, and brand context that connect them. A well-organized Storefront helps people understand the range — and find where they want to go next."
    />
    <ul class="grid gap-4 sm:gap-5 lg:grid-cols-3 lg:grid-rows-2">
      <li class="relative lg:col-span-2 lg:row-span-2">
        <ImageSlot label="Store homepage screenshot" class="h-full min-h-[18rem] sm:min-h-[24rem]" />
        <div class="absolute inset-x-3 bottom-3 rounded-2xl bg-white/95 p-4 shadow-lg backdrop-blur sm:inset-x-5 sm:bottom-5 sm:max-w-md sm:p-5">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-orange">01 · {work.home.kind}</p>
          <h3 class="mt-1 font-display text-lg font-extrabold leading-snug text-brand-green sm:text-xl">{work.home.problem}</h3>
        </div>
      </li>
      <li class="relative">
        <ImageSlot label="Collection page screenshot" tone="yellow" class="h-full min-h-[15rem]" />
        <div class="absolute inset-x-3 bottom-3 rounded-2xl bg-white/95 p-4 shadow-lg backdrop-blur">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-orange">02 · {work.collection.kind}</p>
          <h3 class="mt-1 font-display text-base font-extrabold leading-snug text-brand-green">{work.collection.problem}</h3>
        </div>
      </li>
      <li class="flex items-center gap-5 overflow-hidden rounded-[1.75rem] bg-brand-green p-5 sm:p-6">
        <div class="w-24 shrink-0 rotate-[-4deg] overflow-hidden rounded-[1.1rem] border-4 border-brand-yellow sm:w-28">
          <ImageSlot label="Mobile" tone="green" class="aspect-[9/16] rounded-none border-0 px-1 text-[0.65rem]" />
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-yellow">03 · {work.mobile.kind}</p>
          <h3 class="mt-1 font-display text-base font-extrabold leading-snug text-white sm:text-lg">{work.mobile.problem}</h3>
        </div>
      </li>
    </ul>
    <a href={service.portfolio} class="mt-8 inline-flex min-h-11 items-center font-semibold text-brand-green underline decoration-brand-yellow decoration-2 underline-offset-4 hover:decoration-brand-orange">
      Explore Our Amazon Creative Work →
    </a>
  </section>

  <!-- 03 — What we design: alternating image / text rows -->
  <section class="bg-brand-cream py-12 md:py-24" aria-labelledby="design-heading">
    <div class="container-x">
      <SectionHeading eyebrow="What we design" id="design-heading" title="A place for shoppers to discover your whole brand." align="left" />
      <ol class="space-y-12 md:space-y-20">
        {parts.map((p, i) => (
          <li class="grid items-center gap-6 md:grid-cols-2 md:gap-14">
            <div class:list={['relative', i % 2 === 1 && 'md:order-2']}>
              <ImageSlot label={p.image} tone={i === 1 ? 'yellow' : 'white'} class:list={['aspect-[4/3] shadow-sm', i % 2 ? 'rotate-1' : '-rotate-1']} />
              <span class:list={['absolute -top-3 rounded-full px-4 py-1.5 text-xs font-bold uppercase tracking-wider shadow-md', i % 2 ? '-right-2 rotate-3 bg-brand-green text-brand-yellow' : '-left-2 -rotate-3 bg-brand-yellow text-brand-green']}>
                {p.tag}
              </span>
            </div>
            <div>
              <span class="step-num font-display text-5xl font-extrabold leading-none text-brand-orange sm:text-6xl" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-3 text-2xl font-extrabold leading-tight text-brand-green sm:text-3xl">{p.t}</h3>
              <p class="mt-3 max-w-lg text-lg leading-relaxed text-brand-ink/70">{p.d}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="mt-14 border-t border-dashed border-brand-green/20 pt-8 md:mt-20">
        <p class="max-w-3xl font-display text-xl font-extrabold leading-snug text-brand-green sm:text-2xl">
          We recommend the number of pages and creative assets <span class="marker">your catalog actually needs.</span>
        </p>
        <p class="mt-3 max-w-3xl text-sm leading-relaxed text-brand-ink/60">
          A Storefront can be commissioned by itself; new photography, product videos, extra pages, and ongoing updates are scoped separately when needed.
        </p>
      </div>
    </div>
  </section>

  <!-- 04 — How we work: dark timeline -->
  <section class="relative overflow-hidden bg-brand-green py-12 md:py-24" aria-labelledby="process-heading">
    <span class="pointer-events-none absolute -right-20 -top-20 h-64 w-64 rounded-full border-[28px] border-brand-yellow/20" aria-hidden="true"></span>
    <span class="star-spin pointer-events-none absolute bottom-10 left-[8%] text-4xl text-brand-orange/60" aria-hidden="true">✦</span>
    <div class="container-x relative">
      <p class="eyebrow mb-4 text-brand-yellow">How we work</p>
      <h2 id="process-heading" class="max-w-3xl text-[1.7rem] font-extrabold leading-tight text-white sm:text-3xl md:text-[2.6rem]">
        Turn your product catalog into a clearer shopping experience.
      </h2>
      <div class="relative mt-10 md:mt-14">
        <span class="absolute left-7 right-7 top-7 hidden border-t-2 border-dashed border-white/20 md:block" aria-hidden="true"></span>
        <ol class="relative grid gap-5 md:grid-cols-3 md:gap-6">
          {steps.map((s, i) => (
            <li>
              <span class="step-num grid h-14 w-14 place-items-center rounded-full bg-brand-yellow font-display text-xl font-extrabold text-brand-green shadow-lg ring-8 ring-brand-green" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-5 text-xl font-extrabold text-white sm:text-2xl">{s.t}</h3>
              <p class="mt-2 text-white/70">{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
      <div class="mt-12 grid items-center gap-5 rounded-[1.5rem] bg-brand-yellow p-5 text-brand-green sm:grid-cols-[auto_1fr] sm:p-6 md:mt-16">
        <span class="grid h-12 w-12 place-items-center rounded-full bg-brand-green text-xl text-brand-yellow" aria-hidden="true">✦</span>
        <p class="font-medium">
          Already have brand guidelines,{' '}
          <a href="/services/amazon-listing-images" class="font-bold underline underline-offset-4">listing images</a>, or{' '}
          <a href="/services/amazon-product-video-production" class="font-bold underline underline-offset-4">product videos</a>? We can work with approved assets rather than recreating everything from scratch.
        </p>
      </div>
    </div>
  </section>

  <!-- 05 — Frequently asked questions: sticky intro with an image slot and a nudge to talk -->
  <section class="bg-brand-cream" aria-labelledby="faq-heading">
    <div class="container-x grid gap-8 py-12 md:grid-cols-[1fr_1.6fr] md:gap-12 md:py-24">
      <div class="md:sticky md:top-28 md:self-start">
        <p class="eyebrow mb-4">Frequently asked questions</p>
        <h2 id="faq-heading" class="text-[1.85rem] font-extrabold leading-tight text-brand-green sm:text-4xl">Questions About Amazon Storefront Design</h2>
        <!-- TODO: approved photo of the team reviewing a Store plan -->
        <ImageSlot label="Team planning a Store layout" tone="white" class="mt-8 hidden aspect-[4/3] md:flex" />
        <div class="mt-6 rounded-[1.5rem] bg-white p-5 shadow-sm">
          <p class="text-sm text-brand-ink/70">Choose a time to speak directly with our team.</p>
          <a href={bookHref} class="btn-dark mt-4">Talk to a Human</a>
        </div>
      </div>
      <FaqList faqs={faqs} variant="card" />
    </div>
  </section>

  <!-- Related pages: parent offer, sibling services and guide -->
  <nav class="container-x pt-12 md:pt-16" aria-labelledby="related-heading">
    <h2 id="related-heading" class="mb-6 text-center text-xl font-bold text-brand-green">Part of our Amazon Listing Optimization services</h2>
    <ul class="flex flex-wrap justify-center gap-3">
      {related.map((r) => (
        <li>
          <a
            href={r.href}
            class:list={[
              'inline-block rounded-full px-4 py-2 text-sm font-medium transition',
              r.primary
                ? 'bg-brand-green text-white hover:bg-brand-yellow hover:text-brand-green'
                : 'border border-brand-green/20 text-brand-green hover:border-brand-yellow hover:bg-brand-yellow',
            ]}
          >
            {r.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- 06 — Final CTA -->
  <CtaBanner
    title="Your catalog deserves more than disconnected product pages."
    text="Show us your products and what you want shoppers to discover. We’ll help you explore a Brand Store that makes your collection feel connected and gives customers a clearer place to browse."
    ctaLabel="Talk to a Human"
    ctaHref={bookHref}
    note="Choose a time to speak directly with our team."
    prominent
  />
</Layout>
