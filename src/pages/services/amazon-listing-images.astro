---
/**
 * Amazon Listing Images (copy V1): P1 commercial landing page for "amazon listing images design services".
 * Hero → Selected work → What we design → How we work → FAQ → Final CTA.
 * Hiring intent only: image rules and tips live in the blog guides (linked from the FAQ), and the full listing offer
 * lives on /services/amazon-listing-optimization. Shorter and more visual than that page: no sales-lift claims and
 * no case-study section.
 */
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';
import FaqList from '../../components/ui/FaqList.astro';
import { getService } from '../../data/services';
import { faqSchema, serviceSchema } from '../../lib/schema';
import oldListing from '../../assets/case-studies/super-ninja/old-listing.png';
import newListing from '../../assets/case-studies/super-ninja/new-listing.png';
import { BOOKING_PAGE } from '../../config/site';

const path = '/services/amazon-listing-images';
const service = getService('amazon-listing-images');
const faqs = service.faqs!;

// 02 — three approved, real examples, captioned with the buyer question each one answers (no sales results)
// TODO: approved images (descriptive file names + accurate alt text) replace these placeholders
const work = [
  { kind: 'Main product image', question: 'What exactly am I buying?' },
  { kind: 'Product-benefit infographic', question: 'What does it do for me?' },
  { kind: 'Lifestyle & size reference', question: 'How big is it, and where would I use it?' },
];

// 03 — what we design
const types = [
  {
    t: 'Main Product Images',
    d: 'A clear, accurate first impression for Amazon search results and your product page, designed around applicable main-image requirements.',
  },
  {
    t: 'Amazon Product Infographics',
    d: 'Turn features, benefits, dimensions, and what’s included into information shoppers can understand at a glance.',
  },
  {
    t: 'Lifestyle & In-Use Images',
    d: 'Show your product in context, helping shoppers picture how and where they would use it.',
  },
  {
    t: 'Product Detail & Scale Images',
    d: 'Make materials, important details, fit, and size easier to judge before purchase.',
  },
];

// 04 — how we work
const steps = [
  {
    t: 'Understand your product',
    d: 'We review your listing, product details, competitor examples, and the questions shoppers need answered.',
  },
  {
    t: 'Plan the gallery',
    d: 'We recommend the images that matter most, from a new main image to a focused set of secondary visuals.',
  },
  {
    t: 'Design & review',
    d: 'We create the agreed images using suitable product photography and design assets, review product accuracy, and prepare the files for your approved scope and Amazon’s applicable guidelines.',
  },
];

// Related pages: parent offer, sibling service and the guides that own the informational intent
const related = [
  { label: 'Amazon Listing Optimization', href: '/services/amazon-listing-optimization', primary: true },
  { label: 'Amazon A+ Content Design', href: '/services/amazon-a-plus-content' },
  { label: 'Amazon Image Requirements', href: '/blog/amazon-images-requirements' },
  { label: 'Amazon Product Image Best Practices', href: '/blog/amazon-product-images-best-practices' },
];

const description =
  'Amazon listing image design for main images, infographics, and lifestyle visuals. Help shoppers understand your product. Request a custom quote.';

const breadcrumbs = [
  { name: 'Services', path: '/services' },
  { name: 'Amazon Listing Optimization', path: '/services/amazon-listing-optimization' },
  { name: 'Amazon Listing Images', path },
];
const schema = [
  serviceSchema({
    path,
    name: 'Amazon Listing Image Design Services',
    serviceType: 'Amazon listing image design',
    description:
      'Amazon listing image design: main product images, product infographics, lifestyle and in-use images, and detail and scale images for the Amazon product gallery.',
  }),
  faqSchema(path, faqs),
];
---

<Layout
  title="Amazon Listing Image Design Services | Share It Studio"
  description={description}
  breadcrumbs={breadcrumbs}
  schema={schema}
>
  <!-- 01 — Hero -->
  <PageHero
    eyebrow="Amazon listing image design services"
    title="Amazon Listing Images That Make Your Product Easier to Choose"
    highlight="Easier to Choose"
    subtitle={`We design Amazon main images, product infographics, and lifestyle gallery visuals that help shoppers see what they’re buying, how it works, and what makes it different.<span class="mt-3 block">Need a single image or a complete gallery refresh? We’ll build the creative scope around your product.</span>`}
    ctaLabel="Talk to a Human"
    ctaHref={BOOKING_PAGE}
    secondaryLabel="See Our Listing Image Work"
    secondaryHref="#listing-image-work"
  >
    <p class="mt-4 text-sm text-brand-ink/60">Choose a time to speak directly with our team.</p>

    <!-- TODO: an approved real main image next to two secondary images from the same product -->
    <div slot="visual" class="grid grid-cols-[1.6fr_1fr] gap-3 sm:gap-4" aria-hidden="true">
      <div class="placeholder aspect-square border-solid border-brand-green/10 bg-white shadow-xl">Main image</div>
      <div class="grid gap-3 sm:gap-4">
        <div class="placeholder rotate-2 bg-brand-yellow-soft text-xs">Infographic</div>
        <div class="placeholder -rotate-2 text-xs">Lifestyle</div>
      </div>
    </div>
  </PageHero>

  <!-- 02 — Selected listing image work -->
  <section id="listing-image-work" class="container-x scroll-mt-24 py-12 md:py-24" aria-labelledby="work-heading">
    <SectionHeading
      eyebrow="Selected listing image work"
      id="work-heading"
      title="Your product shouldn’t look like every other option."
      text="When shoppers can’t judge the quality, scale, or benefits of a product from its images, price can become the easiest comparison. We design image galleries that make the details worth noticing easier to see."
    />
    <ul class="grid gap-6 sm:grid-cols-3">
      {work.map((w, i) => (
        <li>
          <figure>
            <div class:list={['placeholder aspect-square text-xs', i === 1 && 'bg-brand-yellow-soft']}>{w.kind}</div>
            <figcaption class="mt-3">
              <span class="block text-xs font-bold uppercase tracking-[0.18em] text-brand-green/60">{w.kind}</span>
              <span class="mt-1 block font-display text-lg font-extrabold leading-snug text-brand-green">
                “{w.question}”
              </span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>

    <!-- A genuine before/after from one client project (published case study) -->
    <figure class="mt-12 grid items-center gap-6 rounded-[1.75rem] bg-brand-cream p-5 sm:p-8 md:mt-16 md:grid-cols-[1fr_1.3fr] md:gap-10">
      <figcaption>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-orange">Before → After</p>
        <p class="mt-2 text-xl font-extrabold leading-snug text-brand-green sm:text-2xl">
          Super Ninja fruit fly trap gallery
        </p>
        <p class="mt-2 text-brand-ink/70">
          From a generic image stack to a gallery that shows how the trap works, why it’s safe and how it compares.
        </p>
        <a
          href="/case-studies/super-ninja"
          class="mt-4 inline-flex min-h-11 items-center text-sm font-semibold text-brand-green underline decoration-brand-yellow decoration-2 underline-offset-4 hover:decoration-brand-orange"
        >
          Read the Super Ninja case study →
        </a>
      </figcaption>
      <div class="grid grid-cols-2 items-center gap-4">
        <div>
          <Image
            src={oldListing}
            alt="Super Ninja Amazon listing images before the redesign"
            width={435}
            class="aspect-square w-full -rotate-2 rounded-[1.25rem] bg-white object-contain p-2 opacity-80"
          />
          <p class="mt-2 text-center text-xs font-semibold uppercase tracking-wider text-brand-ink/50">Before</p>
        </div>
        <div>
          <Image
            src={newListing}
            alt="Super Ninja Amazon listing images after the redesign"
            width={436}
            class="aspect-square w-full rotate-2 rounded-[1.25rem] bg-white object-contain p-2 shadow-lg ring-2 ring-brand-yellow"
          />
          <p class="mt-2 text-center text-xs font-semibold uppercase tracking-wider text-brand-orange">After</p>
        </div>
      </div>
    </figure>

    <a
      href={service.portfolio}
      class="mt-8 inline-flex min-h-11 items-center font-semibold text-brand-green underline decoration-brand-yellow decoration-2 underline-offset-4 hover:decoration-brand-orange"
    >
      View More Amazon Image Work →
    </a>
  </section>

  <!-- 03 — What we design -->
  <section class="bg-brand-cream py-12 md:py-24" aria-labelledby="design-heading">
    <div class="container-x">
      <SectionHeading eyebrow="What we design" id="design-heading" title="Every image has a job to do." align="left" />
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {types.map((t) => (
          <li class="rounded-[1.5rem] bg-white p-6 shadow-sm sm:rounded-[1.75rem] sm:p-7">
            <h3 class="text-lg font-extrabold leading-snug text-brand-green sm:text-xl">{t.t}</h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-brand-ink/70 sm:text-base">{t.d}</p>
          </li>
        ))}
      </ul>
      <p class="mt-8 max-w-3xl font-display text-xl font-extrabold leading-snug text-brand-green sm:text-2xl">
        We recommend the image mix for your product. <span class="marker">You don’t have to order every type.</span>
      </p>
    </div>
  </section>

  <!-- 04 — How we work -->
  <section class="container-x py-12 md:py-24" aria-labelledby="process-heading">
    <SectionHeading
      eyebrow="How we work"
      id="process-heading"
      title="The right images start with the right questions."
      align="left"
    />
    <ol class="grid gap-10 md:grid-cols-3 md:gap-0 md:divide-x md:divide-dashed md:divide-brand-green/20">
      {steps.map((s, i) => (
        <li class="md:px-8 md:first:pl-0 md:last:pr-0">
          <span class="step-num font-display text-5xl font-extrabold text-brand-yellow sm:text-6xl" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="mt-3 text-2xl font-extrabold leading-tight text-brand-green">{s.t}</h3>
          <p class="mt-2 text-brand-ink/70">{s.d}</p>
        </li>
      ))}
    </ol>
    <p class="mt-10 max-w-3xl rounded-[1.5rem] bg-brand-yellow-soft p-5 text-brand-ink/80 sm:p-6 md:mt-14">
      Already have usable product photos? We can work from supplied assets. Need a new photo shoot? We can discuss
      <a href="/services/amazon-product-photography" class="font-bold text-brand-green underline underline-offset-4">
        Amazon Product Photography
      </a>
      as a separate part of the quote. Real, hybrid, or AI-assisted creative approaches are selected according to the
      product and brief; the real product must be represented accurately.
    </p>
  </section>

  <!-- 05 — Frequently asked questions -->
  <section class="bg-brand-cream" aria-labelledby="faq-heading">
    <div class="container-x grid gap-8 py-12 md:grid-cols-[1fr_1.6fr] md:gap-12 md:py-24">
      <div>
        <p class="eyebrow mb-4">Frequently asked questions</p>
        <h2 id="faq-heading" class="text-[1.85rem] font-extrabold leading-tight text-brand-green sm:text-4xl">
          Questions About Amazon Listing Image Design
        </h2>
      </div>
      <FaqList faqs={faqs} variant="card" />
    </div>
  </section>

  <!-- Related pages: parent offer and guides -->
  <nav class="container-x pt-12 md:pt-16" aria-labelledby="related-heading">
    <h2 id="related-heading" class="mb-6 text-center text-xl font-bold text-brand-green">
      Part of our Amazon Listing Optimization services
    </h2>
    <ul class="flex flex-wrap justify-center gap-3">
      {related.map((r) => (
        <li>
          <a
            href={r.href}
            class:list={[
              'inline-block rounded-full px-4 py-2 text-sm font-medium transition',
              r.primary
                ? 'bg-brand-green text-white hover:bg-brand-yellow hover:text-brand-green'
                : 'border border-brand-green/20 text-brand-green hover:border-brand-yellow hover:bg-brand-yellow',
            ]}
          >
            {r.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- 06 — Final CTA -->
  <CtaBanner
    title="Your product has more to show. Let’s make it clear."
    text="Send us your Amazon listing and tell us what customers might be missing. We’ll help you discuss the images worth creating or improving — without requiring a complete listing overhaul."
    ctaLabel="Talk to a Human"
    ctaHref={BOOKING_PAGE}
    note="Choose a time to speak directly with our team."
  />
</Layout>
